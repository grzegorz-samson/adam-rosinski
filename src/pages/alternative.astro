---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeroSection from "../components/HeroSection.astro";
import ResearchSpectrum from "../components/ResearchSpectrum.astro";
import AuditoryField from "../components/AuditoryField.astro";
import PublicationsSection from "../components/PublicationsSection.astro";
import StudioPracticeSection from "../components/StudioPracticeSection.astro";
import ManifestSection from "../components/ManifestSection.astro";
import ContactSection from "../components/ContactSection.astro";

const areas = (await getCollection("research-areas")).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection("publications"))
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<BaseLayout>
  <SiteHeader />
  <main>
    <HeroSection />
    <ResearchSpectrum areas={areas} />
    <AuditoryField />
    <PublicationsSection publications={publications} />
    <StudioPracticeSection />
    <ManifestSection />
    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
