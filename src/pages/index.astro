---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeroSection from "../components/HeroSection.astro";
import ResearchSpectrum from "../components/ResearchSpectrum.astro";
import AuditoryField from "../components/AuditoryField.astro";
import PublicationsSection from "../components/PublicationsSection.astro";
import StudioPracticeSection from "../components/StudioPracticeSection.astro";
import ManifestSection from "../components/ManifestSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { getContent } from "../data/content";

const content = getContent("en");
const publications = content.publications.filter((item) => item.featured).slice(0, 4);
---

<BaseLayout
  title={`${content.site.displayName} | Research and audio practice`}
  description={content.site.description}
  lang="en"
  canonicalPath="/"
  alternatePath="/"
>
  <SiteHeader />
  <main>
    <HeroSection />
    <ResearchSpectrum />
    <AuditoryField />
    <PublicationsSection publications={publications} />
    <StudioPracticeSection />
    <ManifestSection />
    <ContactSection />
  </main>
  <SiteFooter />
</BaseLayout>
