---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";

---

<BaseLayout
  title="Polish version in preparation | Adam Rosinski"
  description="Polish translation layer placeholder."
  lang="pl"
  canonicalPath="/"
  alternatePath="/"
  bodyClass="site-body"
>
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="PL"
      title="Polish version is prepared as a future translation layer."
      intro="The English pages are currently canonical. This route is kept as a placeholder for the later `/pl` structure."
    />
  </main>
  <SiteFooter />
</BaseLayout>
