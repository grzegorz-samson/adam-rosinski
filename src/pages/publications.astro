---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { getContent } from "../data/content";

const content = getContent("en");
---

<BaseLayout title="Publications | Adam Rosinski" description={content.site.description} lang="en" canonicalPath="/publications" alternatePath="/publications" bodyClass="site-body">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Publications"
      title="Selected publication list"
      intro="The publication layer is now data-driven and can be extended later with DOI, citation, or filtering metadata."
    />

    <section class="site-section">
      <div class="site-shell">
        <div class="grid gap-5 md:grid-cols-2">
          {content.publications.map((publication) => <PublicationCard publication={publication} />)}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
