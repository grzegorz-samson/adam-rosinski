---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationCard from "../components/PublicationCard.astro";

const publications = (await getCollection("publications")).sort((a, b) => b.data.year - a.data.year);
---
<BaseLayout title="Publications — Adam Rosiński">
  <SiteHeader />
  <main class="shell section-space">
    <SectionHeading
      eyebrow="publications"
      title="Pełniejsza lista publikacji"
      intro="Na tym etapie to nadal starter. Możesz rozwinąć tę stronę o DOI, filtrowanie, cytowania, abstrakty i grupowanie po typie publikacji."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {publications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
