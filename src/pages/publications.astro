---
import BookOpen from "@lucide/astro/icons/book-open";
import Building2 from "@lucide/astro/icons/building-2";
import AltLabLayout from "../layouts/AltLabLayout.astro";
import AlternativePublications from "../components/AlternativePublications.astro";
import PublicationsCatalog from "../components/PublicationsCatalog.astro";
import AlternativeProfiles from "../components/AlternativeProfiles.astro";
import EditorialRolesSection from "../components/EditorialRolesSection.astro";
import PublicationsHeroGraphic from "../components/PublicationsHeroGraphic.astro";
import { publications, publicationsByCategory, selectedPublications } from "../data/publications";

const publicationCount = publications.length;

const editorialCount = publicationsByCategory.editorialWork.length;
---

<AltLabLayout
  title="Publications | Adam Rosiński"
  description="Books, articles, editorial work, and chapters on auditory perception, recording, and spatial audio."
  activePath="/publications"
>
  <section class="publications-hub-nav" aria-labelledby="publications-hub-nav-title" data-publications-hub>
    <div class="publications-hub-hero">
      <div class="publications-hub-copy">
        <p class="alt-kicker">Publications hub</p>
        <h1 id="publications-hub-nav-title" class="page-hero-title">Publications and editorial</h1>
        <p>
          One page now brings together bibliographic output, editorial publications, and scholarly associations.
        </p>
      </div>

      <div class="publications-hub-graphic" aria-hidden="true">
        <PublicationsHeroGraphic />
      </div>
    </div>

    <nav class="publications-hub-toggle" aria-label="Toggle between publications and editorial sections">
      <a href="#publications-main" class="publications-hub-link" data-publications-link="publications">
        <span class="publications-hub-link-label">
          <BookOpen size={16} stroke-width={1.8} aria-hidden="true" />
          <span>Publications</span>
        </span>
        <span class="publications-hub-count">{publicationCount}</span>
      </a>
      <a href="#editorial" class="publications-hub-link" data-publications-link="editorial">
        <span class="publications-hub-link-label">
          <Building2 size={16} stroke-width={1.8} aria-hidden="true" />
          <span>Editorial</span>
        </span>
        <span class="publications-hub-count">{editorialCount}</span>
      </a>
    </nav>
  </section>

  <section id="publications-main" class="publications-main-section" aria-label="Publications">
    <AlternativePublications
      publications={selectedPublications}
      kicker="Books"
      title="Books"
      description="The four monographs remain the clearest visual entry point into Adam Rosiński’s publication work, so they stay at the top as the opening shelf."
    />
    <PublicationsCatalog
      monographs={publicationsByCategory.monographs}
      journalArticles={publicationsByCategory.journalArticles}
      editorialWork={[]}
      bookChapters={publicationsByCategory.bookChapters}
      editorialPublicationCount={publicationsByCategory.editorialWork.length}
    />
  </section>

  <EditorialRolesSection sectionId="editorial" />
  <AlternativeProfiles compactTopSpacing={true} />
</AltLabLayout>

<script>
  function setupPublicationsHubToggle() {
    const hub = document.querySelector("[data-publications-hub]");
    if (!(hub instanceof HTMLElement)) return;

    const links = Array.from(hub.querySelectorAll("[data-publications-link]"));
    const publicationsSection = document.getElementById("publications-main");
    const editorialSection = document.getElementById("editorial");

    if (!(publicationsSection instanceof HTMLElement) || !(editorialSection instanceof HTMLElement)) return;

    const setActive = (view) => {
      hub.dataset.activeView = view;
      links.forEach((link) => {
        const isActive = link.getAttribute("data-publications-link") === view;
        link.setAttribute("aria-current", isActive ? "page" : "false");
      });
    };

    const syncFromHash = () => {
      const hash = window.location.hash;
      if (
        hash === "#editorial" ||
        hash.startsWith("#editorial-")
      ) {
        setActive("editorial");
        return;
      }

      setActive("publications");
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visible) return;

        if (visible.target.id === "editorial") {
          setActive("editorial");
          return;
        }

        if (visible.target.id === "publications-main") {
          setActive("publications");
        }
      },
      {
        rootMargin: "-18% 0px -58% 0px",
        threshold: [0.15, 0.4, 0.65],
      },
    );

    observer.observe(publicationsSection);
    observer.observe(editorialSection);

    window.addEventListener("hashchange", syncFromHash);
    syncFromHash();
  }

  setupPublicationsHubToggle();
</script>

<style>
  .publications-hub-nav,
  .publications-main-section {
    scroll-margin-top: 8.5rem;
  }

  .publications-hub-nav {
    display: grid;
    overflow: hidden;
    gap: 1.35rem;
    margin: var(--page-top-spacing-default) 0 1rem;
    padding: 1.2rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 28px;
    background:
      radial-gradient(circle at 14% 0%, rgba(86, 216, 255, 0.14), transparent 30%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.028));
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16px);
  }

  .publications-hub-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 30rem);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .publications-hub-copy {
    max-width: 62rem;
  }

  .publications-hub-graphic {
    position: relative;
    min-width: 0;
    width: 100%;
    max-width: 30rem;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    isolation: isolate;
    opacity: 0.94;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 100%);
  }

  .publications-hub-graphic::after {
    content: "";
    position: absolute;
    inset: 12% 4% 10% 16%;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(103, 232, 249, 0.12), transparent 68%);
    filter: blur(22px);
  }

  .publications-hub-copy h1 {
    margin-top: 0.45rem;
  }

  .publications-hub-copy p:last-child {
    margin-top: 0.9rem;
    color: #b7bdca;
    line-height: 1.8;
    max-width: 68rem;
  }

  .publications-hub-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .publications-hub-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: min(100%, 16rem);
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: #d8dee8;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .publications-hub-link-label {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .publications-hub-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.76rem;
    line-height: 1;
  }

  .publications-hub-link:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .publications-hub-nav[data-active-view="publications"] .publications-hub-link[data-publications-link="publications"] {
    border-color: rgba(86, 216, 255, 0.35);
    background: rgba(86, 216, 255, 0.09);
    color: #fff;
    box-shadow: 0 0 24px rgba(86, 216, 255, 0.12);
  }

  .publications-hub-nav[data-active-view="editorial"] .publications-hub-link[data-publications-link="editorial"] {
    border-color: rgba(167, 139, 250, 0.35);
    background: rgba(167, 139, 250, 0.09);
    color: #fff;
    box-shadow: 0 0 24px rgba(167, 139, 250, 0.12);
  }

  .publications-main-section {
    margin-bottom: 1rem;
  }

  .publications-main-section :global(#selected-publications.alt-section) {
    padding-top: 1.8rem;
  }

  @media (max-width: 920px) {
    .publications-hub-hero {
      grid-template-columns: 1fr;
    }

    .publications-hub-copy {
      max-width: 48rem;
    }

    .publications-hub-graphic {
      width: min(100%, 39rem);
      max-width: 32rem;
      margin: 0 auto;
      justify-self: center;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    }
  }

  @media (max-width: 680px) {
    .publications-hub-nav {
      padding: 1rem;
      border-radius: 24px;
    }

    .publications-hub-graphic {
      width: 100%;
      margin: 0 auto;
    }

    .publications-main-section :global(#selected-publications.alt-section) {
      padding-top: 1.6rem;
    }
  }
</style>
