---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
---
<BaseLayout title="Projects — Adam Rosiński">
  <SiteHeader />
  <main class="shell section-space">
    <SectionHeading
      eyebrow="projects / studio"
      title="Miejsce na projekty, studio i dokumentację praktyki."
      intro="Ta podstrona jest szkicem. Możesz tu dodać opisy projektów studyjnych, prototypów technologicznych, materiałów audio i galerii."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {["Studio recording", "Spatial audio", "Technology & education"].map((title) => (
        <article class="soft-card p-6">
          <h3 class="text-xl font-semibold text-white">{title}</h3>
          <p class="muted mt-4 text-sm leading-7">
            Placeholder na case study, opis procesu, media, dokumentację i kontekst badawczy.
          </p>
        </article>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
