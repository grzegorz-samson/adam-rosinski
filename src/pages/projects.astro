---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import { getContent } from "../data/content";

const content = getContent("en");
---

<BaseLayout title="Projects | Adam Rosinski" description={content.site.description} lang="en" canonicalPath="/projects" alternatePath="/projects" bodyClass="site-body">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Projects"
      title="Projects and structured directions for future expansion."
      intro="This page remains intentionally compact, but it already maps the kinds of case studies and demonstrators that belong in the multipage structure."
    />

    <section class="site-section">
      <div class="site-shell">
        <div class="grid gap-5 md:grid-cols-3">
          {content.projectCards.map((project) => (
            <article class="soft-card p-6">
              <p class="site-eyebrow">{project.status}</p>
              <h2 class="site-title-md" style="margin-top: 0.75rem;">{project.title}</h2>
              <p class="site-copy" style="margin-top: 1rem;">{project.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
