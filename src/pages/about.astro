---
import { withBase } from "../utils/withBase";

const target = withBase("/bio");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to Bio | Adam Rosiński</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <main class="redirect-shell">
      <p>Redirecting to the bio page…</p>
      <a href={target}>Continue to bio</a>
    </main>

    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
  }

  .redirect-shell {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    padding: 2rem;
    background: #05070b;
    color: #d4d4d8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    text-align: center;
  }

  .redirect-shell a {
    color: #56d8ff;
    text-decoration: none;
  }
</style>
