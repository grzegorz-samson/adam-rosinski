---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../data/site";
---
<BaseLayout title="About — Adam Rosiński">
  <SiteHeader />
  <main class="shell section-space">
    <SectionHeading
      eyebrow="about"
      title="Rozbudowana sekcja bio / statement"
      intro="Ta podstrona może później pomieścić klasyczny biogram, listę afiliacji, nagród, działalności dydaktycznej i projektów."
    />

    <div class="glass-panel mt-12 p-6 md:p-10">
      <div class="prose-copy max-w-4xl">
        <p>{site.shortBio}</p>
        <p class="mt-4">
          W wersji finalnej warto rozdzielić ten obszar na: bio, zainteresowania badawcze, dydaktykę, praktykę realizatorską i współpracę projektową.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
