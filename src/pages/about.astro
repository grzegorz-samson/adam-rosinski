---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { getContent } from "../data/content";

const content = getContent("en");
---

<BaseLayout title="About | Adam Rosinski" description={content.site.description} lang="en" canonicalPath="/about" alternatePath="/about" bodyClass="site-body">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="About"
      title="Research profile rooted in listening, recording, and musical structure."
      intro="This page expands the short landing-page summary and frames the website as a research-led studio profile."
    />

    <section class="site-section">
      <div class="site-shell">
        <div class="site-grid-2">
          <article class="glass-panel p-6 md:p-8">
            <SectionIntro title="Profile summary" intro={content.site.role} />
            <p class="site-copy">{content.site.tagline}</p>
          </article>

          <article class="glass-panel p-6 md:p-8">
            <SectionIntro title="Institution" intro={content.site.institution} />
            <p class="site-copy">Location: {content.site.location}</p>
            <div class="site-tag-row">
              <span class="site-tag">research</span>
              <span class="site-tag">studio practice</span>
              <span class="site-tag">education</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="site-shell">
        <div class="glass-panel p-6 md:p-10">
          <SectionIntro
            eyebrow="Approach"
            title="Research and practice are presented together."
            intro="The website is organized as a compact research environment: short entry points on the landing page, detailed subpages for each strand, and an audio demonstrator that keeps listening at the center."
          />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
