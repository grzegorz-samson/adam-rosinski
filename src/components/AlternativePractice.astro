---
import Mic from "@lucide/astro/icons/mic";
import Orbit from "@lucide/astro/icons/orbit";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import Wrench from "@lucide/astro/icons/wrench";

const cards = [
  {
    title: "Studio recording",
    icon: Mic,
    role:
      "Designing listening perspective, plan, and source relations in recording, from microphone decisions to the final spatial image.",
    category: "Studio",
    year: "Practice",
  },
  {
    title: "Multichannel thinking",
    icon: Orbit,
    role:
      "Working with stereo, surround, and multichannel systems as a distinct language for organizing space, direction, and auditory perception.",
    category: "Space",
    year: "Research",
  },
  {
    title: "Technology in teaching",
    icon: GraduationCap,
    role:
      "Using audio environments and digital tools as a full medium for teaching listening, analysis, and production practice.",
    category: "Education",
    year: "Academia",
  },
  {
    title: "Prototypes and experiment",
    icon: Wrench,
    role:
      "Developing solutions connected to microphones, spatial recording, and translating research results into practical audio workflows.",
    category: "R&D",
    year: "Development",
  },
];
---

<section id="practice-alt" class="alt-section">
  <div class="alt-heading">
    <p class="alt-kicker">Studio practice</p>
    <h2>Studio practice</h2>
    <p>
      This block shows how research on listening translates into decisions about recording,
      acoustic space, and day-to-day work in audio environments.
    </p>
  </div>

  <div class="alt-grid">
    {cards.map((card) => {
      const Icon = card.icon;

      return (
        <article class="alt-card">
          <div class="alt-card-head">
            <div>
              <p class="alt-kicker">{card.category}</p>
              <h3>{card.title}</h3>
            </div>
            <div class="alt-card-side">
              <span class="alt-card-year">{card.year}</span>
              <span class="alt-icon-badge">
                <Icon size={17} stroke-width={1.75} aria-hidden="true" />
              </span>
            </div>
          </div>
          <p>{card.role}</p>
          <div class="alt-bar"><span></span></div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .alt-kicker,
  .alt-card-head span {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-kicker {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #56d8ff;
  }

  .alt-heading h2 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-heading p:last-child,
  .alt-card p {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .alt-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .alt-card-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .alt-card-head h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-card-year {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #71717a;
  }

  .alt-card-side {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }

  .alt-bar {
    margin-top: 1.4rem;
    height: 0.35rem;
    width: 100%;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
  }

  .alt-bar span {
    display: block;
    width: 66%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #56d8ff, #8a7dff, #ffb347);
    transition: width 220ms ease;
  }

  .alt-card:hover .alt-bar span {
    width: 100%;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
