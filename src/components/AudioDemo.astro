---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const rootId = `audio-demo-${Math.random().toString(36).slice(2, 10)}`;
---

<section class:list={["site-audio-demo", compact && "is-compact"]} id={rootId}>
  <div class="site-audio-head">
    <div>
      <p class="site-eyebrow">Audio demonstrator</p>
      <h2 class="site-title-lg">Generator audio</h2>
      <p class="site-copy">Waveform on the left, spectrum on the right, both driven by the same synthetic signal.</p>
    </div>
    <button type="button" class="site-button-secondary site-audio-toggle">Enable sound</button>
  </div>

  <div class="site-audio-grid">
    <div class="site-card site-audio-panel">
      <p class="site-audio-label">Waveform</p>
      <canvas class="site-audio-canvas waveform" width="560" height="220"></canvas>
    </div>
    <div class="site-card site-audio-panel">
      <p class="site-audio-label">Spectrum</p>
      <canvas class="site-audio-canvas spectrum" width="560" height="220"></canvas>
    </div>
  </div>
</section>

<script is:inline define:vars={{ rootId }}>
  const root = document.getElementById(rootId);
  if (root) {
    const waveformCanvas = root.querySelector(".waveform");
    const spectrumCanvas = root.querySelector(".spectrum");
    const toggle = root.querySelector(".site-audio-toggle");

    if (waveformCanvas instanceof HTMLCanvasElement && spectrumCanvas instanceof HTMLCanvasElement && toggle instanceof HTMLButtonElement) {
      const waveformContext = waveformCanvas.getContext("2d");
      const spectrumContext = spectrumCanvas.getContext("2d");

      if (waveformContext && spectrumContext) {
        let audioContext;
        let oscillator;
        let gainNode;
        let soundEnabled = false;
        let phase = 0;
        let time = 0;

        const resizeCanvas = (canvas) => {
          const ratio = Math.max(1, window.devicePixelRatio || 1);
          const bounds = canvas.getBoundingClientRect();
          canvas.width = Math.max(1, Math.floor(bounds.width * ratio));
          canvas.height = Math.max(1, Math.floor(bounds.height * ratio));
          const context = canvas.getContext("2d");
          if (context) {
            context.setTransform(ratio, 0, 0, ratio, 0, 0);
          }
        };

        const setupAudio = async () => {
          if (!audioContext) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            audioContext = new AudioContextClass();
            oscillator = audioContext.createOscillator();
            gainNode = audioContext.createGain();
            oscillator.type = "sine";
            gainNode.gain.value = 0;
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            oscillator.start();
          }

          await audioContext.resume();
        };

        const renderWaveform = (frequency) => {
          const width = waveformCanvas.getBoundingClientRect().width || 560;
          const height = waveformCanvas.getBoundingClientRect().height || 220;
          waveformContext.clearRect(0, 0, width, height);
          waveformContext.strokeStyle = "rgba(103, 232, 249, 0.95)";
          waveformContext.lineWidth = 2;
          waveformContext.beginPath();

          for (let index = 0; index <= width; index += 1) {
            const x = index / width;
            const y = Math.sin(x * Math.PI * 6 + phase) * (height * 0.22);
            const plotY = height / 2 + y;
            if (index === 0) {
              waveformContext.moveTo(index, plotY);
            } else {
              waveformContext.lineTo(index, plotY);
            }
          }

          waveformContext.stroke();
          waveformContext.strokeStyle = "rgba(255,255,255,0.08)";
          waveformContext.beginPath();
          waveformContext.moveTo(0, height / 2);
          waveformContext.lineTo(width, height / 2);
          waveformContext.stroke();
        };

        const renderSpectrum = (frequency) => {
          const width = spectrumCanvas.getBoundingClientRect().width || 560;
          const height = spectrumCanvas.getBoundingClientRect().height || 220;
          const barCount = 28;
          const barWidth = width / barCount;
          spectrumContext.clearRect(0, 0, width, height);

          for (let index = 0; index < barCount; index += 1) {
            const distance = Math.abs(index - barCount * 0.38);
            const envelope = Math.max(0.15, 1 - distance / (barCount * 0.55));
            const modulation = 0.72 + 0.28 * Math.sin(time * 2.8 + index * 0.45);
            const intensity = envelope * modulation;
            const barHeight = intensity * (height * 0.86);
            const x = index * barWidth + 4;
            const y = height - barHeight;

            spectrumContext.fillStyle = index % 3 === 0
              ? "rgba(251, 191, 36, 0.72)"
              : index % 2 === 0
                ? "rgba(129, 140, 248, 0.72)"
                : "rgba(103, 232, 249, 0.78)";
            spectrumContext.fillRect(x, y, Math.max(8, barWidth - 8), barHeight);
          }
        };

        const frame = () => {
          time += 0.016;
          const frequency = 180 + 70 * Math.sin(time * 0.75) + 25 * Math.sin(time * 2.1);
          phase += frequency / 780;

          if (oscillator) {
            oscillator.frequency.setTargetAtTime(frequency, audioContext.currentTime, 0.08);
          }

          renderWaveform(frequency);
          renderSpectrum(frequency);
          requestAnimationFrame(frame);
        };

        resizeCanvas(waveformCanvas);
        resizeCanvas(spectrumCanvas);
        window.addEventListener("resize", () => {
          resizeCanvas(waveformCanvas);
          resizeCanvas(spectrumCanvas);
        });

        toggle.addEventListener("click", async () => {
          await setupAudio();
          soundEnabled = !soundEnabled;
          gainNode.gain.setTargetAtTime(soundEnabled ? 0.08 : 0, audioContext.currentTime, 0.05);
          toggle.textContent = soundEnabled ? "Disable sound" : "Enable sound";
        });

        frame();
      }
    }
  }
</script>
