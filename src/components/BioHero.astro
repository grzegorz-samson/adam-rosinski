---
import ExternalLink from "@lucide/astro/icons/external-link";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Brain from "@lucide/astro/icons/brain";
import AudioWaveform from "@lucide/astro/icons/audio-waveform";
import BookOpen from "@lucide/astro/icons/book-open";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import { site } from "../data/site";
import { biographyHighlights, biographyLenses } from "../data/biography";
import { withBase } from "../utils/withBase";

const heroKeywords = [
  "listening research",
  "psychoacoustics",
  "spatial recording",
  "studio technology",
  "open-access publishing",
];

const lensIcons = {
  Brain,
  AudioWaveform,
  BookOpen,
  GraduationCap,
};
---

<section class="bio-hero" aria-labelledby="bio-hero-title">
  <div class="bio-hero-grid">
    <div class="bio-hero-copy">
      <p class="bio-eyebrow">Bio · research profile</p>
      <h1 id="bio-hero-title">Listen. Record. Publish. Teach.</h1>
      <p class="bio-lead">
        Dr <strong>Adam Rosiński</strong> works at the intersection of musical acoustics, psychoacoustics,
        sound technology, and studio practice. His biography connects doctoral research on auditory
        perception with recording technologies, editorial initiatives, institutional work, and professional
        sound direction.
      </p>

      <div class="bio-keyword-strip" aria-label="Key profile terms">
        {heroKeywords.map((keyword) => <span>{keyword}</span>)}
      </div>

      <div class="bio-hero-actions">
        <a href="#biographical-map" class="bio-primary-link">
          <span>Read extended profile</span>
          <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" />
        </a>
        <a href={withBase(site.links.cvPdf)} target="_blank" rel="noreferrer" class="bio-secondary-link">
          <span>Download CV</span>
          <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>

    <figure class="bio-portrait-card" aria-label="Portrait of Adam Rosiński">
      <picture class="bio-portrait-photo">
        <source
          srcset={`${withBase("/images/bio/adam-rosinski-bio-portrait-720.webp")} 720w, ${withBase("/images/bio/adam-rosinski-bio-portrait-960.webp")} 960w`}
          sizes="(max-width: 760px) calc(100vw - 1.5rem), (max-width: 1120px) 50vw, 41vw"
          type="image/webp"
        />
        <img
          src={withBase("/images/bio/adam-rosinski-bio-portrait-720.webp")}
          alt="Adam Rosiński"
          width="720"
          height="960"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <img class="bio-portrait-orbit" src={withBase("/images/bio-motifs/bio-portrait-field.svg")} alt="" loading="lazy" aria-hidden="true" />
      <picture class="bio-portrait-silhouette" aria-hidden="true">
        <source
          srcset={`${withBase("/images/bio/adam-rosinski-bio-silhouette-720.webp")} 720w, ${withBase("/images/bio/adam-rosinski-bio-silhouette-960.webp")} 960w`}
          sizes="(max-width: 760px) calc(100vw - 1.5rem), (max-width: 1120px) 50vw, 41vw"
          type="image/webp"
        />
        <img src={withBase("/images/bio/adam-rosinski-bio-silhouette-720.webp")} alt="" width="720" height="960" loading="eager" />
      </picture>
    </figure>
  </div>

  <div class="bio-highlight-grid" aria-label="Profile highlights">
    {biographyHighlights.map((highlight) => (
      <article class="bio-highlight-card">
        <span>{highlight.label}</span>
        <strong>{highlight.value}</strong>
        <p>{highlight.detail}</p>
      </article>
    ))}
  </div>

  <div class="bio-lens-grid" aria-label="Biography reading lenses">
    {biographyLenses.map((lens) => {
      const Icon = lensIcons[lens.icon as keyof typeof lensIcons] ?? Brain;
      return (
        <article class:list={["bio-lens-card", `bio-lens-${lens.accent}`]}>
          <div class="bio-lens-icon">
            <Icon size={18} stroke-width={1.8} aria-hidden="true" />
          </div>
          <h2>{lens.title}</h2>
          <p>{lens.text}</p>
        </article>
      );
    })}
  </div>
</section>

<style>
  .bio-hero {
    position: relative;
    padding: 5.5rem 0 3rem;
  }

  .bio-hero::before {
    content: "";
    position: absolute;
    inset: 2rem -5vw auto auto;
    width: min(42rem, 70vw);
    height: min(42rem, 70vw);
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(86, 216, 255, 0.14), transparent 58%),
      radial-gradient(circle at 42% 38%, rgba(138, 125, 255, 0.14), transparent 32%);
    filter: blur(18px);
    pointer-events: none;
    opacity: 0.74;
  }

  .bio-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
    gap: 2rem;
    align-items: stretch;
  }

  .bio-hero-copy,
  .bio-portrait-card,
  .bio-highlight-card,
  .bio-lens-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(18px);
  }

  .bio-hero-copy {
    border-radius: 34px;
    padding: clamp(1.45rem, 3.2vw, 3rem);
    overflow: hidden;
  }

  .bio-eyebrow {
    margin: 0 0 1.1rem;
    color: #67e8f9;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .bio-hero h1 {
    max-width: 68rem;
    color: #fff;
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    line-height: 0.97;
    letter-spacing: -0.05em;
    text-wrap: pretty;
  }

  .bio-lead {
    margin-top: 1.35rem;
    max-width: 62rem;
    color: #c9d2df;
    font-size: clamp(1rem, 1.7vw, 1.16rem);
    line-height: 1.9;
  }

  .bio-lead strong {
    color: #fff;
  }

  .bio-keyword-strip,
  .bio-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .bio-keyword-strip {
    margin-top: 1.6rem;
  }

  .bio-keyword-strip span {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: #e5e7eb;
    padding: 0.55rem 0.85rem;
    font-size: 0.86rem;
    line-height: 1;
  }

  .bio-hero-actions {
    margin-top: 1.9rem;
  }

  .bio-primary-link,
  .bio-secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    padding: 0.82rem 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, color 180ms ease;
  }

  .bio-primary-link {
    border: 1px solid rgba(103, 232, 249, 0.35);
    background: rgba(103, 232, 249, 0.11);
    color: #effcff;
  }

  .bio-secondary-link {
    border: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(255, 255, 255, 0.04);
    color: #d4d4d8;
  }

  .bio-primary-link:hover,
  .bio-secondary-link:hover {
    transform: translateY(-2px);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.08);
  }

  .bio-portrait-card {
    position: relative;
    margin: 0;
    min-height: 34rem;
    overflow: hidden;
    border-radius: 34px;
    background:
      radial-gradient(circle at 35% 26%, rgba(103, 232, 249, 0.15), transparent 28%),
      radial-gradient(circle at 80% 18%, rgba(251, 191, 36, 0.11), transparent 26%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
  }

  .bio-portrait-photo {
    position: absolute;
    inset: 0;
  }

  .bio-portrait-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
    filter: saturate(0.96) contrast(1.05);
  }

  .bio-portrait-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(5, 7, 11, 0.08), rgba(5, 7, 11, 0.58)),
      radial-gradient(circle at 82% 18%, rgba(103, 232, 249, 0.18), transparent 32%);
    pointer-events: none;
  }

  .bio-portrait-orbit {
    position: absolute;
    right: -8%;
    top: -4%;
    z-index: 2;
    width: 62%;
    height: auto;
    object-fit: contain;
    opacity: 0.54;
    mix-blend-mode: screen;
  }

  .bio-portrait-silhouette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .bio-portrait-silhouette img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
    filter: saturate(1.02) contrast(1.04);
  }

  .bio-highlight-grid,
  .bio-lens-grid {
    display: grid;
    gap: 1rem;
  }

  .bio-highlight-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .bio-highlight-card {
    border-radius: 24px;
    padding: 1.1rem;
  }

  .bio-highlight-card span {
    display: block;
    color: #8cdfff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bio-highlight-card strong {
    display: block;
    margin-top: 0.45rem;
    color: #fff;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .bio-highlight-card p {
    margin-top: 0.5rem;
    color: #aeb7c5;
    font-size: 0.89rem;
    line-height: 1.55;
  }

  .bio-lens-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .bio-lens-card {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 1.25rem;
  }

  .bio-lens-card::after {
    content: "";
    position: absolute;
    inset: auto -18% -28% auto;
    width: 10rem;
    height: 10rem;
    border-radius: 999px;
    background: rgba(103, 232, 249, 0.12);
    filter: blur(8px);
  }

  .bio-lens-violet::after { background: rgba(167, 139, 250, 0.14); }
  .bio-lens-emerald::after { background: rgba(110, 231, 183, 0.12); }
  .bio-lens-amber::after { background: rgba(251, 191, 36, 0.12); }

  .bio-lens-icon {
    display: inline-flex;
    width: 2.45rem;
    height: 2.45rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 999px;
    background: rgba(103, 232, 249, 0.08);
    color: #67e8f9;
  }

  .bio-lens-violet .bio-lens-icon { border-color: rgba(167, 139, 250, 0.28); background: rgba(167, 139, 250, 0.08); color: #c4b5fd; }
  .bio-lens-emerald .bio-lens-icon { border-color: rgba(110, 231, 183, 0.28); background: rgba(110, 231, 183, 0.08); color: #6ee7b7; }
  .bio-lens-amber .bio-lens-icon { border-color: rgba(251, 191, 36, 0.28); background: rgba(251, 191, 36, 0.08); color: #fbbf24; }

  .bio-lens-card h2 {
    position: relative;
    margin-top: 1rem;
    color: #fff;
    font-size: 1.2rem;
    line-height: 1.22;
  }

  .bio-lens-card p {
    position: relative;
    margin-top: 0.65rem;
    color: #aeb7c5;
    line-height: 1.7;
    font-size: 0.94rem;
  }

  @media (max-width: 1120px) {
    .bio-hero-grid,
    .bio-highlight-grid,
    .bio-lens-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .bio-hero {
      padding-top: 3.25rem;
    }

    .bio-hero-grid,
    .bio-highlight-grid,
    .bio-lens-grid {
      grid-template-columns: 1fr;
    }

    .bio-portrait-card {
      min-height: 28rem;
    }

  }
</style>
