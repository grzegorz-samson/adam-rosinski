---
import { site } from "../data/site";
---
<section id="contact" class="shell section-space">
  <div class="glass-panel grid gap-8 p-6 md:grid-cols-[0.7fr_0.3fr] md:p-10">
    <div>
      <p class="eyebrow">contact / collaboration</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Współpraca badawcza, artystyczna i edukacyjna.
      </h2>
      <p class="muted mt-5 max-w-2xl text-base leading-8">
        Ten blok jest celowo prostszy i spokojniejszy. Ma domknąć narrację strony i zaprosić do kontaktu bez przeładowania formalnościami.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.links.uwm} target="_blank" rel="noreferrer" class="button-primary">Profil UWM</a>
        <a href={site.links.scholar} target="_blank" rel="noreferrer" class="button-secondary">Google Scholar</a>
        <a href={site.links.sciprofiles} target="_blank" rel="noreferrer" class="button-secondary">SciProfiles</a>
      </div>
    </div>

    <aside class="soft-card p-5">
      <h3 class="text-lg font-semibold text-white">Contact data</h3>
      <dl class="mt-5 space-y-4">
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-zinc-500">Institution</dt>
          <dd class="mt-2 text-sm leading-7 text-zinc-200">{site.institution}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-zinc-500">Location</dt>
          <dd class="mt-2 text-sm leading-7 text-zinc-200">{site.location}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
