---
import { getContent } from "../data/content";
import { localizedPath } from "../utils/i18n";

const content = getContent("en");
---
<section id="contact" class="shell section-space">
  <div class="glass-panel grid gap-8 p-6 md:grid-cols-[0.7fr_0.3fr] md:p-10">
    <div>
      <p class="eyebrow">contact / collaboration</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Research collaboration, artistic consultation, and teaching-related work.
      </h2>
      <p class="muted mt-5 max-w-2xl text-base leading-8">
        The contact block closes the landing page without turning it into a directory page. It keeps only institutional context and the main external profiles.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={content.profiles[0].href} target="_blank" rel="noreferrer" class="button-primary">University profile</a>
        <a href={content.profiles[1].href} target="_blank" rel="noreferrer" class="button-secondary">Google Scholar</a>
        <a href={content.profiles[2].href} target="_blank" rel="noreferrer" class="button-secondary">SciProfiles</a>
        <a href={localizedPath("/contact")} class="button-secondary">Full contact page</a>
      </div>
    </div>

    <aside class="soft-card p-5">
      <h3 class="text-lg font-semibold text-white">Contact context</h3>
      <dl class="mt-5 space-y-4">
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-zinc-500">Institution</dt>
          <dd class="mt-2 text-sm leading-7 text-zinc-200">{content.site.institution}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-zinc-500">Location</dt>
          <dd class="mt-2 text-sm leading-7 text-zinc-200">{content.site.location}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
