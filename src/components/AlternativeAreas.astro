---
import { withBase } from "../utils/withBase";

const areas = [
  {
    title: "Analiza sceny słuchowej",
    excerpt:
      "Badania nad tym, jak słuch organizuje zdarzenia dźwiękowe w strumienie, obiekty i relacje percepcyjne oraz jak te mechanizmy działają w muzyce.",
    href: withBase("/bio"),
    tag: "Psychoakustyka",
  },
  {
    title: "Dźwięk przestrzenny i techniki rejestracji",
    excerpt:
      "Obszar łączący techniki mikrofonowe stereo i surround, wielokanałowość, przestrzeń akustyczną oraz praktykę projektowania punktu słyszenia.",
    href: withBase("/publications"),
    tag: "Technologie audio",
  },
  {
    title: "Praktyka studyjna i dydaktyka",
    excerpt:
      "Praca na styku produkcji dźwięku, edukacji muzycznej i współczesnych narzędzi cyfrowych wspierających słyszenie, analizę i realizację.",
    href: withBase("/projects"),
    tag: "Praktyka i edukacja",
  },
];
---

<section id="obszary-alt" class="alt-section">
  <div class="alt-heading">
    <p class="alt-kicker">Zakres działalności</p>
    <h2>Badania, rejestracja, przestrzeń i dydaktyka.</h2>
    <p>
      Praca Adama Rosińskiego rozwija się na styku psychoakustyki, technologii audio, praktyki studyjnej i edukacji muzycznej.
      Każdy z tych obszarów wzmacnia pozostałe i prowadzi do wspólnego języka myślenia o dźwięku.
    </p>
  </div>

  <div class="alt-grid">
    {areas.map((area) => (
      <a href={area.href} class="alt-area-card">
        <p class="alt-kicker">{area.tag}</p>
        <h3>{area.title}</h3>
        <p>{area.excerpt}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .alt-kicker {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #56d8ff;
  }

  .alt-heading h2 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-heading p:last-child {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .alt-area-card {
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
    backdrop-filter: blur(12px);
  }

  .alt-area-card:hover {
    border-color: rgba(86, 216, 255, 0.4);
    box-shadow: 0 0 0 1px rgba(86, 216, 255, 0.1), 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .alt-area-card h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-area-card p:last-child {
    margin-top: 0.85rem;
    color: #a1a1aa;
    line-height: 1.8;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
