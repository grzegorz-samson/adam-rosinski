---
import SectionHeading from "./SectionHeading.astro";
import PillTag from "./PillTag.astro";
import { getContent } from "../data/content";
import { localizedPath } from "../utils/i18n";

const content = getContent("en");
const areas = content.researchAreas;
---

<section id="research" class="shell section-space">
  <SectionHeading
    eyebrow="research spectrum"
    title="A research field structured between perception, space, and recording practice."
    intro="Instead of a generic list of interests, the landing page presents a compact spectrum of themes that connect listening research with audio technology and studio practice."
  />

  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {areas.map((area, index) => (
      <article class={`soft-card flex h-full flex-col p-5 ${index % 2 === 0 ? "xl:translate-y-6" : ""}`}>
        <div class="mb-6 flex items-center justify-between">
          <span class="text-sm text-zinc-500">0{index + 1}</span>
          <span class="mode-dot bg-cyan-300/80"></span>
        </div>

        <h3 class="text-xl font-semibold text-white">{area.title}</h3>
        <p class="muted mt-4 text-sm leading-7">{area.summary}</p>

        <div class="mt-6 flex flex-wrap gap-2">
          {area.tags.map((tag, tagIndex) => (
            <PillTag label={tag} tone={tagIndex === 0 ? "cyan" : "neutral"} />
          ))}
        </div>

        <a href={localizedPath(`/research/${area.slug}`)} class="site-inline-link mt-auto">
          {area.cta}
        </a>
      </article>
    ))}
  </div>
</section>
