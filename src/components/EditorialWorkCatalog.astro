---
import BookOpen from "@lucide/astro/icons/book-open";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import Files from "@lucide/astro/icons/files";
import Tags from "@lucide/astro/icons/tags";
import PublicationVisual from "./PublicationVisual.astro";
import { getDisplayTitle, getSecondaryTitle } from "../data/publicationPresentation";
import { getPublicationStrip } from "../data/publicationStrips";
import { getPublicationMetaLabel } from "../data/publicationTaxonomy";
import type { PublicationRecord } from "../data/publications";
import { withBase } from "../utils/withBase";

interface Props {
  items: PublicationRecord[];
  kicker?: string;
  title?: string;
  description?: string;
  id?: string;
}

const {
  items,
  kicker = "Editorial work",
  title = "Special issues and edited volumes",
  description = "Publication-backed editorial work presented with the same bibliographic structure as the publications page.",
  id = "editorial-work-publications",
} = Astro.props;

function getDetailLines(publication: PublicationRecord): string[] {
  const lines: string[] = [];

  if (publication.publisher) {
    lines.push(publication.publisher);
  }

  if (publication.journal) {
    const parts = [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`].filter(Boolean);
    lines.push(parts.join(", "));
  }

  if (publication.book) {
    lines.push(`In: ${publication.book}`);
  }

  const publicationDetails = [publication.pages && `${publication.pages} pp.`, publication.language, publication.isbn && `ISBN ${publication.isbn}`]
    .filter(Boolean)
    .join(" · ");

  if (publicationDetails) {
    lines.push(publicationDetails);
  }

  if (publication.doi) {
    lines.push(`DOI ${publication.doi}`);
  }

  return lines;
}

function getVenueLine(publication: PublicationRecord): string | null {
  if (publication.journal) {
    return [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`]
      .filter(Boolean)
      .join(", ");
  }

  if (publication.book) {
    return `In: ${publication.book}`;
  }

  if (publication.publisher) {
    return publication.publisher;
  }

  return null;
}

function hasExternalSourceLink(href: string): boolean {
  return href !== "https://adamrosinski.com/publications/";
}
---

<section class="editorial-publications-section" aria-labelledby={`${id}-title`}>
  <div class="editorial-publications-heading">
    <p class="editorial-publications-kicker">{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="editorial-publications-grid">
    {items.map((publication) => {
      const displayTitle = getDisplayTitle(publication);
      const secondaryTitle = getSecondaryTitle(publication);
      const venueLine = getVenueLine(publication);
      const strip = getPublicationStrip(publication);
      const hasExternalSource = hasExternalSourceLink(publication.href);
      const stripStyle = [
        `--publication-strip-svg: url("${withBase(strip.asset)}")`,
        `--publication-strip-accent: ${strip.accent}`,
        `--publication-strip-accent-2: ${strip.accent2}`,
      ].join("; ");

      return (
        <details class="editorial-publication-item publication-row" style={stripStyle}>
          <summary class="editorial-publication-summary">
            <div class="editorial-publication-main">
              <PublicationVisual
                publication={publication}
                sectionId="editorial-work"
                title={displayTitle}
                accent={strip.accent}
                accent2={strip.accent2}
              />

              <div class="editorial-publication-title-stack">
                <div class="editorial-publication-meta">
                  <span>
                    <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                    {publication.year}
                  </span>
                  <span>{getPublicationMetaLabel(publication.category, publication.type)}</span>
                </div>

                <h3>{displayTitle}</h3>
                {secondaryTitle && <p class="editorial-publication-secondary-title">{secondaryTitle}</p>}
                {venueLine && <p class="editorial-publication-venue-line">{venueLine}</p>}
              </div>
            </div>

            <div class="editorial-publication-side">
              {publication.pdfHref && (
                <span class="editorial-publication-badge">
                  <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                  PDF
                </span>
              )}
              {hasExternalSource && (
                <span class="editorial-publication-badge">
                  <ExternalLink size={13} stroke-width={1.8} aria-hidden="true" />
                  Source
                </span>
              )}
              <ChevronDown size={18} stroke-width={1.9} aria-hidden="true" class="editorial-publication-chevron" />
            </div>
          </summary>

          <div class="editorial-publication-expanded">
            <div class="editorial-publication-expanded-columns">
              <div class="editorial-publication-column-stack">
                <section class="editorial-publication-block">
                  <p class="editorial-publication-block-label">
                    <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                    Overview
                  </p>
                  <p class="editorial-publication-summary-text">{publication.summary}</p>
                </section>

                <section class="editorial-publication-block">
                  <p class="editorial-publication-block-label">
                    <Tags size={13} stroke-width={1.8} aria-hidden="true" />
                    Keywords
                  </p>
                  <div class="editorial-publication-tags">
                    {publication.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </section>
              </div>

              <div class="editorial-publication-column-side">
                <section class="editorial-publication-block">
                  <p class="editorial-publication-block-label">
                    <Files size={13} stroke-width={1.8} aria-hidden="true" />
                    Bibliographic details
                  </p>
                  <div class="editorial-publication-detail-list">
                    {getDetailLines(publication).map((line) => (
                      <p>{line}</p>
                    ))}
                  </div>
                </section>
              </div>
            </div>

            <div class="editorial-publication-links">
              {publication.pdfHref && (
                <a href={withBase(publication.pdfHref)} target="_blank" rel="noreferrer" class="editorial-publication-link alt-link-with-icon">
                  <span>PDF</span>
                  <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
                </a>
              )}
              {hasExternalSource && (
                <a href={publication.href} target="_blank" rel="noreferrer" class="editorial-publication-link alt-link-with-icon">
                  <span>Source</span>
                  <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </details>
      );
    })}
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const editorialPublicationRows = Array.from(document.querySelectorAll(".editorial-publication-item"));

  for (const row of editorialPublicationRows) {
    const summary = row.querySelector(".editorial-publication-summary");
    const content = row.querySelector(".editorial-publication-expanded");

    if (!(row instanceof HTMLDetailsElement) || !(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) {
      continue;
    }

    let animating = false;

    if (!row.open) {
      content.style.height = "0px";
      content.style.opacity = "0";
    } else {
      content.style.height = "auto";
      content.style.opacity = "1";
    }

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (animating) {
        return;
      }

      if (prefersReducedMotion.matches) {
        row.open = !row.open;
        content.style.height = row.open ? "auto" : "0px";
        content.style.opacity = row.open ? "1" : "0";
        return;
      }

      if (row.open) {
        animating = true;
        row.classList.add("is-closing");
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";
        content.getBoundingClientRect();

        let closeFallback: number | undefined;

        const cleanupClose = () => {
          if (closeFallback) {
            window.clearTimeout(closeFallback);
          }

          row.open = false;
          row.classList.remove("is-closing");
          content.style.height = "0px";
          content.style.opacity = "0";
          animating = false;
          content.removeEventListener("transitionend", handleClose);
          content.removeEventListener("transitioncancel", handleClose);
        };

        requestAnimationFrame(() => {
          content.style.height = "0px";
          content.style.opacity = "0";
        });

        const handleClose = (transitionEvent: TransitionEvent) => {
          if (transitionEvent.type === "transitionend" && transitionEvent.propertyName !== "height") {
            return;
          }

          cleanupClose();
        };

        content.addEventListener("transitionend", handleClose);
        content.addEventListener("transitioncancel", handleClose);
        closeFallback = window.setTimeout(cleanupClose, 420);
        return;
      }

      row.open = true;
      row.classList.remove("is-closing");
      animating = true;
      content.style.height = "0px";
      content.style.opacity = "0";
      content.getBoundingClientRect();

      let openFallback: number | undefined;

      requestAnimationFrame(() => {
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";
      });

      const cleanupOpen = () => {
        if (openFallback) {
          window.clearTimeout(openFallback);
        }

        content.style.height = "auto";
        animating = false;
        content.removeEventListener("transitionend", handleOpen);
        content.removeEventListener("transitioncancel", handleOpen);
      };

      const handleOpen = (transitionEvent: TransitionEvent) => {
        if (transitionEvent.type === "transitionend" && transitionEvent.propertyName !== "height") {
          return;
        }

        cleanupOpen();
      };

      content.addEventListener("transitionend", handleOpen);
      content.addEventListener("transitioncancel", handleOpen);
      openFallback = window.setTimeout(cleanupOpen, 420);
    });
  }
</script>

<style>
  .editorial-publications-section {
    margin-top: 2rem;
  }

  .editorial-publications-heading {
    max-width: 54rem;
    margin-bottom: 1.25rem;
  }

  .editorial-publications-kicker,
  .editorial-publication-meta,
  .editorial-publication-block-label {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .editorial-publications-kicker {
    color: #56d8ff;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .editorial-publications-heading h2 {
    margin-top: 0.45rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .editorial-publications-heading p,
  .editorial-publication-summary-text,
  .editorial-publication-detail-list p,
  .editorial-publication-secondary-title {
    color: #a1a1aa;
    line-height: 1.72;
  }

  .editorial-publications-grid {
    display: grid;
    gap: 1rem;
  }

  .editorial-publication-item {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(9, 12, 18, 0.55);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(18px);
    isolation: isolate;
  }

  .editorial-publication-item[open] {
    border-color: rgba(86, 216, 255, 0.18);
    background: rgba(9, 12, 18, 0.72);
  }

  .editorial-publication-item::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 84% 3.9rem, var(--publication-strip-accent) 0%, transparent 46%),
      linear-gradient(
        90deg,
        rgba(1, 2, 5, 0.998) 0%,
        rgba(1, 2, 5, 0.997) 52%,
        rgba(1, 2, 5, 0.992) 74%,
        rgba(0, 0, 0, 0.9) 88%,
        rgba(0, 0, 0, 0.9) 100%
      );
  }

  .editorial-publication-item::after {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    background: rgba(0, 0, 0, 0.56);
    pointer-events: none;
  }

  .editorial-publication-summary {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    list-style: none;
    cursor: pointer;
  }

  .editorial-publication-summary::before {
    content: "";
    position: absolute;
    inset: 0 -0.6rem 0 0;
    z-index: -1;
    opacity: 0.78;
    background-image: var(--publication-strip-svg);
    background-repeat: no-repeat;
    background-position: right top;
    background-size: min(60%, 800px) auto;
    pointer-events: none;
    transform-origin: right top;
    transition: opacity 180ms ease, transform 220ms ease;
    filter: brightness(0.98) contrast(1.18) saturate(0.82);
  }

  .editorial-publication-item:hover .editorial-publication-summary::before {
    opacity: 0.86;
    transform: translateX(-0.45rem) scale(1.03);
  }

  .editorial-publication-item[open]:not(.is-closing) .editorial-publication-summary::before {
    opacity: 0.9;
    transform: translateX(-0.45rem) scale(1.3);
  }

  .editorial-publication-item.is-closing .editorial-publication-summary::before {
    opacity: 0.78;
    transform: translateX(0) scale(1);
  }

  .editorial-publication-item.is-closing:hover .editorial-publication-summary::before {
    opacity: 0.86;
    transform: translateX(-0.45rem) scale(1.03);
  }

  .editorial-publication-summary::-webkit-details-marker {
    display: none;
  }

  .editorial-publication-main {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding-right: clamp(0.75rem, 6vw, 5.5rem);
  }

  .editorial-publication-title-stack {
    min-width: 0;
    max-width: 44rem;
  }

  .editorial-publication-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    color: #9195a5;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .editorial-publication-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .editorial-publication-item h3 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: 1.12rem;
    line-height: 1.4;
    max-width: 100%;
    text-wrap: pretty;
  }

  .editorial-publication-secondary-title {
    margin-top: 0.4rem;
    font-size: 0.92rem;
  }

  .editorial-publication-venue-line {
    margin-top: 0.42rem;
    color: #b5b8c7;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .editorial-publication-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .editorial-publication-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #c6cad8;
    font-size: 0.82rem;
  }

  .editorial-publication-chevron {
    color: #c6cad8;
    transition: transform 180ms ease;
  }

  .editorial-publication-item[open] .editorial-publication-chevron {
    transform: rotate(180deg);
  }

  .editorial-publication-expanded {
    position: relative;
    z-index: 0;
    display: grid;
    gap: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 1.2rem;
    transition:
      height 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  .editorial-publication-expanded-columns {
    display: grid;
    gap: 0;
  }

  .editorial-publication-column-stack,
  .editorial-publication-column-side {
    display: grid;
    gap: 0;
  }

  .editorial-publication-column-side .editorial-publication-block {
    padding-inline: 1rem;
    padding-bottom: 1rem;
    border-radius: 18px;
    background: transparent;
    border: 0;
  }

  .editorial-publication-column-side .editorial-publication-block-label,
  .editorial-publication-column-side .editorial-publication-detail-list p {
    color: #f4f7ff;
  }

  .editorial-publication-block {
    padding: 0.95rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .editorial-publication-block-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: #56d8ff;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .editorial-publication-summary-text {
    margin-top: 0.55rem;
  }

  .editorial-publication-detail-list {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }

  .editorial-publication-detail-list p {
    margin: 0;
    font-size: 0.95rem;
  }

  .editorial-publication-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .editorial-publication-tags span {
    padding: 0.33rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    font-size: 0.8rem;
    line-height: 1;
  }

  .editorial-publication-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 0 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .editorial-publication-link {
    color: #56d8ff;
    text-decoration: none;
  }

  .editorial-publication-link:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .editorial-publication-summary::before {
      inset: 0 -0.35rem 0 0;
      opacity: 0.32;
      background-position: right top;
      background-size: 108% auto;
    }

    .editorial-publication-item:hover .editorial-publication-summary::before {
      opacity: 0.4;
      transform: translateX(-0.2rem) scale(1.018);
    }

    .editorial-publication-item[open]:not(.is-closing) .editorial-publication-summary::before {
      opacity: 0.46;
      transform: translateX(-0.2rem) scale(1.3);
    }

    .editorial-publication-item.is-closing .editorial-publication-summary::before {
      opacity: 0.32;
      transform: translateX(0) scale(1);
    }

    .editorial-publication-item.is-closing:hover .editorial-publication-summary::before {
      opacity: 0.4;
      transform: translateX(-0.2rem) scale(1.018);
    }

    .editorial-publication-item::before {
      background:
        radial-gradient(circle at 84% 3.2rem, var(--publication-strip-accent-2) 0%, transparent 44%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.9));
    }

    .editorial-publication-summary {
      flex-direction: column;
    }

    .editorial-publication-side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .editorial-publication-main {
      align-items: flex-start;
      padding-right: 0;
    }

    .editorial-publication-title-stack {
      max-width: 100%;
    }
  }

  @media (min-width: 960px) {
    .editorial-publication-expanded-columns {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      column-gap: 1.4rem;
      align-items: start;
    }

    .editorial-publication-links {
      margin-top: 0.2rem;
    }
  }

  @media (min-width: 721px) and (max-width: 959px) {
    .editorial-publication-summary::before {
      inset: 0 -0.3rem 0 0;
      opacity: 0.62;
      background-position: right top;
      background-size: 74% auto;
    }

    .editorial-publication-item:hover .editorial-publication-summary::before {
      opacity: 0.74;
      transform: translateX(-0.3rem) scale(1.024);
    }

    .editorial-publication-item[open]:not(.is-closing) .editorial-publication-summary::before {
      opacity: 0.8;
      transform: translateX(-0.3rem) scale(1.3);
    }

    .editorial-publication-item.is-closing .editorial-publication-summary::before {
      opacity: 0.62;
      transform: translateX(0) scale(1);
    }

    .editorial-publication-item.is-closing:hover .editorial-publication-summary::before {
      opacity: 0.74;
      transform: translateX(-0.3rem) scale(1.024);
    }

    .editorial-publication-item::before {
      background:
        radial-gradient(circle at 84% 3.4rem, var(--publication-strip-accent) 0%, transparent 46%),
        linear-gradient(
          90deg,
          rgba(1, 2, 5, 0.997) 0%,
          rgba(1, 2, 5, 0.994) 64%,
          rgba(0, 0, 0, 0.9) 100%
        );
    }

    .editorial-publication-main {
      padding-right: 2.4rem;
    }

    .editorial-publication-title-stack {
      max-width: 38rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-publication-summary::before {
      transition: none;
      transform: none;
    }
  }
</style>
