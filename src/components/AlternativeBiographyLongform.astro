---
import { originalBiographyParagraphs } from "../data/biographyOriginal";
---

<section class="alt-section">
  <div class="alt-biography-panel">
    <div class="alt-biography-copy">
      {originalBiographyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .alt-section {
    padding: 0 0 4.5rem;
  }

  .alt-biography-panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 2rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .alt-biography-copy {
    max-width: 72rem;
  }

  .alt-biography-copy p {
    color: #d4d4d8;
    line-height: 1.95;
    font-size: 1rem;
  }

  .alt-biography-copy p + p {
    margin-top: 1.5rem;
  }

  @media (max-width: 720px) {
    .alt-biography-panel {
      padding: 1.2rem;
    }
  }
</style>
