---
import SectionHeading from "./SectionHeading.astro";
import { getContent } from "../data/content";
import { localizedPath } from "../utils/i18n";

const content = getContent("en");
---
<section id="about-preview" class="shell section-space">
  <div class="glass-panel p-6 md:p-10">
    <SectionHeading
      eyebrow="manifest / biography"
      title="Sound as a medium of perception, space, and technological decision-making."
      intro="Instead of a formal academic biography, the landing page uses a short text that connects research with practice."
    />

    <div class="prose-copy mt-8 grid gap-8 lg:grid-cols-2">
      <div>
        <p>
          {content.site.tagline}
        </p>
        <p class="mt-4">
          The common thread is the question of how we hear, how we design listening conditions, and how technical tools affect the artistic shape of sonic experience.
        </p>
      </div>

      <div>
        <p>
          The website is structured less like a static academic CV and more like an interface that explains the relation between perception, recording, space, and education.
        </p>
        <p class="mt-4">
          The new multipage structure then expands that interface into detailed subpages, publication listings, the audio demonstrator, and project-oriented material.
        </p>
      </div>
    </div>

    <a href={localizedPath("/about")} class="site-inline-link">Open about page</a>
  </div>
</section>
