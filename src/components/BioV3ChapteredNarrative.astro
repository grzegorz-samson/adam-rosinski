---
import Brain from "@lucide/astro/icons/brain";
import AudioWaveform from "@lucide/astro/icons/audio-waveform";
import BookOpen from "@lucide/astro/icons/book-open";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import WavesHorizontal from "@lucide/astro/icons/waves-horizontal";
import PenLine from "@lucide/astro/icons/pen-line";
import Building2 from "@lucide/astro/icons/building-2";
import Radio from "@lucide/astro/icons/radio";
import Network from "@lucide/astro/icons/network";
import Sparkles from "@lucide/astro/icons/sparkles";
import { biographyV3Chapters } from "../data/biographyV3";
import { originalBiographyParagraphs } from "../data/biographyOriginal";
import { linkBiographyV3Paragraph } from "../data/biographyV3Links";
import { withBase } from "../utils/withBase";

const icons = {
  Brain,
  AudioWaveform,
  BookOpen,
  GraduationCap,
  WavesHorizontal,
  PenLine,
  Building2,
  Radio,
  Network,
  Sparkles,
};
---

<section class="bio-v3" aria-label="Chaptered biography" data-bio-v3-root>
  <div class="bio-v3-layout">
    <aside class="bio-v3-sidebar" aria-label="Biography contents and timeline">
      <div class="bio-v3-sidebar-card" data-bio-v3-sidebar>
        <div class="bio-v3-sidebar-heading">
          <span>Contents</span>
          <strong>Biography timeline</strong>
        </div>

        <nav class="bio-v3-timeline" aria-label="Biography chapters">
          <span class="bio-v3-timeline-track" aria-hidden="true">
            <span class="bio-v3-timeline-progress"></span>
          </span>

          {biographyV3Chapters.map((chapter, index) => (
            <a
              href={withBase(`/bio#${chapter.id}`)}
              class:list={["bio-v3-timeline-link", index === 0 && "is-active"]}
              data-bio-v3-link={chapter.id}
              aria-current={index === 0 ? "location" : undefined}
            >
              <span class="bio-v3-timeline-node" aria-hidden="true"></span>
              <span class="bio-v3-timeline-number">{chapter.number}</span>
              <span class="bio-v3-timeline-title">{chapter.title}</span>
            </a>
          ))}
        </nav>

        <div class="bio-v3-signal" aria-hidden="true" data-bio-v3-signal>
          <svg viewBox="0 0 520 220" focusable="false">
            <defs>
              <linearGradient id="bio-v3-signal-gradient" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#67e8f9"></stop>
                <stop offset="0.45" stop-color="#6ee7b7"></stop>
                <stop offset="0.75" stop-color="#c4b5fd"></stop>
                <stop offset="1" stop-color="#fbbf24"></stop>
              </linearGradient>
            </defs>
            <rect width="520" height="220" rx="26" fill="#ffffff" opacity="0.035"></rect>
            <g stroke="#fff" stroke-opacity="0.08" stroke-width="1">
              <path d="M40 44h440M40 88h440M40 132h440M40 176h440"></path>
              <path d="M84 30v160M172 30v160M260 30v160M348 30v160M436 30v160"></path>
            </g>
            <path
              d="M38 139c28-67 61-87 98-60s54 77 96 52 49-98 91-80 44 91 90 77 51-75 70-95"
              fill="none"
              stroke="url(#bio-v3-signal-gradient)"
              stroke-width="5"
              stroke-linecap="round"
            ></path>
            <g class="bio-v3-signal-dots" stroke="url(#bio-v3-signal-gradient)" stroke-width="4">
              <circle class="bio-v3-signal-dot is-active" data-bio-v3-signal-dot cx="38" cy="139" r="8"></circle>
              <circle class="bio-v3-signal-dot" data-bio-v3-signal-dot cx="136" cy="79" r="8"></circle>
              <circle class="bio-v3-signal-dot" data-bio-v3-signal-dot cx="232" cy="131" r="8"></circle>
              <circle class="bio-v3-signal-dot" data-bio-v3-signal-dot cx="323" cy="51" r="8"></circle>
              <circle class="bio-v3-signal-dot" data-bio-v3-signal-dot cx="413" cy="128" r="8"></circle>
              <circle class="bio-v3-signal-dot" data-bio-v3-signal-dot cx="483" cy="33" r="8"></circle>
            </g>
          </svg>
        </div>
      </div>
    </aside>

    <div class="bio-v3-chapters">
      {biographyV3Chapters.map((chapter) => {
        const Icon = icons[chapter.icon as keyof typeof icons] ?? Brain;
        const paragraphs = chapter.paragraphIndexes.map((paragraphIndex) => ({
          paragraphIndex,
          text: originalBiographyParagraphs[paragraphIndex],
        }));

        return (
          <article
            id={chapter.id}
            class:list={["bio-v3-chapter", `bio-v3-chapter-${chapter.accent}`]}
            data-bio-v3-chapter={chapter.id}
          >
            <header class="bio-v3-chapter-header">
              <div class="bio-v3-chapter-index" aria-hidden="true">{chapter.number}</div>
              <div class="bio-v3-chapter-icon" aria-hidden="true">
                <Icon size={21} stroke-width={1.75} />
              </div>
              <div class="bio-v3-chapter-heading">
                <span>{chapter.eyebrow}</span>
                <h2>{chapter.title}</h2>
              </div>
            </header>

            <div class="bio-v3-chapter-copy">
              {paragraphs.map(({ paragraphIndex, text }) => (
                <p>
                  {linkBiographyV3Paragraph(text, paragraphIndex).map((segment) => {
                    if (!segment.link) return segment.text;

                    const href =
                      segment.link.kind === "internal"
                        ? withBase(segment.link.href)
                        : segment.link.href;

                    return (
                      <a
                        href={href}
                        class:list={[
                          "bio-v3-inline-link",
                          segment.link.kind === "external" && "bio-v3-inline-link-external",
                        ]}
                        target={segment.link.kind === "external" ? "_blank" : undefined}
                        rel={segment.link.kind === "external" ? "noopener noreferrer" : undefined}
                        title={segment.link.title}
                      >
                        {segment.text}
                      </a>
                    );
                  })}
                </p>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  function setupBioV3Timeline() {
    const root = document.querySelector("[data-bio-v3-root]");
    if (!(root instanceof HTMLElement) || root.dataset.timelineReady === "true") return;

    const sidebar = root.querySelector("[data-bio-v3-sidebar]");
    const links = Array.from(root.querySelectorAll("[data-bio-v3-link]"));
    const chapters = Array.from(root.querySelectorAll("[data-bio-v3-chapter]"));
    const signalDots = Array.from(root.querySelectorAll("[data-bio-v3-signal-dot]"));

    if (!(sidebar instanceof HTMLElement) || links.length === 0 || chapters.length === 0) return;

    root.dataset.timelineReady = "true";
    let activeId = "";
    let ticking = false;

    const setActive = (id) => {
      if (activeId === id) return;
      activeId = id;

      const activeIndex = Math.max(
        0,
        links.findIndex((link) => link.getAttribute("data-bio-v3-link") === id),
      );
      const progress = links.length > 1 ? (activeIndex / (links.length - 1)) * 100 : 100;
      sidebar.style.setProperty("--bio-v3-progress", `${progress}%`);

      if (signalDots.length > 0) {
        const activeDotIndex =
          links.length > 1
            ? Math.round((activeIndex / (links.length - 1)) * (signalDots.length - 1))
            : signalDots.length - 1;

        signalDots.forEach((dot, index) => {
          dot.classList.toggle("is-active", index <= activeDotIndex);
        });
      }

      links.forEach((link) => {
        const isActive = link.getAttribute("data-bio-v3-link") === id;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const updateActiveChapter = () => {
      ticking = false;
      const scrollBottom = window.scrollY + window.innerHeight;
      const documentHeight = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight,
      );

      if (documentHeight - scrollBottom <= 8) {
        const lastChapter = chapters[chapters.length - 1];
        const lastId = lastChapter?.getAttribute("data-bio-v3-chapter");
        if (lastId) setActive(lastId);
        return;
      }

      const readingLine = Math.min(window.innerHeight * 0.52, 420);
      let current = chapters[0];
      let closestDistance = Number.POSITIVE_INFINITY;
      const lastChapter = chapters[chapters.length - 1];
      const lastRect = lastChapter?.getBoundingClientRect();

      if (lastChapter && lastRect) {
        const visibleHeight = Math.max(
          0,
          Math.min(lastRect.bottom, window.innerHeight) - Math.max(lastRect.top, 0),
        );
        const visibleRatio = visibleHeight / Math.max(lastRect.height, 1);
        if (visibleRatio >= 0.55 || lastRect.bottom <= window.innerHeight + 24) {
          const lastId = lastChapter.getAttribute("data-bio-v3-chapter");
          if (lastId) setActive(lastId);
          return;
        }
      }

      chapters.forEach((chapter) => {
        const rect = chapter.getBoundingClientRect();
        const isVisible = rect.bottom >= 0 && rect.top <= window.innerHeight;
        if (!isVisible) return;

        const chapterCenter = rect.top + rect.height / 2;
        const distance = Math.abs(chapterCenter - readingLine);
        if (distance < closestDistance) {
          closestDistance = distance;
          current = chapter;
        }
      });

      const id = current.getAttribute("data-bio-v3-chapter");
      if (id) setActive(id);
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateActiveChapter);
    };

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.getAttribute("data-bio-v3-link");
        if (id) setActive(id);
      });
    });

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    updateActiveChapter();
  }

  setupBioV3Timeline();
  document.addEventListener("astro:page-load", setupBioV3Timeline);
</script>

<style>
  .bio-v3 {
    padding: 0 0 5rem;
  }

  .bio-v3-layout {
    display: grid;
    grid-template-columns: minmax(240px, 0.34fr) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
  }

  .bio-v3-sidebar {
    position: sticky;
    top: 6rem;
  }

  .bio-v3-sidebar-card,
  .bio-v3-chapter {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    box-shadow: 0 20px 68px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px);
  }

  .bio-v3-sidebar-card {
    --bio-v3-progress: 0%;
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    padding: 1.1rem;
  }

  .bio-v3-sidebar-card::before {
    content: "";
    position: absolute;
    inset: -8rem -10rem auto auto;
    width: 18rem;
    height: 18rem;
    border-radius: 999px;
    background: rgba(103, 232, 249, 0.1);
    filter: blur(12px);
    pointer-events: none;
  }

  .bio-v3-sidebar-heading {
    position: relative;
    display: grid;
    gap: 0.28rem;
    padding: 0.2rem 0.25rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bio-v3-sidebar-heading span,
  .bio-v3-chapter-heading span {
    color: #8cdfff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bio-v3-sidebar-heading strong {
    color: #fff;
    font-size: 1rem;
    line-height: 1.3;
  }

  .bio-v3-timeline {
    position: relative;
    display: grid;
    gap: 0.15rem;
    margin-top: 0.75rem;
  }

  .bio-v3-timeline-track {
    position: absolute;
    left: 0.73rem;
    top: 1.12rem;
    bottom: 1.12rem;
    width: 1px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .bio-v3-timeline-progress {
    display: block;
    width: 100%;
    height: var(--bio-v3-progress);
    background: linear-gradient(180deg, #67e8f9, #a78bfa 46%, #6ee7b7 76%, #fbbf24);
    box-shadow: 0 0 12px rgba(103, 232, 249, 0.62);
    transition: height 260ms ease;
  }

  .bio-v3-timeline-link {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem 2.1rem minmax(0, 1fr);
    gap: 0.45rem;
    align-items: start;
    border-radius: 14px;
    padding: 0.55rem 0.42rem 0.55rem 0;
    color: #b8c2d0;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .bio-v3-timeline-link:hover,
  .bio-v3-timeline-link.is-active {
    background: rgba(103, 232, 249, 0.075);
    color: #fff;
    transform: translateX(2px);
  }

  .bio-v3-timeline-node {
    position: relative;
    z-index: 1;
    width: 0.58rem;
    height: 0.58rem;
    margin: 0.31rem auto 0;
    border: 1px solid rgba(103, 232, 249, 0.72);
    border-radius: 999px;
    background: #0a0d14;
    box-shadow: 0 0 0 4px rgba(10, 13, 20, 0.92);
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .bio-v3-timeline-link.is-active .bio-v3-timeline-node {
    background: #67e8f9;
    box-shadow: 0 0 0 4px rgba(10, 13, 20, 0.92), 0 0 16px rgba(103, 232, 249, 0.82);
    transform: scale(1.12);
  }

  .bio-v3-timeline-number {
    color: #67e8f9;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .bio-v3-timeline-title {
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .bio-v3-signal {
    position: relative;
    margin-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.85rem;
  }

  .bio-v3-signal svg {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.78;
  }

  .bio-v3-signal-dot {
    fill: #05070b;
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 220ms ease, filter 220ms ease, transform 220ms ease;
  }

  .bio-v3-signal-dot.is-active {
    fill: #67e8f9;
    filter: drop-shadow(0 0 7px rgba(103, 232, 249, 0.72));
    transform: scale(1.12);
  }

  .bio-v3-chapters {
    display: grid;
    gap: 1rem;
  }

  .bio-v3-chapter {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: clamp(1.25rem, 2.8vw, 2.2rem);
    scroll-margin-top: 6rem;
  }

  .bio-v3-chapter::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, rgba(103, 232, 249, 0.88), transparent 70%);
  }

  .bio-v3-chapter::after {
    content: "";
    position: absolute;
    right: -9rem;
    top: -10rem;
    width: 20rem;
    height: 20rem;
    border-radius: 999px;
    background: rgba(103, 232, 249, 0.095);
    filter: blur(12px);
    pointer-events: none;
  }

  .bio-v3-chapter-violet::before {
    background: linear-gradient(90deg, rgba(167, 139, 250, 0.92), transparent 70%);
  }

  .bio-v3-chapter-violet::after {
    background: rgba(167, 139, 250, 0.11);
  }

  .bio-v3-chapter-emerald::before {
    background: linear-gradient(90deg, rgba(110, 231, 183, 0.9), transparent 70%);
  }

  .bio-v3-chapter-emerald::after {
    background: rgba(110, 231, 183, 0.095);
  }

  .bio-v3-chapter-amber::before {
    background: linear-gradient(90deg, rgba(251, 191, 36, 0.9), transparent 70%);
  }

  .bio-v3-chapter-amber::after {
    background: rgba(251, 191, 36, 0.095);
  }

  .bio-v3-chapter-header {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.085);
  }

  .bio-v3-chapter-index {
    color: rgba(255, 255, 255, 0.18);
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: clamp(1.5rem, 3vw, 2.45rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .bio-v3-chapter-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 999px;
    background: rgba(103, 232, 249, 0.08);
    color: #67e8f9;
  }

  .bio-v3-chapter-violet .bio-v3-chapter-icon {
    border-color: rgba(167, 139, 250, 0.28);
    background: rgba(167, 139, 250, 0.08);
    color: #c4b5fd;
  }

  .bio-v3-chapter-emerald .bio-v3-chapter-icon {
    border-color: rgba(110, 231, 183, 0.28);
    background: rgba(110, 231, 183, 0.08);
    color: #6ee7b7;
  }

  .bio-v3-chapter-amber .bio-v3-chapter-icon {
    border-color: rgba(251, 191, 36, 0.28);
    background: rgba(251, 191, 36, 0.08);
    color: #fbbf24;
  }

  .bio-v3-chapter-violet .bio-v3-chapter-heading span {
    color: #c4b5fd;
  }

  .bio-v3-chapter-emerald .bio-v3-chapter-heading span {
    color: #6ee7b7;
  }

  .bio-v3-chapter-amber .bio-v3-chapter-heading span {
    color: #fbbf24;
  }

  .bio-v3-chapter-heading {
    min-width: 0;
  }

  .bio-v3-chapter-heading span {
    display: block;
    margin-bottom: 0.42rem;
  }

  .bio-v3-chapter-heading h2 {
    max-width: 52rem;
    color: #fff;
    font-size: clamp(1.35rem, 2.6vw, 2.05rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .bio-v3-chapter-copy {
    position: relative;
    max-width: 96ch;
    padding-top: 1.2rem;
  }

  .bio-v3-chapter-copy p {
    color: #d4d4d8;
    font-size: 1rem;
    line-height: 1.96;
    text-align: justify;
    text-wrap: pretty;
  }

  .bio-v3-chapter-copy p + p {
    margin-top: 1.35rem;
  }

  @media (max-width: 1080px) {
    .bio-v3-layout {
      grid-template-columns: 1fr;
    }

    .bio-v3-sidebar {
      position: static;
    }

    .bio-v3-timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.2rem 0.6rem;
    }

    .bio-v3-timeline-track {
      display: none;
    }

    .bio-v3-timeline-link {
      grid-template-columns: 2.1rem minmax(0, 1fr);
      padding-left: 0.45rem;
    }

    .bio-v3-timeline-node {
      display: none;
    }

    .bio-v3-signal {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .bio-v3 {
      padding-bottom: 3.25rem;
    }

    .bio-v3-sidebar-card {
      padding: 0.9rem;
    }

    .bio-v3-timeline {
      grid-template-columns: 1fr;
    }

    .bio-v3-chapter-header {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .bio-v3-chapter-index {
      grid-row: 1 / span 2;
    }

    .bio-v3-chapter-icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-v3-timeline-progress,
    .bio-v3-timeline-link,
    .bio-v3-timeline-node {
      transition: none;
    }
  }

  .bio-v3-inline-link {
    color: #a7f3ff;
    text-decoration-line: underline;
    text-decoration-color: rgba(103, 232, 249, 0.64);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .bio-v3-inline-link:hover,
  .bio-v3-inline-link:focus-visible {
    color: #ecfeff;
    text-decoration-color: #67e8f9;
  }

  .bio-v3-inline-link:focus-visible {
    outline: 2px solid rgba(103, 232, 249, 0.72);
    outline-offset: 3px;
  }

  .bio-v3-inline-link-external {
    color: #bae6fd;
    text-decoration-style: dotted;
  }
</style>
