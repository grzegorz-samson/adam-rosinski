---
interface Props {
  kicker: string;
  title: string;
  intro: string;
}

const { kicker, title, intro } = Astro.props;
---

<section class="alt-page-section">
  <div class="alt-page-panel">
    <p class="alt-kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="alt-copy">{intro}</p>
  </div>
</section>

<style>
  .alt-page-section {
    padding-top: 2rem;
  }

  .alt-page-panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 2rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .alt-kicker {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #56d8ff;
  }

  h1 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-copy {
    margin-top: 1rem;
    max-width: 52rem;
    color: #a1a1aa;
    line-height: 1.85;
    font-size: 1.02rem;
  }
</style>
