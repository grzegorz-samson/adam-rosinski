---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="shell section-space pb-8">
  <div class="glass-panel relative overflow-hidden px-6 py-10 md:px-10 md:py-12">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-5 text-4xl font-semibold leading-none tracking-tight text-balance text-white md:text-6xl">
        {title}
      </h1>
      <p class="muted mt-6 max-w-3xl text-base leading-8 md:text-lg">
        {intro}
      </p>
    </div>
  </div>
</section>
