---
import SectionHeading from "./SectionHeading.astro";
import { getContent } from "../data/content";
import { localizedPath } from "../utils/i18n";
import { withBase } from "../utils/withBase";

const content = getContent("en");
---
<section id="practice" class="shell section-space">
  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="glass-panel relative overflow-hidden p-3">
      <img
        src={withBase("/images/placeholder-studio.svg")}
        alt="Abstract studio and acoustic-field illustration"
        class="h-full min-h-[22rem] w-full rounded-[1.35rem] object-cover"
      />
    </div>

    <div class="glass-panel p-6 md:p-8">
      <SectionHeading
        eyebrow="studio / practice / technology"
        title="Studio practice and research are not separate worlds here."
        intro="Recording is treated at the same time as a technical, artistic, and cognitive process. This section keeps that overlap visible."
      />

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {content.practiceCards.map((card) => (
          <article class="soft-card p-5">
            <h3 class="text-lg font-semibold text-white">{card.title}</h3>
            <p class="muted mt-3 text-sm leading-7">{card.summary}</p>
          </article>
        ))}
      </div>

      <a href={localizedPath("/practice")} class="site-inline-link">Open practice page</a>
    </div>
  </div>
</section>
