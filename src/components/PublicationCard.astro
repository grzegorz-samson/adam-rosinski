---
import { withBase } from "../utils/withBase";

interface PublicationItem {
  slug?: string;
  title: string;
  year: number;
  summary: string;
  tags: string[];
  href: string;
  type?: string;
  cover?: string;
}

interface LegacyPublication {
  id: string;
  data: PublicationItem;
}

interface Props {
  publication: PublicationItem | LegacyPublication;
}

const { publication } = Astro.props;
const item = "data" in publication ? publication.data : publication;
---

<article class="site-card publication-card">
  {item.cover && <img src={withBase(item.cover)} alt="" class="publication-card-cover" loading="lazy" />}

  <div class="publication-card-meta">
    <span>{item.year}</span>
    {item.type && <span>{item.type}</span>}
  </div>

  <h3 class="site-title-md">{item.title}</h3>
  <p class="site-copy">{item.summary}</p>

  <div class="site-tag-row">
    {item.tags.map((tag) => <span class="site-tag">{tag}</span>)}
  </div>

  <a href={item.href} target="_blank" rel="noreferrer" class="site-inline-link">
    Open publication
  </a>
</article>
