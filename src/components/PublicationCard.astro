---
import PillTag from "./PillTag.astro";

interface Props {
  publication: {
    id: string;
    data: {
      title: string;
      year: number;
      summary: string;
      tags: string[];
      href: string;
    };
  };
}

const { publication } = Astro.props;
---
<article class="soft-card flex h-full flex-col p-6">
  <div class="flex items-center justify-between gap-4">
    <span class="text-sm text-zinc-500">{publication.data.year}</span>
    <a
      href={publication.data.href}
      target="_blank"
      rel="noreferrer"
      class="text-sm text-cyan-200 transition hover:text-white"
    >
      Open source ↗
    </a>
  </div>

  <h3 class="mt-4 text-xl font-semibold leading-snug text-white">{publication.data.title}</h3>
  <p class="muted mt-4 text-sm leading-7">{publication.data.summary}</p>

  <div class="mt-6 flex flex-wrap gap-2">
    {publication.data.tags.map((tag, index) => (
      <PillTag label={tag} tone={index === 0 ? "amber" : "neutral"} />
    ))}
  </div>
</article>
