---
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import FingerprintPattern from "@lucide/astro/icons/fingerprint-pattern";
import BadgeInfo from "@lucide/astro/icons/badge-info";
import ExternalLink from "@lucide/astro/icons/external-link";
import { quickLinks } from "../data/links";

const profileIcons = {
  ORCID: FingerprintPattern,
  "Google Scholar": GraduationCap,
  SciProfiles: BadgeInfo,
};
---

<section id="profiles-alt" class="alt-section">
  <div class="alt-heading">
    <h2>Research Visibility</h2>
    <p>External research profiles provide direct access to publications, scholarly records, and indexed academic output.</p>
  </div>

  <div class="alt-grid">
    {quickLinks.map((link) => {
      const Icon = profileIcons[link.label as keyof typeof profileIcons] ?? BadgeInfo;

      return (
        <a href={link.href} target="_blank" rel="noreferrer" class="alt-profile-card">
          <div class="alt-profile-head">
            <div class="alt-profile-title-row">
              <Icon size={18} stroke-width={1.75} aria-hidden="true" />
              <h3>{link.label}</h3>
            </div>
            <ExternalLink size={16} stroke-width={1.75} aria-hidden="true" />
          </div>
          <span class="alt-profile-link-label">View profile</span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 72rem;
    margin-bottom: 2rem;
  }

  .alt-heading h2 {
    color: #fff;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .alt-heading p:last-child {
    margin-top: 1rem;
    max-width: 72rem;
    color: #a1a1aa;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .alt-profile-card {
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .alt-profile-card:hover {
    transform: translateY(-4px);
    border-color: rgba(86, 216, 255, 0.4);
    background: rgba(255, 255, 255, 0.055);
  }

  .alt-profile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .alt-profile-title-row {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .alt-profile-title-row > svg,
  .alt-profile-head > svg {
    color: #56d8ff;
    opacity: 0.88;
    flex: 0 0 auto;
  }

  .alt-profile-card h3 {
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-profile-link-label {
    display: inline-block;
    margin-top: 1rem;
    color: #56d8ff;
    font-weight: 600;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
