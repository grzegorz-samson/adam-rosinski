---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
}
const { eyebrow, title, intro, align = "left" } = Astro.props;
const wrapClass = align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl";
---

<div class={wrapClass}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance text-white md:text-5xl">
    {title}
  </h2>
  {intro && <p class="muted mt-5 text-base leading-7 md:text-lg">{intro}</p>}
</div>
