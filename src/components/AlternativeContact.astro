---
import ContactMailForm from "./ContactMailForm.astro";

interface Props {
  showForm?: boolean;
}

const { showForm = false } = Astro.props as Props;
---

<section id="contact-alt" class="alt-footer">
  <div class="alt-grid" data-has-form={showForm ? "true" : "false"}>
    <div class="alt-copy-block">
      <h2>Research collaboration, consultation, artistic projects, and teaching-related work.</h2>
      <p class="alt-contact-note">
        Use the protected contact form for research enquiries, teaching-related questions, editorial exchange, and project collaboration.
      </p>
    </div>
    {showForm && <ContactMailForm />}
  </div>
</section>

<style>
  .alt-footer {
    padding: 4.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .alt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .alt-grid[data-has-form="true"] {
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
  }

  h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-contact-note {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-copy-block {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  @media (max-width: 960px) {
    .alt-grid,
    .alt-grid[data-has-form="true"] {
      grid-template-columns: 1fr;
    }
  }
</style>
