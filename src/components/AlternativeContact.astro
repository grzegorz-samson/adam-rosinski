---
import ContactMailForm from "./ContactMailForm.astro";
import { site } from "../data/site";

interface Props {
  showForm?: boolean;
}

const { showForm = false } = Astro.props as Props;
const [localPart = "", host = ""] = site.email.split("@");
const hostParts = host.split(".");
const tld = hostParts.pop() ?? "";
const domain = hostParts.join(".");
const toCodes = (value: string) => Array.from(value).map((char) => char.charCodeAt(0)).join("-");
---

<section id="contact-alt" class="alt-footer">
  <div class="alt-grid" data-has-form={showForm ? "true" : "false"}>
    <div class="alt-copy-block">
      <h2>Research collaboration, consultation, artistic projects, and teaching-related work.</h2>
      <div class="alt-email-line">
        <span class="alt-email-label">Contact email</span>
        <span class="alt-email-placeholder">[email placeholder]</span>
      </div>
    </div>
    {showForm && <ContactMailForm emailCodes={{ local: toCodes(localPart), domain: toCodes(domain), tld: toCodes(tld) }} />}
  </div>
</section>

<style>
  .alt-footer {
    padding: 4.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .alt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .alt-grid[data-has-form="true"] {
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
  }

  h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-copy-block {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .alt-email-line {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    color: #a1a1aa;
  }

  .alt-email-label {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .alt-email-placeholder {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: #dbe4ef;
    font-size: 0.84rem;
    line-height: 1;
  }

  @media (max-width: 960px) {
    .alt-grid,
    .alt-grid[data-has-form="true"] {
      grid-template-columns: 1fr;
    }
  }
</style>
