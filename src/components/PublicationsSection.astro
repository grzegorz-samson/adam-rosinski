---
import SectionHeading from "./SectionHeading.astro";
import PublicationCard from "./PublicationCard.astro";

interface Entry {
  id: string;
  data: {
    title: string;
    year: number;
    summary: string;
    tags: string[];
    href: string;
    featured: boolean;
  };
}
interface Props {
  publications: Entry[];
}
const { publications } = Astro.props;
---

<section id="publications" class="shell section-space">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionHeading
      eyebrow="selected publications"
      title="Wybrane publikacje jako punkty wejścia do jego pola pracy."
      intro="Sekcja może później przejść w pełną podstronę z filtrami, DOI, abstraktami i metadanymi."
    />
    <a href="/publications" class="button-secondary self-start">See all publications</a>
  </div>

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {publications.map((publication) => (
      <PublicationCard publication={publication} />
    ))}
  </div>
</section>
