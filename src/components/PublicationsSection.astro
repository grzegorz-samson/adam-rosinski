---
import SectionHeading from "./SectionHeading.astro";
import PublicationCard from "./PublicationCard.astro";
import { localizedPath } from "../utils/i18n";

interface Props {
  publications: Array<unknown>;
}
const { publications } = Astro.props;
---

<section id="publications" class="shell section-space">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionHeading
      eyebrow="selected publications"
      title="Selected publications as entry points into the research field."
      intro="The landing page keeps only a focused subset. The full list lives on the dedicated publications page."
    />
    <a href={localizedPath("/publications")} class="button-secondary self-start">See all publications</a>
  </div>

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {publications.map((publication) => (
      <PublicationCard publication={publication} />
    ))}
  </div>
</section>
