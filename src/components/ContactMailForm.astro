---
const isDev = import.meta.env.DEV;
const contactEndpoint =
  import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ??
  (isDev ? "http://127.0.0.1:8787/contact" : "");
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ??
  (isDev ? "1x00000000000000000000AA" : "");
const isConfigured = Boolean(contactEndpoint && turnstileSiteKey);
---

<section class="contact-form-panel">
  <div class="contact-form-panel__intro">
    <h3>Contact form</h3>
    <p>
      Messages sent here are delivered through a protected form flow and go directly to Adam Rosiński's contact inbox.
    </p>
  </div>

  <form
    class="contact-form"
    data-contact-form
    data-contact-endpoint={contactEndpoint}
    data-form-configured={isConfigured ? "true" : "false"}
    data-turnstile-site-key={turnstileSiteKey}
  >
    <div class="contact-form__grid">
      <label>
        <span>Name</span>
        <input type="text" name="name" maxlength="120" required />
      </label>

      <label>
        <span>Your email</span>
        <input type="email" name="replyTo" maxlength="180" required />
      </label>
    </div>

    <label>
      <span>Subject</span>
      <input type="text" name="subject" maxlength="180" required />
    </label>

    <label>
      <span>Message</span>
      <textarea name="message" rows="7" maxlength="4000" required></textarea>
    </label>

    <div class="contact-form__honeypot" aria-hidden="true">
      <label>
        <span>Website</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <input type="hidden" name="startedAt" value="" />

    {turnstileSiteKey ? (
      <div class="contact-form__verification" data-contact-verification data-active="false" hidden>
        <div class="contact-form__verification-copy">
          <span class="contact-form__verification-kicker">Verification</span>
        </div>
        <div class="contact-form__turnstile">
          <div data-contact-turnstile></div>
        </div>
      </div>
    ) : (
      <p class="contact-form__status contact-form__status--error">
        Contact form verification is not configured yet.
      </p>
    )}

    <div class="contact-form__actions">
      <button type="submit" class="contact-form__submit" data-default-label="Send Message">
        Send Message
      </button>
    </div>

    <p class="contact-form__status" data-contact-form-status hidden role="status" aria-live="polite"></p>

    {!isConfigured && (
      <p class="contact-form__config-note">
        This build is missing the contact form endpoint configuration.
      </p>
    )}
  </form>
</section>

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script type="module">
  const MIN_FORM_AGE_MS = 1500;
  const forms = document.querySelectorAll("[data-contact-form]");
  const validationMessages = {
    name: "Please fill out this field.",
    replyTo: {
      valueMissing: "Please enter your email address.",
      typeMismatch: "Please enter a valid email address.",
      badInput: "Please enter a valid email address.",
    },
    subject: "Please fill out this field.",
    message: "Please fill out this field.",
  };

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") continue;
    form.dataset.bound = "true";

    const endpoint = form.dataset.contactEndpoint ?? "";
    const siteKey = form.dataset.turnstileSiteKey ?? "";
    const statusNode = form.querySelector("[data-contact-form-status]");
    const submitButton = form.querySelector(".contact-form__submit");
    const startedAtField = form.elements.namedItem("startedAt");
    const verificationNode = form.querySelector("[data-contact-verification]");
    const turnstileMount = form.querySelector("[data-contact-turnstile]");
    const controls = Array.from(form.elements).filter(
      (element) =>
        element instanceof HTMLInputElement ||
        element instanceof HTMLTextAreaElement ||
        element instanceof HTMLSelectElement,
    );

    if (
      !(statusNode instanceof HTMLElement) ||
      !(submitButton instanceof HTMLButtonElement) ||
      !(startedAtField instanceof HTMLInputElement)
    ) {
      continue;
    }

    let widgetId = null;
    let widgetRequested = false;

    const showVerification = () => {
      if (!(verificationNode instanceof HTMLElement)) return;
      verificationNode.hidden = false;
      verificationNode.dataset.active = "true";
    };

    const renderTurnstile = () => {
      if (widgetRequested || !(turnstileMount instanceof HTMLElement)) return;
      widgetRequested = true;
      showVerification();

      const attemptRender = () => {
        if (!window.turnstile || typeof window.turnstile.render !== "function") {
          window.setTimeout(attemptRender, 120);
          return;
        }

        if (turnstileMount.childElementCount > 0 || widgetId !== null) return;

        widgetId = window.turnstile.render(turnstileMount, {
          sitekey: siteKey,
          theme: "dark",
          size: "flexible",
          language: "en",
        });
      };

      attemptRender();
    };

    const applyValidationMessage = (control) => {
      if (!(control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement)) return;
      const config = validationMessages[control.name];
      if (!config) {
        control.setCustomValidity("");
        return;
      }

      if (control.validity.valueMissing) {
        const message = typeof config === "string" ? config : config.valueMissing;
        control.setCustomValidity(message ?? "Please fill out this field.");
        return;
      }

      if (typeof config === "object") {
        if (control.validity.typeMismatch) {
          control.setCustomValidity(config.typeMismatch ?? "Please enter a valid value.");
          return;
        }

        if (control.validity.badInput) {
          control.setCustomValidity(config.badInput ?? "Please enter a valid value.");
          return;
        }
      }

      control.setCustomValidity("");
    };

    for (const control of controls) {
      const syncValidationMessage = () => applyValidationMessage(control);

      if (
        (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) &&
        control.name !== "website" &&
        control.name !== "startedAt"
      ) {
        const revealVerification = () => renderTurnstile();
        control.addEventListener("focus", revealVerification, { once: true });
        control.addEventListener("input", revealVerification, { once: true });
        control.addEventListener("change", revealVerification, { once: true });
      }

      control.addEventListener("invalid", syncValidationMessage);
      control.addEventListener("input", () => control.setCustomValidity(""));
      control.addEventListener("change", () => control.setCustomValidity(""));
    }

    const defaultButtonLabel = submitButton.dataset.defaultLabel ?? submitButton.textContent?.trim() ?? "Send message";

    const setStatus = (state, message = "") => {
      form.dataset.state = state;
      statusNode.textContent = message;
      statusNode.hidden = !message;
      statusNode.className = `contact-form__status${state === "success" ? " contact-form__status--success" : ""}${state === "error" ? " contact-form__status--error" : ""}`;
    };

    const setSubmitting = (isSubmitting) => {
      form.dataset.submitting = isSubmitting ? "true" : "false";
      submitButton.disabled = isSubmitting;
      submitButton.textContent = isSubmitting ? "Sending..." : defaultButtonLabel;
    };

    const refreshStartedAt = () => {
      startedAtField.value = String(Date.now());
    };

    const resetTurnstile = () => {
      if (window.turnstile && typeof window.turnstile.reset === "function" && widgetId !== null) {
        try {
          window.turnstile.reset(widgetId);
        } catch {
          // Ignore widget reset failures; the next interaction can still re-run verification.
        }
      }
    };

    refreshStartedAt();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      renderTurnstile();

      for (const control of controls) {
        applyValidationMessage(control);
      }

      if (!form.reportValidity()) return;
      if (!endpoint) {
        setStatus("error", "The contact form is temporarily unavailable. Please try again later.");
        return;
      }

      const formData = new FormData(form);
      const website = String(formData.get("website") ?? "").trim();
      const turnstileToken = String(formData.get("cf-turnstile-response") ?? "").trim();
      const startedAt = Number.parseInt(String(formData.get("startedAt") ?? "0"), 10);

      if (website.length > 0) {
        setStatus("error", "The message could not be verified. Please refresh and try again.");
        resetTurnstile();
        refreshStartedAt();
        return;
      }

      if (!Number.isFinite(startedAt) || Date.now() - startedAt < MIN_FORM_AGE_MS) {
        setStatus("error", "Please wait a moment and submit the form again.");
        resetTurnstile();
        refreshStartedAt();
        return;
      }

      if (!turnstileToken) {
        showVerification();
        setStatus("error", "Please complete the verification step before sending your message.");
        return;
      }

      const payload = {
        name: String(formData.get("name") ?? "").trim(),
        replyTo: String(formData.get("replyTo") ?? "").trim(),
        subject: String(formData.get("subject") ?? "").trim(),
        message: String(formData.get("message") ?? "").trim(),
        turnstileToken,
        website,
      };

      setStatus("idle");
      setSubmitting(true);

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          setStatus("error", result?.message ?? "The message could not be sent right now. Please try again later.");
          resetTurnstile();
          refreshStartedAt();
          return;
        }

        form.reset();
        refreshStartedAt();
        resetTurnstile();
        setStatus("success", result.message ?? "Your message has been sent.");
      } catch {
        setStatus("error", "The message could not be sent right now. Please try again later.");
        resetTurnstile();
        refreshStartedAt();
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>

<style>
  .contact-form-panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .contact-form-panel__intro h3 {
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .contact-form-panel__intro p {
    margin-top: 0.9rem;
    color: #a1a1aa;
    line-height: 1.75;
  }

  .contact-form {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .contact-form[data-submitting="true"] {
    pointer-events: none;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.55rem;
  }

  .contact-form label span {
    color: #dbe4ef;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(5, 7, 11, 0.5);
    padding: 0.95rem 1rem;
    color: #fff;
    outline: none;
    transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    border-color: rgba(86, 216, 255, 0.52);
    box-shadow: 0 0 0 3px rgba(86, 216, 255, 0.12);
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 11rem;
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .contact-form__verification {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgba(10, 12, 17, 0.52), rgba(7, 9, 13, 0.34)),
      radial-gradient(circle at top right, rgba(86, 216, 255, 0.08), transparent 42%);
    padding: 0.9rem 0.9rem 0.95rem;
  }

  .contact-form__verification-copy {
    display: grid;
    gap: 0.3rem;
  }

  .contact-form__verification-kicker {
    color: #56d8ff;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-form__turnstile {
    min-height: 4.8rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.015);
    padding: 0.1rem;
  }

  .contact-form__actions {
    display: flex;
    justify-content: center;
  }

  .contact-form__submit {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #05070b;
    padding: 0.9rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .contact-form__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .contact-form__submit:hover {
    transform: translateY(-1px);
  }

  .contact-form__status,
  .contact-form__config-note {
    margin: 0;
    line-height: 1.7;
  }

  .contact-form__status {
    color: #cbd5e1;
  }

  .contact-form__status--success {
    color: #9ae6b4;
  }

  .contact-form__status--error,
  .contact-form__config-note {
    color: #fda4af;
  }

  @media (max-width: 720px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
