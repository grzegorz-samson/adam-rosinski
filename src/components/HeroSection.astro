---
import { site } from "../data/site";
---
<section class="shell relative min-h-[92vh] py-14 md:py-24">
  <div class="glass-panel relative overflow-hidden px-6 py-10 md:px-10 md:py-14">
    <div class="hero-orb" aria-hidden="true"></div>

    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="relative z-10 max-w-3xl">
        <p class="eyebrow">sound · perception · space · technology</p>
        <h1 class="mt-5 text-5xl font-semibold leading-none tracking-tight text-balance text-white md:text-7xl">
          {site.name}
        </h1>
        <p class="mt-4 max-w-2xl text-lg font-medium text-zinc-200 md:text-2xl">
          {site.role}
        </p>
        <p class="muted mt-6 max-w-2xl text-base leading-8 md:text-lg">
          {site.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#research" class="button-primary">Poznaj badania</a>
          <a href="#publications" class="button-secondary">Zobacz publikacje</a>
          <a href="#contact" class="button-secondary">Nawiąż kontakt</a>
        </div>

        <dl class="mt-12 grid gap-6 border-t border-white/10 pt-8 md:grid-cols-3">
          <div>
            <dt class="text-xs uppercase tracking-[0.2em] text-zinc-500">Focus</dt>
            <dd class="mt-2 text-sm leading-6 text-zinc-200">Auditory scene analysis, percepcja i przestrzeń dźwięku.</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.2em] text-zinc-500">Practice</dt>
            <dd class="mt-2 text-sm leading-6 text-zinc-200">Studio recording, techniki mikrofonowe, wielokanałowość.</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.2em] text-zinc-500">Context</dt>
            <dd class="mt-2 text-sm leading-6 text-zinc-200">{site.institution}</dd>
          </div>
        </dl>
      </div>

      <div class="relative min-h-[26rem]">
        <div class="absolute inset-0 rounded-[2rem] border border-white/10 bg-white/[0.03]"></div>
        <svg
          viewBox="0 0 600 600"
          class="relative h-full w-full overflow-visible rounded-[2rem]"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="signalA" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="rgba(103,232,249,0.9)" />
              <stop offset="100%" stop-color="rgba(255,255,255,0.2)" />
            </linearGradient>
            <linearGradient id="signalB" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="rgba(251,191,36,0.85)" />
              <stop offset="100%" stop-color="rgba(255,255,255,0.12)" />
            </linearGradient>
          </defs>

          <g opacity="0.6">
            <path d="M40 310 C 120 210, 180 180, 240 240 S 360 380, 560 190" fill="none" stroke="url(#signalA)" stroke-width="2" />
            <path d="M30 390 C 120 360, 180 320, 260 330 S 380 350, 550 460" fill="none" stroke="url(#signalB)" stroke-width="2" />
            <path d="M70 160 C 180 180, 220 120, 310 180 S 430 260, 530 250" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5" />
          </g>

          <g fill="white">
            <circle cx="110" cy="240" r="6" fill="rgba(103,232,249,0.9)" />
            <circle cx="220" cy="210" r="5" fill="rgba(255,255,255,0.75)" />
            <circle cx="315" cy="275" r="7" fill="rgba(251,191,36,0.95)" />
            <circle cx="410" cy="330" r="5" fill="rgba(255,255,255,0.75)" />
            <circle cx="500" cy="240" r="8" fill="rgba(103,232,249,0.9)" />
            <circle cx="490" cy="430" r="6" fill="rgba(110,231,183,0.9)" />
            <circle cx="215" cy="385" r="6" fill="rgba(255,255,255,0.72)" />
          </g>

          <g opacity="0.18" stroke="white">
            <circle cx="315" cy="275" r="100" fill="none" />
            <circle cx="315" cy="275" r="165" fill="none" />
            <circle cx="315" cy="275" r="230" fill="none" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>
