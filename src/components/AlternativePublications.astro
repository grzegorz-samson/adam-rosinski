---
import BookOpen from "@lucide/astro/icons/book-open";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import Tags from "@lucide/astro/icons/tags";
import { getPublicationMetaLabel, type PublicationCategory } from "../data/publicationTaxonomy";
import { withBase } from "../utils/withBase";

interface Entry {
  slug: string;
  title: string;
  year: number;
  category: PublicationCategory;
  type: string;
  language: string;
  summary: string;
  tags: string[];
  relatedAreas: string[];
  href: string;
  publisher?: string;
  journal?: string;
  volume?: string;
  issue?: string;
  pages?: string;
  doi?: string;
  isbn?: string;
  cover?: string | null;
  sourceVerified?: boolean;
}

interface Props {
  publications: Entry[];
  kicker?: string;
  title?: string;
  description?: string;
}

const {
  publications,
  kicker = "Publications and books",
  title = "Selected publications",
  description = "A compact shelf of publications connecting auditory perception, recording, spatial listening, and audio-tool design.",
} = Astro.props;

const bookThemes: Record<string, { accent: string; accent2: string; glow: string }> = {
  "melody-and-rhythm-auditory-percepts": {
    accent: "#9b7cff",
    accent2: "#33104a",
    glow: "76% 16%",
  },
  "microphone-techniques-in-stereo-and-surround-recording": {
    accent: "#df4a3d",
    accent2: "#b31e22",
    glow: "80% 18%",
  },
  "psychoacoustic-contexts-of-auditory-stream-formation-in-music": {
    accent: "#d9c7a0",
    accent2: "#f3ebd3",
    glow: "74% 16%",
  },
  "computer-technology-in-music-recording-and-production": {
    accent: "#ff8d1f",
    accent2: "#231f1e",
    glow: "80% 20%",
  },
};

function getBookTheme(slug: string) {
  return (
    bookThemes[slug] ?? {
      accent: "#56d8ff",
      accent2: "#8b7cff",
      glow: "78% 18%",
    }
  );
}
---

<section id="selected-publications" class="alt-section">
  <div class="alt-heading">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="alt-grid">
    {publications.map((publication) => {
      const coverSrc = publication.cover
        ? withBase(publication.cover)
        : withBase("/images/covers/microphone-techniques.jpg");
      const cover = {
        src: coverSrc,
        alt: `Cover for ${publication.title}`,
        label: getPublicationMetaLabel(publication.category, publication.type),
      };
      const sourceLine = publication.publisher ?? publication.journal ?? publication.doi ?? publication.isbn;
      const theme = getBookTheme(publication.slug);
      const themeStyle = [
        `--book-accent: ${theme.accent}`,
        `--book-accent-2: ${theme.accent2}`,
        `--book-glow-position: ${theme.glow}`,
      ].join("; ");

      return (
        <details class="alt-publication-card" style={themeStyle}>
          <summary class="alt-publication-summary">
            <div class="alt-cover-link">
              <div class="alt-cover-frame">
                <img src={cover.src} alt={cover.alt} class="alt-cover-image" loading="lazy" />
              </div>
            </div>

            <div class="alt-publication-copy">
              <div class="alt-meta">
                <span>
                  <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                  {publication.year}
                </span>
                <span>{cover.label}</span>
              </div>
              <h3>{publication.title}</h3>
            </div>

            <ChevronDown size={18} stroke-width={1.9} aria-hidden="true" class="alt-book-chevron" />
          </summary>

          <div class="alt-publication-expanded">
            <p>{publication.summary}</p>
            <div class="alt-publication-notes">
              <span>{publication.language}</span>
              {publication.pages && <span>{publication.pages} pp.</span>}
            </div>
            {sourceLine && (
              <div class="alt-detail-block">
                <p class="alt-detail-label">
                  <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                  Bibliographic details
                </p>
                <p class="alt-source-line">{sourceLine}</p>
              </div>
            )}
            <div class="alt-detail-block">
              <p class="alt-detail-label">
                <Tags size={13} stroke-width={1.8} aria-hidden="true" />
                Keywords
              </p>
              <div class="alt-tag-row">
                {publication.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
            <a href={publication.href} target="_blank" rel="noreferrer" class="alt-publication-link alt-link-with-icon">
              <span>{publication.sourceVerified === false ? "Open source page" : "Open publication"}</span>
              <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>
        </details>
      );
    })}
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const booksGrid = document.querySelector("#selected-publications .alt-grid");
  const bookCards = booksGrid ? Array.from(booksGrid.querySelectorAll(".alt-publication-card")) : [];
  const activeAnimations = new WeakSet();

  function getColumnCount() {
    if (window.innerWidth <= 720) return 1;
    if (window.innerWidth <= 1080) return 2;
    return 4;
  }

  function shouldStageJump(card) {
    if (!(card instanceof HTMLDetailsElement) || card.open) {
      return false;
    }

    if (!booksGrid) {
      return false;
    }

    const columns = getColumnCount();
    if (columns <= 1) {
      return false;
    }

    const styles = getComputedStyle(booksGrid);
    const gap = Number.parseFloat(styles.columnGap || styles.gap || "16") || 16;
    const gridRect = booksGrid.getBoundingClientRect();
    const cardRect = card.getBoundingClientRect();
    const columnWidth = (gridRect.width - gap * (columns - 1)) / columns;
    const relativeLeft = cardRect.left - gridRect.left;
    const currentColumn = Math.round(relativeLeft / (columnWidth + gap)) + 1;
    const requiredSpan = 2;

    return currentColumn + requiredSpan - 1 > columns;
  }

  function getStageColumnStart() {
    if (window.innerWidth <= 720) return "auto";
    return "1";
  }

  function getExpandedWidth() {
    if (!booksGrid) {
      return null;
    }

    const columns = getColumnCount();
    if (columns <= 1) {
      return null;
    }

    const styles = getComputedStyle(booksGrid);
    const gap = Number.parseFloat(styles.columnGap || styles.gap || "16") || 16;
    const gridWidth = booksGrid.getBoundingClientRect().width;
    const columnWidth = (gridWidth - gap * (columns - 1)) / columns;

    return 2 * columnWidth + gap;
  }

  function wait(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function animateCardReveal(card, collapsedWidth, expandedWidth) {
    const hiddenRight = Math.max(expandedWidth - collapsedWidth, 0);
    const startClip = `inset(0 ${hiddenRight}px 0 0)`;
    const endClip = "inset(0 0px 0 0)";

    card.style.clipPath = startClip;
    card.getBoundingClientRect();

    if (prefersReducedMotion.matches) {
      card.style.clipPath = endClip;
      return;
    }

    const animation = card.animate(
      [
        { clipPath: startClip },
        { clipPath: endClip },
      ],
      {
        duration: 360,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      },
    );

    card.style.clipPath = endClip;

    try {
      await animation.finished;
    } catch {}
  }

  function toggleBooksLayout(changedCard) {
    changedCard.open = !changedCard.open;
  }

  function animateBooksLayout(mutateLayout) {
    if (prefersReducedMotion.matches || !booksGrid || bookCards.length === 0) {
      mutateLayout();
      return Promise.resolve();
    }

    const first = new Map(bookCards.map((card) => [card, card.getBoundingClientRect()]));
    mutateLayout();

    return new Promise((resolve) => {
      requestAnimationFrame(() => {
        const last = new Map(bookCards.map((card) => [card, card.getBoundingClientRect()]));
        const animations = [];

        for (const card of bookCards) {
          const from = first.get(card);
          const to = last.get(card);

          if (!from || !to) {
            continue;
          }

          const deltaX = from.left - to.left;
          const deltaY = from.top - to.top;

          if (
            Math.abs(deltaX) < 0.5 &&
            Math.abs(deltaY) < 0.5
          ) {
            continue;
          }

          animations.push(
            card.animate(
              [
                {
                  transform: `translate(${deltaX}px, ${deltaY}px)`,
                },
                {
                  transform: "translate(0, 0)",
                },
              ],
              {
                duration: 360,
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              },
            ).finished.catch(() => {})
          );
        }

        Promise.all(animations).finally(resolve);
      });
    });
  }

  for (const card of bookCards) {
    const summary = card.querySelector(".alt-publication-summary");

    if (!(card instanceof HTMLDetailsElement) || !(summary instanceof HTMLElement)) {
      continue;
    }

    summary.addEventListener("click", async (event) => {
      event.preventDefault();

      if (activeAnimations.has(card)) {
        return;
      }

      activeAnimations.add(card);

      try {
        if (shouldStageJump(card)) {
          const collapsedWidth = card.getBoundingClientRect().width;

          await animateBooksLayout(() => {
            card.style.setProperty("--stage-column-start", getStageColumnStart());
            card.classList.add("is-staging-open");
          });

          const expandedWidth = getExpandedWidth();

          card.classList.remove("is-staging-open");
          card.classList.add("is-expanding-open");
          card.style.removeProperty("--stage-column-start");

          if (expandedWidth) {
            await animateCardReveal(card, collapsedWidth, expandedWidth);
          } else {
            await wait(360);
          }

          card.open = true;
          card.classList.remove("is-expanding-open");
          card.style.removeProperty("clip-path");
          return;
        }

        await animateBooksLayout(() => {
          toggleBooksLayout(card);
        });
      } finally {
        setTimeout(() => activeAnimations.delete(card), 760);
      }
    });
  }
</script>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .alt-meta {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-heading h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-heading p:last-child,
  .alt-publication-card p {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-publication-card {
    position: relative;
    display: grid;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background:
      radial-gradient(circle at var(--book-glow-position), color-mix(in srgb, var(--book-accent) 30%, transparent), transparent 24%),
      linear-gradient(180deg, color-mix(in srgb, var(--book-accent-2) 12%, rgba(255, 255, 255, 0.04)), rgba(255, 255, 255, 0.03));
    padding: 1.25rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
    overflow: hidden;
    min-height: 100%;
    transform-origin: top left;
    will-change: transform, clip-path;
  }

  .alt-publication-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 10, 17, 0.14), rgba(7, 10, 17, 0.32));
    pointer-events: none;
  }

  .alt-publication-card:hover,
  .alt-publication-card[open],
  .alt-publication-card.is-staging-open,
  .alt-publication-card.is-expanding-open {
    border-color: color-mix(in srgb, var(--book-accent) 34%, rgba(255, 255, 255, 0.16));
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.38);
  }

  .alt-publication-summary {
    z-index: 1;
    display: grid;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .alt-publication-summary::-webkit-details-marker {
    display: none;
  }

  .alt-cover-link {
    display: block;
  }

  .alt-cover-frame {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    aspect-ratio: 4 / 5;
    background: #0a0d14;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .alt-cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .alt-publication-card:hover .alt-cover-image,
  .alt-publication-card[open] .alt-cover-image,
  .alt-publication-card.is-staging-open .alt-cover-image,
  .alt-publication-card.is-expanding-open .alt-cover-image {
    transform: scale(1.06);
  }

  .alt-publication-copy {
    min-width: 0;
  }

  .alt-publication-card h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
    text-wrap: pretty;
  }

  .alt-book-chevron {
    position: absolute;
    right: 0.7rem;
    bottom: 0.65rem;
    color: #d4d4d8;
    transform: rotate(-90deg);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }

  .alt-publication-card[open] .alt-book-chevron,
  .alt-publication-card.is-staging-open .alt-book-chevron,
  .alt-publication-card.is-expanding-open .alt-book-chevron {
    transform: rotate(90deg);
  }

  .alt-publication-copy,
  .alt-publication-expanded {
    position: relative;
    z-index: 1;
  }

  .alt-publication-copy {
    margin-top: 1rem;
  }

  .alt-publication-expanded {
    display: grid;
    gap: 0.95rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-18px);
    transition:
      max-height 360ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      padding-top 360ms cubic-bezier(0.22, 1, 0.36, 1);
    padding-top: 0;
  }

  .alt-publication-card[open]:not(.is-expanding-open) .alt-publication-expanded {
    align-content: start;
    max-height: 40rem;
    opacity: 1;
    transform: translateX(0);
    padding-top: 0.25rem;
  }

  .alt-publication-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.85rem;
    color: #8d92a6;
    font-size: 0.84rem;
  }

  .alt-source-line {
    margin-top: 0;
    color: #d4d4d8;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .alt-publication-link {
    display: inline-block;
    margin-top: 1rem;
    color: #56d8ff;
    text-decoration: none;
  }

  .alt-publication-link:hover {
    color: #fff;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .alt-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #71717a;
  }

  .alt-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .alt-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .alt-tag-row span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: #a1a1aa;
    font-size: 0.82rem;
    line-height: 1;
  }

  .alt-detail-block {
    display: grid;
    gap: 0.55rem;
  }

  .alt-detail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    margin: 0;
    color: color-mix(in srgb, var(--book-accent) 82%, white);
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .alt-publication-card[open],
    .alt-publication-card.is-expanding-open {
      grid-column: span 2;
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 1.15rem;
      align-items: start;
    }

    .alt-publication-card.is-staging-open {
      grid-column: var(--stage-column-start, 1);
      grid-template-columns: 1fr;
      gap: 0;
      align-items: start;
    }

  .alt-publication-card.is-expanding-open {
      justify-self: start;
    }

    .alt-publication-card.is-expanding-open .alt-publication-expanded {
      grid-column: 2;
      grid-row: 1;
      max-height: 0;
      opacity: 0;
      transform: translateX(-18px);
      padding-top: 0;
    }

    .alt-publication-card[open] .alt-publication-summary,
    .alt-publication-card.is-staging-open .alt-publication-summary,
    .alt-publication-card.is-expanding-open .alt-publication-summary {
      align-self: stretch;
    }

    .alt-publication-card[open]:not(.is-expanding-open) .alt-publication-expanded {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 720px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }

    .alt-publication-card[open],
    .alt-publication-card.is-staging-open,
    .alt-publication-card.is-expanding-open {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .alt-publication-card[open]:not(.is-expanding-open) .alt-publication-expanded {
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (min-width: 1081px) {
    .alt-publication-card[open],
    .alt-publication-card.is-expanding-open {
      grid-column: span 2;
      grid-template-columns: 17.5rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }

    .alt-publication-card.is-staging-open {
      grid-column: var(--stage-column-start, 1);
      grid-template-columns: 1fr;
      gap: 0;
      align-items: start;
    }

    .alt-publication-card.is-expanding-open {
      justify-self: start;
    }

    .alt-publication-card.is-expanding-open .alt-publication-expanded {
      grid-column: 2;
      grid-row: 1;
      max-height: 0;
      opacity: 0;
      transform: translateX(-18px);
      padding-top: 0;
    }

    .alt-publication-card[open]:not(.is-expanding-open) .alt-publication-expanded {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alt-publication-card,
    .alt-publication-expanded,
    .alt-book-chevron,
    .alt-cover-image {
      transition: none;
    }
  }
</style>
