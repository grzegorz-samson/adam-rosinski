---
import BookOpen from "@lucide/astro/icons/book-open";
import ExternalLink from "@lucide/astro/icons/external-link";
import { getPublicationMetaLabel, type PublicationCategory } from "../data/publicationTaxonomy";
import { withBase } from "../utils/withBase";

interface Entry {
  title: string;
  year: number;
  category: PublicationCategory;
  type: string;
  language: string;
  summary: string;
  tags: string[];
  relatedAreas: string[];
  href: string;
  publisher?: string;
  journal?: string;
  volume?: string;
  issue?: string;
  pages?: string;
  doi?: string;
  isbn?: string;
  cover?: string | null;
  sourceVerified?: boolean;
}

interface Props {
  publications: Entry[];
  kicker?: string;
  title?: string;
  description?: string;
}

const {
  publications,
  kicker = "Publications and books",
  title = "Selected publications",
  description = "A compact shelf of publications connecting auditory perception, recording, spatial listening, and audio-tool design.",
} = Astro.props;
---

<section id="publications-alt" class="alt-section">
  <div class="alt-heading">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="alt-grid">
    {publications.map((publication) => {
      const coverSrc = publication.cover
        ? withBase(publication.cover)
        : withBase("/images/covers/microphone-techniques.jpg");
      const cover = {
        src: coverSrc,
        alt: `Cover for ${publication.title}`,
        label: getPublicationMetaLabel(publication.category, publication.type),
      };
      const sourceLine = publication.publisher ?? publication.journal ?? publication.doi ?? publication.isbn;

      return (
        <article class="alt-publication-card">
          <a href={publication.href} target="_blank" rel="noreferrer" class="alt-cover-link">
            <div class="alt-cover-frame">
              <img src={cover.src} alt={cover.alt} class="alt-cover-image" loading="lazy" />
            </div>
          </a>

          <div class="alt-publication-copy">
            <div class="alt-meta">
              <span>
                <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                {publication.year}
              </span>
              <span>{cover.label}</span>
            </div>
            <h3>{publication.title}</h3>
            <p>{publication.summary}</p>
            <div class="alt-publication-notes">
              <span>{publication.language}</span>
              {publication.pages && <span>{publication.pages} pp.</span>}
            </div>
            {sourceLine && <p class="alt-source-line">{sourceLine}</p>}
            <div class="alt-tag-row">
              {publication.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <a href={publication.href} target="_blank" rel="noreferrer" class="alt-publication-link alt-link-with-icon">
              <span>{publication.sourceVerified === false ? "View source page" : "View publication"}</span>
              <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .alt-meta {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-heading h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-heading p:last-child,
  .alt-publication-card p {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-publication-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.25rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .alt-publication-card:hover {
    transform: translateY(-4px);
    border-color: rgba(86, 216, 255, 0.22);
    background: rgba(255, 255, 255, 0.055);
  }

  .alt-cover-link {
    display: block;
    text-decoration: none;
  }

  .alt-cover-frame {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    aspect-ratio: 4 / 5;
    background: #0a0d14;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .alt-cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .alt-publication-card:hover .alt-cover-image,
  .alt-cover-link:hover .alt-cover-image {
    transform: scale(1.06);
  }

  .alt-publication-copy {
    margin-top: 1rem;
  }

  .alt-publication-card h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-publication-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.85rem;
    color: #8d92a6;
    font-size: 0.84rem;
  }

  .alt-source-line {
    margin-top: 0.65rem;
    color: #d4d4d8;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .alt-publication-link {
    display: inline-block;
    margin-top: 1rem;
    color: #56d8ff;
    text-decoration: none;
  }

  .alt-publication-link:hover {
    color: #fff;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .alt-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #71717a;
  }

  .alt-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .alt-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .alt-tag-row span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: #a1a1aa;
    font-size: 0.82rem;
    line-height: 1;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
