---
import BookOpen from "@lucide/astro/icons/book-open";
import ExternalLink from "@lucide/astro/icons/external-link";
import { withBase } from "../utils/withBase";

interface Entry {
  data: {
    title: string;
    year: number;
    summary: string;
    tags: string[];
    href: string;
  };
}

interface Props {
  publications: Entry[];
}

const { publications } = Astro.props;
const publicationCovers: Record<string, { src: string; alt: string; label: string }> = {
  "Microphone Techniques in Stereo and Surround Recording": {
    src: withBase("/images/covers/microphone-techniques.jpg"),
    alt: "Cover of Microphone Techniques in Stereo and Surround Recording",
    label: "Monograph",
  },
  "Multivariantism of Auditory Perceptions as a Significant Element of the Auditory Scene Analysis Concept": {
    src: withBase("/images/covers/multivariantism.jpg"),
    alt: "Cover of Multivariantism of Auditory Perceptions as a Significant Element of the Auditory Scene Analysis Concept",
    label: "Article",
  },
  "Variable Properties of Auditory Scene Analysis in Music": {
    src: withBase("/images/covers/variable-properties.jpg"),
    alt: "Cover of Variable Properties of Auditory Scene Analysis in Music",
    label: "Article",
  },
  "A spherical microphone prototype for multichannel recording": {
    src: withBase("/images/covers/spherical-microphone.jpg"),
    alt: "Cover of A spherical microphone prototype for multichannel recording",
    label: "Article",
  },
};
---

<section id="publications-alt" class="alt-section">
  <div class="alt-heading">
    <p class="alt-kicker">Publications and books</p>
    <h2>Selected publications</h2>
    <p>
      Auditory perception, auditory-scene analysis, microphone techniques, and audio-tool design come together here
      as one coherent body of topics developed in publication and practice.
    </p>
  </div>

  <div class="alt-grid">
    {publications.map((publication) => {
      const cover = publicationCovers[publication.data.title] ?? {
        src: withBase("/images/covers/microphone-techniques.jpg"),
        alt: `Cover for ${publication.data.title}`,
        label: "Publication",
      };

      return (
        <article class="alt-publication-card">
          <a href={publication.data.href} target="_blank" rel="noreferrer" class="alt-cover-link">
            <div class="alt-cover-frame">
              <img src={cover.src} alt={cover.alt} class="alt-cover-image" loading="lazy" />
            </div>
          </a>

          <div class="alt-publication-copy">
            <div class="alt-meta">
              <span>
                <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                {publication.data.year}
              </span>
              <span>{cover.label}</span>
            </div>
            <h3>{publication.data.title}</h3>
            <p>{publication.data.summary}</p>
            <div class="alt-tag-row">
              {publication.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <a href={publication.data.href} target="_blank" rel="noreferrer" class="alt-publication-link alt-link-with-icon">
              <span>Open source</span>
              <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-heading {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .alt-kicker,
  .alt-meta {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-kicker {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #56d8ff;
  }

  .alt-heading h2 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-heading p:last-child,
  .alt-publication-card p {
    margin-top: 1rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-publication-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.25rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .alt-publication-card:hover {
    transform: translateY(-4px);
    border-color: rgba(86, 216, 255, 0.22);
    background: rgba(255, 255, 255, 0.055);
  }

  .alt-cover-link {
    display: block;
    text-decoration: none;
  }

  .alt-cover-frame {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    aspect-ratio: 4 / 5;
    background: #0a0d14;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .alt-cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .alt-publication-card:hover .alt-cover-image,
  .alt-cover-link:hover .alt-cover-image {
    transform: scale(1.06);
  }

  .alt-publication-copy {
    margin-top: 1rem;
  }

  .alt-publication-card h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-publication-link {
    display: inline-block;
    margin-top: 1rem;
    color: #56d8ff;
    text-decoration: none;
  }

  .alt-publication-link:hover {
    color: #fff;
  }

  .alt-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .alt-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #71717a;
  }

  .alt-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .alt-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .alt-tag-row span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: #a1a1aa;
    font-size: 0.82rem;
    line-height: 1;
  }

  @media (max-width: 1080px) {
    .alt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .alt-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
