---
const modes = [
  {
    key: "perception",
    title: "Perception",
    intro:
      "Dźwięk nie pojawia się dla słuchacza jako neutralny strumień danych. Jest organizowany, grupowany i rozdzielany w dynamiczne struktury percepcyjne.",
    accent: "cyan",
  },
  {
    key: "recording",
    title: "Recording",
    intro:
      "Rejestracja projektuje punkt słyszenia, kierunek uwagi i relacje między źródłem a przestrzenią. Mikrofon staje się narzędziem interpretacji.",
    accent: "amber",
  },
  {
    key: "space",
    title: "Space",
    intro:
      "Przestrzeń akustyczna działa jednocześnie jako właściwość fizyczna i jako doświadczenie. Może być odwzorowywana, interpretowana albo komponowana.",
    accent: "emerald",
  },
  {
    key: "education",
    title: "Education",
    intro:
      "Nowe technologie audio współtworzą współczesne środowisko dydaktyczne: laboratorium, studio i narzędzie myślenia o muzyce.",
    accent: "neutral",
  },
];
---

<section id="auditory-field" class="shell section-space">
  <div class="glass-panel overflow-hidden p-6 md:p-8 lg:p-10">
    <div class="grid gap-8 lg:grid-cols-[0.4fr_0.6fr] lg:items-center">
      <div>
        <p class="eyebrow">auditory field</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-5xl">
          Jedna sekcja, która wizualnie tłumaczy obszary pracy.
        </h2>
        <p class="muted mt-5 max-w-xl text-base leading-8">
          To celowo lekki, interpretacyjny moduł. W kolejnych iteracjach możesz rozwinąć go do bardziej zaawansowanej wizualizacji SVG albo Canvas.
        </p>

        <div class="mt-8 space-y-3" data-mode-buttons>
          {modes.map((mode, index) => (
            <button
              type="button"
              class={`mode-button flex w-full items-start gap-3 rounded-2xl border px-4 py-4 text-left transition ${
                index === 0
                  ? "border-cyan-300/30 bg-cyan-300/10"
                  : "border-white/10 bg-white/[0.05] hover:bg-white/[0.08]"
              }`}
              data-mode={mode.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span
                class={`mode-dot mt-1 ${
                  mode.accent === "cyan"
                    ? "bg-cyan-300"
                    : mode.accent === "amber"
                      ? "bg-amber-300"
                      : mode.accent === "emerald"
                        ? "bg-emerald-300"
                        : "bg-white/60"
                }`}
              ></span>
              <span>
                <span class="block text-sm font-medium uppercase tracking-[0.2em] text-zinc-400">{mode.title}</span>
                <span class="mt-1 block text-sm leading-6 text-zinc-200">{mode.intro}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="soft-card relative min-h-[28rem] overflow-hidden p-4 md:p-6">
        <svg viewBox="0 0 700 520" class="h-full w-full" aria-hidden="true" data-auditory-svg>
          <g opacity="0.12" stroke="white">
            <circle cx="350" cy="260" r="70"></circle>
            <circle cx="350" cy="260" r="145"></circle>
            <circle cx="350" cy="260" r="220"></circle>
          </g>

          <g data-group="perception">
            <path class="audio-field-line" d="M90 150 C 180 220, 240 180, 350 260 S 520 330, 615 205" fill="none" stroke="rgba(103,232,249,0.92)" stroke-width="3"></path>
            <path class="audio-field-line" d="M110 355 C 195 305, 255 325, 350 260 S 505 225, 585 330" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2"></path>
            <circle class="audio-field-node" cx="95" cy="150" r="8" fill="rgba(103,232,249,0.95)"></circle>
            <circle class="audio-field-node" cx="220" cy="196" r="7" fill="rgba(255,255,255,0.82)"></circle>
            <circle class="audio-field-node" cx="350" cy="260" r="10" fill="rgba(251,191,36,0.95)"></circle>
            <circle class="audio-field-node" cx="485" cy="288" r="7" fill="rgba(255,255,255,0.82)"></circle>
            <circle class="audio-field-node" cx="610" cy="205" r="8" fill="rgba(103,232,249,0.95)"></circle>
          </g>

          <g data-group="recording" opacity="0.22">
            <path class="audio-field-line" d="M145 260 L 560 260" fill="none" stroke="rgba(251,191,36,0.92)" stroke-width="3"></path>
            <path class="audio-field-line" d="M350 80 L 350 440" fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2"></path>
            <path class="audio-field-line" d="M220 130 L 480 390" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="2"></path>
            <path class="audio-field-line" d="M220 390 L 480 130" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="2"></path>
            <circle class="audio-field-node" cx="350" cy="260" r="14" fill="rgba(251,191,36,0.95)"></circle>
            <circle class="audio-field-node" cx="350" cy="150" r="7" fill="rgba(255,255,255,0.82)"></circle>
            <circle class="audio-field-node" cx="455" cy="260" r="7" fill="rgba(255,255,255,0.82)"></circle>
            <circle class="audio-field-node" cx="350" cy="370" r="7" fill="rgba(255,255,255,0.82)"></circle>
            <circle class="audio-field-node" cx="245" cy="260" r="7" fill="rgba(255,255,255,0.82)"></circle>
          </g>

          <g data-group="space" opacity="0.22">
            <circle class="audio-field-node" cx="350" cy="260" r="18" fill="rgba(110,231,183,0.92)"></circle>
            <circle class="audio-field-node" cx="350" cy="95" r="7" fill="rgba(255,255,255,0.85)"></circle>
            <circle class="audio-field-node" cx="520" cy="260" r="7" fill="rgba(255,255,255,0.85)"></circle>
            <circle class="audio-field-node" cx="350" cy="425" r="7" fill="rgba(255,255,255,0.85)"></circle>
            <circle class="audio-field-node" cx="180" cy="260" r="7" fill="rgba(255,255,255,0.85)"></circle>
            <path class="audio-field-line" d="M350 95 Q 450 160, 520 260 Q 445 350, 350 425 Q 250 350, 180 260 Q 245 160, 350 95Z" fill="none" stroke="rgba(110,231,183,0.78)" stroke-width="3"></path>
          </g>

          <g data-group="education" opacity="0.22">
            <rect x="175" y="135" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <rect x="300" y="135" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <rect x="425" y="135" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <rect x="175" y="300" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <rect x="300" y="300" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <rect x="425" y="300" width="110" height="82" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)"></rect>
            <path class="audio-field-line" d="M285 176 L 300 176" fill="none" stroke="rgba(255,255,255,0.24)" stroke-width="2"></path>
            <path class="audio-field-line" d="M410 176 L 425 176" fill="none" stroke="rgba(255,255,255,0.24)" stroke-width="2"></path>
            <path class="audio-field-line" d="M355 217 L 355 300" fill="none" stroke="rgba(255,255,255,0.24)" stroke-width="2"></path>
            <circle class="audio-field-node" cx="355" cy="260" r="9" fill="rgba(255,255,255,0.85)"></circle>
          </g>
        </svg>

        <div class="absolute inset-x-4 bottom-4 rounded-2xl border border-white/10 bg-slate-950/70 p-4 backdrop-blur-xl md:inset-x-6 md:bottom-6 md:p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">active mode</p>
          <h3 class="mt-2 text-xl font-semibold text-white" data-active-title>Perception</h3>
          <p class="muted mt-2 text-sm leading-7" data-active-copy>
            Dźwięk nie pojawia się dla słuchacza jako neutralny strumień danych. Jest organizowany, grupowany i rozdzielany w dynamiczne struktury percepcyjne.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ modes }}>
  const buttons = Array.from(document.querySelectorAll(".mode-button"));
  const svgGroups = Array.from(document.querySelectorAll("[data-group]"));
  const titleEl = document.querySelector("[data-active-title]");
  const copyEl = document.querySelector("[data-active-copy]");

  const modesMap = Object.fromEntries(modes.map((mode) => [mode.key, mode]));

  const setMode = (key) => {
    buttons.forEach((button) => {
      const active = button.dataset.mode === key;
      button.setAttribute("aria-pressed", active ? "true" : "false");
      button.classList.toggle("border-cyan-300/30", active);
      button.classList.toggle("bg-cyan-300/10", active);
      button.classList.toggle("border-white/10", !active);
      button.classList.toggle("bg-white/[0.05]", !active);
    });

    svgGroups.forEach((group) => {
      const active = group.getAttribute("data-group") === key;
      group.setAttribute("opacity", active ? "1" : "0.16");
    });

    const mode = modesMap[key];
    if (titleEl && copyEl && mode) {
      titleEl.textContent = mode.title;
      copyEl.textContent = mode.intro;
    }
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => setMode(button.dataset.mode));
  });

  setMode("perception");
</script>
