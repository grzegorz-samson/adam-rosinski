---
import { getContent } from "../data/content";
import { localizedPath, stripLocale } from "../utils/i18n";

const content = getContent("en");
const currentPath = stripLocale(Astro.url.pathname);

function isActive(href: string): boolean {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="site-shell site-header-inner">
    <a href={localizedPath("/")} class="site-wordmark">
      <span>{content.site.displayName}</span>
      <small>research / audio / practice</small>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {content.navigation.map((item) => (
        <a
          href={localizedPath(item.href)}
          class:list={["site-nav-link", isActive(item.href) && "is-active"]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header-actions">
      <a href={localizedPath("/pl", "en")} class="site-header-secondary">PL soon</a>
      <a href={localizedPath("/alternative")} class="site-header-secondary">Classic</a>
      <a href={localizedPath("/contact")} class="site-button-primary">Collaborate</a>
    </div>
  </div>
</header>
