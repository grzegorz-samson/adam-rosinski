---
import { navigation, site } from "../data/site";
import { withBase } from "../utils/withBase";
---
<header class="sticky top-0 z-50 border-b border-white/8 bg-slate-950/70 backdrop-blur-xl">
  <div class="shell flex items-center justify-between gap-6 py-4">
    <a href={withBase("/")} class="text-sm font-semibold tracking-[0.18em] text-white uppercase">
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {navigation.map((item) => (
        <a href={item.href} class="text-sm text-zinc-300 transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href={withBase("/")} class="text-sm text-zinc-300 transition hover:text-white">Main</a>
      <a href="#contact" class="button-secondary">Collaborate</a>
    </div>
  </div>
</header>
