---
import Ear from "@lucide/astro/icons/ear";
import Mic from "@lucide/astro/icons/mic";
import Orbit from "@lucide/astro/icons/orbit";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import Wrench from "@lucide/astro/icons/wrench";
import Sparkles from "@lucide/astro/icons/sparkles";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { publicInventions, researchToPrototypeFlow } from "../data/inventions";
import { withBase } from "../utils/withBase";

const workAreas = [
  {
    key: "perception",
    title: "Perception",
    eyebrow: "Psychoacoustics",
    icon: Ear,
    intro:
      "Auditory scene analysis, stream segregation, and the way musical sound becomes organised into perceptual events.",
    href: "#research-to-prototype",
    cta: "Trace the flow",
    accent: "cyan",
  },
  {
    key: "recording",
    title: "Recording",
    eyebrow: "Microphone practice",
    icon: Mic,
    intro:
      "Stereo, surround, and multichannel recording treated as a way of designing listening perspective and spatial focus.",
    href: "#authorial-prototypes",
    cta: "See prototypes",
    accent: "amber",
  },
  {
    key: "space",
    title: "Space",
    eyebrow: "Spatial audio",
    icon: Orbit,
    intro:
      "Acoustic space, direction, envelopment, and spatial composition as both research material and artistic medium.",
    href: "#applications-matrix",
    cta: "View uses",
    accent: "emerald",
  },
  {
    key: "education",
    title: "Education",
    eyebrow: "Listening literacy",
    icon: GraduationCap,
    intro:
      "Digital tools and studio environments used to teach listening, audio analysis, sound production, and musical technology.",
    href: "#applications-matrix",
    cta: "View uses",
    accent: "neutral",
  },
  {
    key: "prototypes",
    title: "Authorial Prototypes",
    eyebrow: "Audio inventions",
    icon: Wrench,
    intro:
      "Custom-designed systems that transform research on listening and spatial recording into physical audio devices.",
    href: "#authorial-prototypes",
    cta: "Open showcase",
    accent: "violet",
  },
  {
    key: "artistic-research",
    title: "Artistic Research",
    eyebrow: "Sound art and practice",
    icon: Sparkles,
    intro:
      "Experimental systems used as compositional tools, installation interfaces, and research environments for new listening situations.",
    href: "#authorial-prototypes",
    cta: "See systems",
    accent: "rose",
  },
];

const applicationBuckets = [
  {
    title: "Studio and field recording",
    text: "Capturing spatial relations, ambience, and source movement with authorial microphone strategies.",
  },
  {
    title: "Installation and performance",
    text: "Treating spatial audio systems as live, physical interfaces for sound art and electroacoustic practice.",
  },
  {
    title: "Research and testing",
    text: "Designing listening scenarios for auditory scene analysis, spatial perception, and multichannel evaluation.",
  },
  {
    title: "Education and workshops",
    text: "Using prototypes to explain microphone directionality, envelopment, and spatial listening through tangible examples.",
  },
];
---

<section class="inventive-hero" aria-labelledby="work-areas-title">
  <div class="hero-copy">
    <p class="kicker">Work areas / authorial systems</p>
    <h1 id="work-areas-title" class="page-hero-title">Research. Record. Invent.</h1>
    <p>
      Adam Rosinski's work connects auditory perception, microphone technologies, acoustic space,
      education, and experimental devices. The page is organised as a research map: from listening
      theory to physical systems and artistic applications.
    </p>
    <div class="hero-actions">
      <a href="#authorial-prototypes" class="primary-link">
        <span>Explore inventions</span>
        <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
      </a>
      <a href="#research-to-prototype" class="secondary-link">Research to prototype flow</a>
    </div>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <img src={withBase("/images/work-area-motifs/motif-technical-grid.svg")} alt="" loading="eager" />
    <div class="hero-motif-stack">
      <svg class="hero-motif hero-motif-1" viewBox="0 0 720 520" focusable="false">
        <defs>
          <radialGradient id="hero-array-glow" cx="50%" cy="50%" r="60%">
            <stop offset="0" stop-color="#67e8f9" stop-opacity=".28"></stop>
            <stop offset=".55" stop-color="#34d399" stop-opacity=".09"></stop>
            <stop offset="1" stop-color="#020617" stop-opacity="0"></stop>
          </radialGradient>
          <linearGradient id="hero-array-line" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#67e8f9"></stop>
            <stop offset=".5" stop-color="#a7f3d0"></stop>
            <stop offset="1" stop-color="#fbbf24"></stop>
          </linearGradient>
        </defs>
        <rect width="720" height="520" fill="url(#hero-array-glow)"></rect>
        <g fill="none" stroke="white" stroke-opacity=".12">
          <path d="M98 260c0-76 117-138 262-138s262 62 262 138-117 138-262 138S98 336 98 260Z"></path>
          <path d="M146 260c0-52 96-94 214-94s214 42 214 94-96 94-214 94-214-42-214-94Z"></path>
          <path d="M360 122v276M98 260h524"></path>
        </g>
        <path id="hero-array-orbit-path" d="M98 260c0-76 117-138 262-138s262 62 262 138-117 138-262 138S98 336 98 260Z" fill="none" opacity="0"></path>
        <g class="hero-array-dots" fill="url(#hero-array-line)">
          <circle r="5"><animateMotion dur="54s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-3.86s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-7.71s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-11.57s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="5"><animateMotion dur="54s" begin="-15.43s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-19.29s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-23.14s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="5"><animateMotion dur="54s" begin="-27s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-30.86s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-34.71s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="5"><animateMotion dur="54s" begin="-38.57s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-42.43s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-46.29s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
          <circle r="4"><animateMotion dur="54s" begin="-50.14s" repeatCount="indefinite"><mpath href="#hero-array-orbit-path"></mpath></animateMotion></circle>
        </g>
      </svg>

      <svg class="hero-motif hero-motif-2" viewBox="0 0 720 520" focusable="false">
        <defs>
          <linearGradient id="hero-capsule-shell" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#111827"></stop>
            <stop offset=".48" stop-color="#334155"></stop>
            <stop offset="1" stop-color="#030712"></stop>
          </linearGradient>
          <linearGradient id="hero-capsule-accent" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#67e8f9"></stop>
            <stop offset="1" stop-color="#fbbf24"></stop>
          </linearGradient>
        </defs>
        <rect width="720" height="520" fill="none"></rect>
        <ellipse cx="360" cy="260" rx="260" ry="132" fill="url(#hero-capsule-shell)" stroke="rgba(255,255,255,.22)"></ellipse>
        <g stroke="rgba(255,255,255,.13)" fill="none">
          <ellipse cx="360" cy="260" rx="218" ry="96"></ellipse>
          <path d="M110 260h500M360 128v264"></path>
          <path d="M179 188c106 62 254 62 362 0M179 332c106-62 254-62 362 0"></path>
        </g>
        <path
          class="hero-capsule-signal-path"
          d="M164 260 C 206 236, 226 229, 262 224 S 326 212, 360 212 S 425 218, 458 224 S 522 246, 556 260"
          fill="none"
          stroke="url(#hero-capsule-accent)"
          stroke-width="3"
          stroke-linecap="round"
          pathLength="1"
        ></path>
        <g class="hero-capsule-nodes">
          <circle class="hero-capsule-ring hero-capsule-ring-1" cx="164" cy="260" r="27" fill="#020617" stroke="url(#hero-capsule-accent)" stroke-width="2"></circle>
          <circle class="hero-capsule-ring hero-capsule-ring-2" cx="262" cy="224" r="25" fill="#020617" stroke="url(#hero-capsule-accent)" stroke-width="2"></circle>
          <circle class="hero-capsule-ring hero-capsule-ring-3" cx="360" cy="212" r="25" fill="#020617" stroke="url(#hero-capsule-accent)" stroke-width="2"></circle>
          <circle class="hero-capsule-ring hero-capsule-ring-4" cx="458" cy="224" r="25" fill="#020617" stroke="url(#hero-capsule-accent)" stroke-width="2"></circle>
          <circle class="hero-capsule-ring hero-capsule-ring-5" cx="556" cy="260" r="27" fill="#020617" stroke="url(#hero-capsule-accent)" stroke-width="2"></circle>
          <g fill="#fbbf24" opacity=".85">
            <circle class="hero-capsule-core hero-capsule-ring-1" cx="164" cy="260" r="4"></circle>
            <circle class="hero-capsule-core hero-capsule-ring-2" cx="262" cy="224" r="4"></circle>
            <circle class="hero-capsule-core hero-capsule-ring-3" cx="360" cy="212" r="4"></circle>
            <circle class="hero-capsule-core hero-capsule-ring-4" cx="458" cy="224" r="4"></circle>
            <circle class="hero-capsule-core hero-capsule-ring-5" cx="556" cy="260" r="4"></circle>
          </g>
        </g>
      </svg>

      <svg class="hero-motif hero-motif-3" viewBox="0 0 560 560" focusable="false">
        <defs>
          <radialGradient id="hero-polar-halo" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#67e8f9" stop-opacity=".25"></stop>
            <stop offset="1" stop-color="#67e8f9" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect width="560" height="560" fill="url(#hero-polar-halo)"></rect>
        <g transform="translate(280 280)" fill="none">
          <g stroke="white" stroke-opacity=".13">
            <circle r="72"></circle><circle r="136"></circle><circle r="200"></circle>
            <path d="M-220 0h440M0-220v440M-155-155l310 310M-155 155l310-310"></path>
          </g>
          <path class="hero-polar-lobe" d="M0-205C105-205 190-118 190-12c0 122-92 196-190 196S-190 110-190-12C-190-118-105-205 0-205Z" fill="rgba(103,232,249,.07)" stroke="#67e8f9" stroke-width="4"></path>
          <path class="hero-polar-inner" d="M0-172C66-172 124-119 124-52c0 71-53 108-124 154C-71 56-124 19-124-52c0-67 58-120 124-120Z" stroke="#fbbf24" stroke-width="3" stroke-opacity=".78"></path>
          <g class="hero-polar-points" fill="#67e8f9">
            <circle class="hero-polar-point hero-polar-point-1" cx="0" cy="-172" r="5"></circle>
            <circle class="hero-polar-point hero-polar-point-2" cx="124" cy="-52" r="5"></circle>
            <circle class="hero-polar-point hero-polar-point-3" cx="0" cy="102" r="5"></circle>
            <circle class="hero-polar-point hero-polar-point-4" cx="-124" cy="-52" r="5"></circle>
          </g>
        </g>
      </svg>
    </div>
    <div class="hero-orbit hero-orbit-one"></div>
    <div class="hero-orbit hero-orbit-two"></div>
    <div class="hero-chip hero-chip-a">perception</div>
    <div class="hero-chip hero-chip-b">prototype</div>
    <div class="hero-chip hero-chip-c">spatial capture</div>
  </div>
</section>

<section id="authorial-prototypes" class="prototype-section" aria-labelledby="prototype-title">
  <div class="section-head">
    <p class="kicker">Authorial inventions and prototypes</p>
    <h2 id="prototype-title">Research made physical.</h2>
    <p>
      The two public systems below turn spatial-audio research into tangible forms: a circular
      listening environment and a reconfigurable spherical microphone prototype. A third prototype
      remains intentionally excluded from the public UI until its article is ready after review.
    </p>
  </div>

  <div class="prototype-grid">
    {publicInventions.map((item) => (
      <article
        class:list={[
          "prototype-card",
          item.id === "spherical-microphone-prototype" && "prototype-card-reversed",
        ]}
        style={`--accent: ${item.accent}; --accent-2: ${item.accent2}; background-image: radial-gradient(circle at top right, color-mix(in srgb, ${item.accent} 24%, transparent), transparent 36%);`}
      >
        <div
          class:list={[
            "prototype-media",
            item.id === "circular-audio-array" && "prototype-media-white-matte prototype-media-matte-array",
            item.id === "spherical-microphone-prototype" &&
              "prototype-media-white-matte prototype-media-matte-spherical",
          ]}
        >
          <img src={withBase(item.image)} alt={item.imageAlt} loading="lazy" />
        </div>
        <div class="prototype-copy">
          <div class="prototype-labels">
            <span>{item.publicLabel}</span>
            <span>{item.eyebrow}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.subtitle}</p>

          <div class="prototype-lists">
            <div>
              <h4>Design emphasis</h4>
              <ul>
                {item.innovationPoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
            <div>
              <h4>Applications</h4>
              <ul>
                {item.applications.map((app) => <li>{app}</li>)}
              </ul>
            </div>
          </div>

          <div class="tag-row" aria-label="Related areas">
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>

          {item.articleHref ? (
            <a href={item.articleHref} class="article-link" target="_blank" rel="noreferrer">
              <span>Read related article</span>
              <ArrowUpRight size={15} stroke-width={1.8} aria-hidden="true" />
            </a>
          ) : (
            <button type="button" class="article-link article-link-placeholder" disabled>
              <span>Placeholder link</span>
            </button>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<section id="work-areas-map" class="work-map" aria-labelledby="work-map-title">
  <div class="map-panel">
    <div class="map-grid">
      <div>
        <p class="kicker">Interactive map</p>
        <h2 id="work-map-title">Six connected areas, one research practice.</h2>
        <p class="lead">
          Adam Rosiński’s work connects auditory perception, recording, spatial audio, education,
          authorial prototypes, and artistic research. Across these areas, scholarly inquiry develops
          into audio systems, recording methods, and listening environments.
        </p>

        <div class="mode-list" data-work-mode-buttons>
          {workAreas.map((area, index) => {
            const Icon = area.icon;
            return (
              <article
                id={`work-area-${area.key}`}
                class={`mode-card ${index === 0 ? "is-active" : ""}`}
                data-work-mode-card={area.key}
              >
                <button
                  type="button"
                  class="mode-trigger"
                  data-work-mode={area.key}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <span class={`mode-icon mode-icon-${area.accent}`}>
                    <Icon size={18} stroke-width={1.8} aria-hidden="true" />
                  </span>
                  <span class="mode-copy">
                    <small>{area.eyebrow}</small>
                    <strong>{area.title}</strong>
                    <span>{area.intro}</span>
                  </span>
                </button>
                <a href={area.href} class="mode-link">
                  {area.cta}
                  <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
                </a>
              </article>
            );
          })}
        </div>
      </div>

      <div class="map-visual">
        <svg viewBox="0 0 720 560" class="map-svg" aria-hidden="true">
          <g opacity="0.14" stroke="white" fill="none">
            <circle cx="360" cy="280" r="76" />
            <circle cx="360" cy="280" r="152" />
            <circle cx="360" cy="280" r="228" />
            <path d="M360 36v488M116 280h488M187 107l346 346M533 107 187 453" />
          </g>

          <g data-work-group="perception">
            <path d="M90 178 C 170 240, 245 196, 360 280 S 545 356, 630 210" fill="none" stroke="#67e8f9" stroke-width="4" />
            <path d="M102 390 C 210 322, 284 344, 360 280 S 492 204, 615 358" fill="none" stroke="rgba(255,255,255,.42)" stroke-width="2" />
            <circle cx="360" cy="280" r="13" fill="#fbbf24" />
          </g>

          <g data-work-group="recording" opacity="0.18">
            <path d="M360 84v392M164 280h392M222 142l276 276M498 142 222 418" fill="none" stroke="#fbbf24" stroke-width="3" />
            <circle cx="360" cy="280" r="20" fill="#fbbf24" />
            <circle cx="360" cy="148" r="8" fill="white" />
            <circle cx="492" cy="280" r="8" fill="white" />
            <circle cx="360" cy="412" r="8" fill="white" />
            <circle cx="228" cy="280" r="8" fill="white" />
          </g>

          <g data-work-group="space" opacity="0.18">
            <path d="M360 72 Q 512 128, 596 280 Q 512 432, 360 488 Q 208 432, 124 280 Q 208 128, 360 72Z" fill="rgba(52,211,153,.08)" stroke="#34d399" stroke-width="4" />
            <circle cx="360" cy="280" r="20" fill="#34d399" />
          </g>

          <g data-work-group="education" opacity="0.18">
            <path
              d="M360 214 C 318 184, 254 184, 208 208 V 382 C 258 356, 320 362, 360 398Z"
              fill="rgba(255,255,255,.04)"
              stroke="rgba(255,255,255,.72)"
              stroke-width="4"
              stroke-linejoin="round"
            />
            <path
              d="M360 214 C 402 184, 466 184, 512 208 V 382 C 462 356, 400 362, 360 398Z"
              fill="rgba(255,255,255,.04)"
              stroke="rgba(255,255,255,.72)"
              stroke-width="4"
              stroke-linejoin="round"
            />
            <path d="M360 214 V 398" fill="none" stroke="#67e8f9" stroke-width="3" stroke-linecap="round" />
          </g>

          <g data-work-group="prototypes" opacity="0.18">
            <ellipse cx="360" cy="280" rx="220" ry="108" fill="rgba(167,139,250,.10)" stroke="#a78bfa" stroke-width="4" />
            <g fill="#a78bfa">
              <circle cx="140" cy="280" r="8" />
              <circle cx="188" cy="226" r="8" />
              <circle cx="282" cy="184" r="8" />
              <circle cx="402" cy="178" r="8" />
              <circle cx="510" cy="222" r="8" />
              <circle cx="580" cy="280" r="8" />
              <circle cx="510" cy="338" r="8" />
              <circle cx="402" cy="382" r="8" />
              <circle cx="282" cy="376" r="8" />
              <circle cx="188" cy="334" r="8" />
            </g>
          </g>

          <g data-work-group="artistic-research" opacity="0.18">
            <path d="M168 360 C 260 94, 464 466, 558 190" fill="none" stroke="#fb7185" stroke-width="4" />
            <path d="M130 260 C 252 160, 458 400, 606 282" fill="none" stroke="rgba(255,255,255,.42)" stroke-width="2" />
            <g fill="#fb7185">
              <circle cx="168" cy="360" r="9" />
              <circle cx="360" cy="280" r="12" />
              <circle cx="558" cy="190" r="9" />
            </g>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<section id="research-to-prototype" class="flow-section" aria-labelledby="flow-title">
  <div class="section-head compact">
    <p class="kicker">From research to prototype</p>
    <h2 id="flow-title">A practical chain from listening theory to custom systems.</h2>
  </div>

  <div class="flow-card" data-flow-card>
    <svg
      class="flow-svg"
      viewBox="0 0 900 240"
      role="img"
      aria-label="Research to prototype flow motif"
    >
      <defs>
        <linearGradient id="work-flow-gradient" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#67e8f9"></stop>
          <stop offset=".5" stop-color="#a78bfa"></stop>
          <stop offset="1" stop-color="#fbbf24"></stop>
        </linearGradient>
      </defs>
      <rect width="900" height="240" fill="none"></rect>
      <path
        d="M60 120 C 205 24, 300 216, 450 120 S 695 216, 840 120"
        fill="none"
        stroke="url(#work-flow-gradient)"
        stroke-width="4"
        stroke-linecap="round"
      ></path>
      <g class="flow-svg-dots" stroke="url(#work-flow-gradient)" stroke-width="3">
        <circle data-flow-dot="0" class="flow-svg-dot" cx="60" cy="120" r="18" tabindex="0" role="button" aria-label="Highlight listening research"></circle>
        <circle data-flow-dot="1" class="flow-svg-dot" cx="255" cy="120" r="18" tabindex="0" role="button" aria-label="Highlight spatial model"></circle>
        <circle data-flow-dot="2" class="flow-svg-dot" cx="450" cy="120" r="18" tabindex="0" role="button" aria-label="Highlight prototype design"></circle>
        <circle data-flow-dot="3" class="flow-svg-dot" cx="645" cy="120" r="18" tabindex="0" role="button" aria-label="Highlight recording scenario"></circle>
        <circle data-flow-dot="4" class="flow-svg-dot" cx="840" cy="120" r="18" tabindex="0" role="button" aria-label="Highlight artistic research use"></circle>
      </g>
      <g class="flow-svg-cores">
        <circle data-flow-core="0" cx="60" cy="120" r="4"></circle>
        <circle data-flow-core="1" cx="255" cy="120" r="4"></circle>
        <circle data-flow-core="2" cx="450" cy="120" r="4"></circle>
        <circle data-flow-core="3" cx="645" cy="120" r="4"></circle>
        <circle data-flow-core="4" cx="840" cy="120" r="4"></circle>
      </g>
    </svg>
    <ol>
      {researchToPrototypeFlow.map((step, index) => (
        <li data-flow-step={String(index)} tabindex="0">
          <strong>{step.title}</strong>
          <span>{step.text}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="applications-matrix" class="applications-section" aria-labelledby="applications-title">
  <div class="section-head compact">
    <p class="kicker">Applications matrix</p>
    <h2 id="applications-title">Where the work areas meet.</h2>
  </div>

  <div class="applications-grid">
    {applicationBuckets.map((item, index) => (
      <article class="application-card">
        <span class="application-index">0{index + 1}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  const initInventiveWorkAreas = () => {
    const section = document.querySelector("#work-areas-map");
    if (!section || section.dataset.bound === "true") return;
    section.dataset.bound = "true";

    const buttons = Array.from(section.querySelectorAll("[data-work-mode]"));
    const cards = Array.from(section.querySelectorAll("[data-work-mode-card]"));
    const groups = Array.from(section.querySelectorAll("[data-work-group]"));

    if (!buttons.length || !groups.length || !cards.length) return;

    const setMode = (key) => {
      buttons.forEach((button) => {
        const active = button.getAttribute("data-work-mode") === key;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });

      cards.forEach((card) => {
        card.classList.toggle("is-active", card.getAttribute("data-work-mode-card") === key);
      });

      groups.forEach((group) => {
        group.setAttribute("opacity", group.getAttribute("data-work-group") === key ? "1" : "0.16");
      });
    };

    buttons.forEach((button) => {
      if (button.dataset.bound === "true") return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => setMode(button.getAttribute("data-work-mode")));
      button.addEventListener("focus", () => setMode(button.getAttribute("data-work-mode")));
    });

    cards.forEach((card) => {
      const key = card.getAttribute("data-work-mode-card");
      if (!key) return;

      card.addEventListener("mouseenter", () => setMode(key));
      card.addEventListener("focusin", () => setMode(key));
    });

    setMode("perception");
  };

  const initResearchFlow = () => {
    const flow = document.querySelector("[data-flow-card]");
    if (!flow || flow.dataset.bound === "true") return;
    flow.dataset.bound = "true";

    const dots = Array.from(flow.querySelectorAll("[data-flow-dot]"));
    const cores = Array.from(flow.querySelectorAll("[data-flow-core]"));
    const steps = Array.from(flow.querySelectorAll("[data-flow-step]"));

    if (!dots.length || !steps.length) return;

    const clearFlow = () => {
      dots.forEach((dot) => dot.classList.remove("is-active"));
      cores.forEach((core) => core.classList.remove("is-active"));
      steps.forEach((step) => step.classList.remove("is-active"));
    };

    const setFlow = (index) => {
      clearFlow();
      const key = String(index);
      flow.querySelector(`[data-flow-dot="${key}"]`)?.classList.add("is-active");
      flow.querySelector(`[data-flow-core="${key}"]`)?.classList.add("is-active");
      flow.querySelector(`[data-flow-step="${key}"]`)?.classList.add("is-active");
    };

    dots.forEach((dot) => {
      const index = dot.getAttribute("data-flow-dot");
      dot.addEventListener("mouseenter", () => setFlow(index));
      dot.addEventListener("focus", () => setFlow(index));
      dot.addEventListener("click", () => setFlow(index));
      dot.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        setFlow(index);
      });
    });

    cores.forEach((core) => {
      const index = core.getAttribute("data-flow-core");
      core.addEventListener("mouseenter", () => setFlow(index));
      core.addEventListener("focus", () => setFlow(index));
    });

    steps.forEach((step) => {
      const index = step.getAttribute("data-flow-step");
      step.addEventListener("mouseenter", () => setFlow(index));
      step.addEventListener("focus", () => setFlow(index));
    });

    flow.addEventListener("mouseleave", clearFlow);
    setFlow(0);
  };

  initInventiveWorkAreas();
  initResearchFlow();
</script>

