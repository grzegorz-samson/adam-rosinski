---
import BookOpenCheck from "@lucide/astro/icons/book-open-check";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import FileSearch from "@lucide/astro/icons/file-search";
import Network from "@lucide/astro/icons/network";
import SearchCheck from "@lucide/astro/icons/search-check";
import {
  peerReviewCounts,
  peerReviewKindLabels,
  peerReviewsByYear,
  type PeerReviewKind,
} from "../data/peerReviews";
import { getPeerReviewStrip } from "../data/peerReviewStrips";
import { withBase } from "../utils/withBase";

interface Props {
  sectionId?: string;
}

const { sectionId = "peer-review" } = Astro.props as Props;

const kindIcons: Record<PeerReviewKind, typeof FileSearch> = {
  "journal-manuscript": FileSearch,
  "conference-paper": Network,
  "book-chapter": BookOpenCheck,
};

const kindShortLabels: Record<PeerReviewKind, string> = {
  "journal-manuscript": "Journal",
  "conference-paper": "Proceedings",
  "book-chapter": "Chapter",
};
---

<section id={sectionId} class="peer-review-catalog" aria-labelledby={`${sectionId}-title`}>
  <div class="peer-review-intro">
    <div class="peer-review-copy">
      <p class="alt-kicker">Peer review</p>
      <h3 id={`${sectionId}-title`}>Reviewed works, 2021–2026</h3>
      <p>
        A documented record of scholarly reviewing across journal manuscripts, conference proceedings, and book
        chapters. The catalogue is grouped by the year in which each review assignment is listed in the CV.
      </p>
    </div>

    <aside class="peer-review-total" aria-label={`${peerReviewCounts.total} reviewed works`}>
      <SearchCheck size={22} stroke-width={1.7} aria-hidden="true" />
      <strong>{peerReviewCounts.total}</strong>
      <span>reviewed works</span>
    </aside>
  </div>

  <div class="peer-review-metrics" aria-label="Peer review activity summary">
    <div class="peer-review-metric is-conference">
      <Network size={18} stroke-width={1.75} aria-hidden="true" />
      <div>
        <strong>{peerReviewCounts.conferencePapers}</strong>
        <span>conference papers</span>
      </div>
    </div>
    <div class="peer-review-metric is-journal">
      <FileSearch size={18} stroke-width={1.75} aria-hidden="true" />
      <div>
        <strong>{peerReviewCounts.journals}</strong>
        <span>journal manuscripts</span>
      </div>
    </div>
    <div class="peer-review-metric is-chapter">
      <BookOpenCheck size={18} stroke-width={1.75} aria-hidden="true" />
      <div>
        <strong>{peerReviewCounts.bookChapters}</strong>
        <span>book chapters</span>
      </div>
    </div>
  </div>

  <div class="peer-review-years">
    {peerReviewsByYear.map(({ year, reviews, groups }, yearIndex) => (
      <details class="peer-review-year" open={yearIndex === 0}>
        <summary>
          <span class="peer-review-year-heading">
            <span class="peer-review-year-number">{year}</span>
            <span class="peer-review-year-description">
              <strong>{reviews.length}</strong>
              <span>{reviews.length === 1 ? "reviewed work" : "reviewed works"}</span>
            </span>
          </span>
          <span class="peer-review-year-action">
            <span>View list</span>
            <ChevronDown size={18} stroke-width={1.8} aria-hidden="true" />
          </span>
        </summary>

        <ol class="peer-review-list">
          {groups.map((group, groupIndex) => {
            const GroupIcon = kindIcons[group.kind];
            const groupStartIndex = groups
              .slice(0, groupIndex)
              .reduce((total, currentGroup) => total + currentGroup.reviews.length, 0);

            return (
              <>
                <li class:list={["peer-review-group-heading", `is-${group.kind}`]}>
                  <span>
                    <GroupIcon size={14} stroke-width={1.85} aria-hidden="true" />
                    {group.label}
                  </span>
                  <strong>{group.reviews.length}</strong>
                </li>

                {group.reviews.map((review, reviewIndex) => {
                  const Icon = kindIcons[review.kind];
                  const identifier = review.issn
                    ? `ISSN ${review.issn}`
                    : review.isbn
                      ? `ISBN ${review.isbn}`
                      : undefined;
                  const strip = getPeerReviewStrip(review);
                  const stripStyle = [
                    `--peer-review-strip-svg: url("${withBase(strip.asset)}")`,
                    `--peer-accent: ${strip.accent}`,
                    `--peer-accent-2: ${strip.accent2}`,
                  ].join("; ");
                  const displayIndex = groupStartIndex + reviewIndex + 1;

                  return (
                    <li class:list={["peer-review-item", `is-${review.kind}`]} style={stripStyle}>
                      <span class="peer-review-index" aria-hidden="true">
                        {String(displayIndex).padStart(2, "0")}
                      </span>
                      <div class="peer-review-item-main">
                        <div class="peer-review-item-topline">
                          <span class="peer-review-kind">
                            <Icon size={14} stroke-width={1.85} aria-hidden="true" />
                            {kindShortLabels[review.kind]}
                          </span>
                          {review.publicationYear && review.publicationYear !== review.reviewYear && (
                            <span class="peer-review-publication-year">Publication: {review.publicationYear}</span>
                          )}
                        </div>
                        <h4>{review.title}</h4>
                        <p>
                          <span>{review.venue}</span>
                          {review.volume && <span>{review.volume}</span>}
                          {identifier && <span>{identifier}</span>}
                        </p>
                      </div>
                    </li>
                  );
                })}
              </>
            );
          })}
        </ol>
      </details>
    ))}
  </div>

  <p class="peer-review-note">
    The entries reproduce the documented review activity rather than presenting the reviewed works as Adam
    Rosiński’s own publications. “Reviewed works” refers to listed assignments, not to the number of revision rounds
    or individual reports.
  </p>
</section>

<style>
  .peer-review-catalog {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 32px;
    background:
      radial-gradient(circle at 8% 0%, rgba(86, 216, 255, 0.14), transparent 30%),
      radial-gradient(circle at 92% 8%, rgba(167, 139, 250, 0.12), transparent 28%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.022));
    padding: clamp(1rem, 3vw, 1.5rem);
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.34);
    scroll-margin-top: 8.5rem;
  }

  .peer-review-catalog::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(to bottom, black, transparent 34%);
  }

  .peer-review-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: end;
  }

  .peer-review-copy {
    max-width: 68rem;
  }

  .peer-review-copy h3 {
    margin-top: 0.5rem;
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .peer-review-copy > p:last-child {
    max-width: 58rem;
    margin-top: 0.9rem;
    color: #aeb7c6;
    line-height: 1.8;
  }

  .peer-review-total {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.25rem 0.7rem;
    min-width: 13rem;
    border: 1px solid rgba(86, 216, 255, 0.2);
    border-radius: 24px;
    padding: 0.9rem 1rem;
    color: #56d8ff;
    background: rgba(2, 8, 14, 0.44);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .peer-review-total strong {
    color: #fff;
    font-size: 2.25rem;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .peer-review-total span {
    grid-column: 1 / -1;
    color: #b9c6d5;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .peer-review-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .peer-review-metric {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    padding: 0.75rem 0.85rem;
    background: rgba(255, 255, 255, 0.037);
  }

  .peer-review-metric svg {
    flex: 0 0 auto;
  }

  .peer-review-metric.is-conference {
    color: #a78bfa;
  }

  .peer-review-metric.is-journal {
    color: #56d8ff;
  }

  .peer-review-metric.is-chapter {
    color: #ffb347;
  }

  .peer-review-metric div {
    display: grid;
    gap: 0.08rem;
  }

  .peer-review-metric strong {
    color: #fff;
    font-size: 1.35rem;
    line-height: 1;
  }

  .peer-review-metric span {
    color: #aeb7c6;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .peer-review-years {
    display: grid;
    gap: 0.72rem;
    margin-top: 1.2rem;
  }

  .peer-review-year {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    background: rgba(2, 7, 13, 0.38);
  }

  .peer-review-year[open] {
    border-color: rgba(86, 216, 255, 0.18);
    background: rgba(2, 7, 13, 0.52);
  }

  .peer-review-year summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 0.86rem 0.95rem;
    user-select: none;
  }

  .peer-review-year summary::-webkit-details-marker {
    display: none;
  }

  .peer-review-year summary:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .peer-review-year-heading,
  .peer-review-year-action {
    display: flex;
    align-items: center;
  }

  .peer-review-year-heading {
    gap: 0.85rem;
  }

  .peer-review-year-number {
    color: #fff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .peer-review-year-description {
    display: flex;
    gap: 0.35rem;
    color: #aeb7c6;
    font-size: 0.82rem;
  }

  .peer-review-year-description strong {
    color: #56d8ff;
  }

  .peer-review-year-action {
    gap: 0.45rem;
    color: #b8c3d1;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .peer-review-year-action svg {
    transition: transform 180ms ease;
  }

  .peer-review-year[open] .peer-review-year-action svg {
    transform: rotate(180deg);
  }

  .peer-review-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    list-style: none;
  }

  .peer-review-item {
    --peer-accent: #56d8ff;
    --peer-accent-2: #34d399;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.8rem;
    min-height: 7.2rem;
    margin-right: -0.75rem;
    padding: 0.9rem clamp(9rem, 29vw, 20rem) 0.9rem 0.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }

  .peer-review-group-heading {
    --peer-accent: #56d8ff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0.25rem 0.55rem;
    border-top: 1px solid rgba(255, 255, 255, 0.075);
    color: color-mix(in srgb, var(--peer-accent) 78%, white 22%);
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .peer-review-group-heading:first-child {
    border-top: 0;
  }

  .peer-review-group-heading span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .peer-review-group-heading strong {
    color: #f6f8fb;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .peer-review-group-heading.is-conference-paper {
    --peer-accent: #a78bfa;
  }

  .peer-review-group-heading.is-book-chapter {
    --peer-accent: #ffb347;
  }

  .peer-review-item::before {
    position: absolute;
    inset: -0.28rem -3.2rem -0.28rem 0;
    z-index: 0;
    content: "";
    pointer-events: none;
    background-image: var(--peer-review-strip-svg);
    background-repeat: no-repeat;
    background-position: right center;
    background-size: auto 112%;
    opacity: 0.82;
    filter: brightness(0.96) contrast(1.13) saturate(0.86);
    transform-origin: right center;
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .peer-review-item::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(2, 7, 13, 0.99) 0%,
        rgba(2, 7, 13, 0.985) 46%,
        rgba(2, 7, 13, 0.82) 66%,
        rgba(2, 7, 13, 0.22) 100%
      ),
      radial-gradient(circle at 88% 50%, color-mix(in srgb, var(--peer-accent) 10%, transparent), transparent 36%);
  }

  .peer-review-item:hover::before {
    opacity: 0.94;
    transform: translateX(-0.18rem) scale(1.025);
  }

  .peer-review-item.is-conference-paper {
    --peer-accent: #a78bfa;
  }

  .peer-review-item.is-book-chapter {
    --peer-accent: #ffb347;
  }

  .peer-review-index,
  .peer-review-item-main {
    position: relative;
    z-index: 2;
  }

  .peer-review-index {
    padding-top: 0.12rem;
    color: color-mix(in srgb, var(--peer-accent) 78%, white 22%);
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .peer-review-item-main {
    min-width: 0;
  }

  .peer-review-item-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .peer-review-kind,
  .peer-review-publication-year {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    border-radius: 999px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .peer-review-kind {
    border: 1px solid color-mix(in srgb, var(--peer-accent) 26%, rgba(255, 255, 255, 0.1));
    padding: 0.33rem 0.48rem;
    color: color-mix(in srgb, var(--peer-accent) 80%, white 20%);
    background: color-mix(in srgb, var(--peer-accent) 7%, rgba(255, 255, 255, 0.035));
  }

  .peer-review-publication-year {
    padding: 0.34rem 0.48rem;
    color: #c7d0dc;
    background: rgba(255, 255, 255, 0.055);
  }

  .peer-review-item h4 {
    margin-top: 0.52rem;
    color: #f6f8fb;
    font-size: clamp(0.98rem, 1.45vw, 1.12rem);
    font-weight: 680;
    line-height: 1.38;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .peer-review-item p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.7rem;
    margin-top: 0.42rem;
    color: #8f9bab;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .peer-review-item p span:not(:first-child)::before {
    margin-right: 0.7rem;
    color: color-mix(in srgb, var(--peer-accent) 62%, transparent);
    content: "•";
  }

  .peer-review-note {
    margin: 1rem 0.15rem 0;
    color: #7f8a99;
    font-size: 0.76rem;
    line-height: 1.65;
  }

  @media (max-width: 780px) {
    .peer-review-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .peer-review-total {
      width: fit-content;
      min-width: 12rem;
    }

    .peer-review-metrics {
      grid-template-columns: 1fr;
    }

    .peer-review-item {
      min-height: 6.8rem;
      padding-right: clamp(7rem, 32vw, 12rem);
    }

    .peer-review-item::before {
      background-size: auto 100%;
      opacity: 0.68;
    }
  }

  @media (max-width: 560px) {
    .peer-review-catalog {
      border-radius: 24px;
      padding: 0.85rem;
    }

    .peer-review-year {
      border-radius: 20px;
    }

    .peer-review-year summary {
      align-items: flex-start;
    }

    .peer-review-year-action span {
      display: none;
    }

    .peer-review-year-description {
      display: grid;
      gap: 0.08rem;
    }

    .peer-review-item {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.55rem;
      min-height: 7.4rem;
      margin-right: -0.55rem;
      padding-right: 0.35rem;
    }

    .peer-review-item::before {
      background-position: right bottom;
      background-size: auto 100%;
      opacity: 0.3;
    }

    .peer-review-item::after {
      background: linear-gradient(90deg, rgba(2, 7, 13, 0.995) 0%, rgba(2, 7, 13, 0.94) 72%, rgba(2, 7, 13, 0.62) 100%);
    }

    .peer-review-list {
      padding-inline: 0.55rem;
    }
  }
</style>
