---
import BookOpen from "@lucide/astro/icons/book-open";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import Files from "@lucide/astro/icons/files";
import LibraryBig from "@lucide/astro/icons/library-big";
import Newspaper from "@lucide/astro/icons/newspaper";
import Tags from "@lucide/astro/icons/tags";
import WholeWord from "@lucide/astro/icons/whole-word";
import PublicationVisual from "./PublicationVisual.astro";
import { getDisplayTitle, getSecondaryTitle } from "../data/publicationPresentation";
import { getPublicationStrip } from "../data/publicationStrips";
import { getPublicationMetaLabel } from "../data/publicationTaxonomy";
import type { PublicationRecord } from "../data/publications";
import { withBase } from "../utils/withBase";

interface Props {
  monographs: PublicationRecord[];
  journalArticles: PublicationRecord[];
  editorialWork: PublicationRecord[];
  bookChapters: PublicationRecord[];
}

const { monographs, journalArticles, editorialWork, bookChapters } = Astro.props;

const sections = [
  {
    id: "journal-articles",
    title: "Journal articles",
    description: "Articles, proceedings papers, and prototype-oriented studies.",
    items: journalArticles,
    icon: Newspaper,
    accent: "#56D8FF",
    accent2: "#8B7CFF",
  },
  {
    id: "editorial-work",
    title: "Editorial work",
    description: "Edited volumes, series work, and publication leadership.",
    items: editorialWork,
    icon: LibraryBig,
    accent: "#34D399",
    accent2: "#12D6D6",
  },
  {
    id: "book-chapters",
    title: "Book chapters",
    description: "Chapters connected with perception, sound practice, and music education.",
    items: bookChapters,
    icon: WholeWord,
    accent: "#FFB347",
    accent2: "#FF8A00",
  },
];

function getDetailLines(publication: PublicationRecord): string[] {
  const lines: string[] = [];

  if (publication.publisher) {
    lines.push(publication.publisher);
  }

  if (publication.journal) {
    const parts = [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`].filter(Boolean);
    lines.push(parts.join(", "));
  }

  if (publication.book) {
    lines.push(`In: ${publication.book}`);
  }

  const publicationDetails = [publication.pages && `${publication.pages} pp.`, publication.language, publication.isbn && `ISBN ${publication.isbn}`]
    .filter(Boolean)
    .join(" · ");

  if (publicationDetails) {
    lines.push(publicationDetails);
  }

  if (publication.doi) {
    lines.push(`DOI ${publication.doi}`);
  }

  return lines;
}

function getVenueLine(publication: PublicationRecord): string | null {
  if (publication.journal) {
    return [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`]
      .filter(Boolean)
      .join(", ");
  }

  if (publication.book) {
    return `In: ${publication.book}`;
  }

  if (publication.publisher) {
    return publication.publisher;
  }

  return null;
}
---

<section class="catalog-section" aria-labelledby="catalog-title">
  <div class="catalog-heading">
    <p class="catalog-kicker">Full bibliography</p>
    <h2 id="catalog-title">Publication categories</h2>
    <p>
      The page opens with the four monographs as the visual shelf. Below that is the full publication catalogue,
      grouped by publication type and expanded with bibliographic context.
    </p>
  </div>

  <nav class="catalog-nav" aria-label="Publication categories">
    <a
      href="#selected-publications"
      class="catalog-chip"
      style="--catalog-chip-accent: #ff6a5c; --catalog-chip-accent-2: #df4a3d;"
    >
      <span class="catalog-chip-label">
        <BookOpen size={15} stroke-width={1.85} aria-hidden="true" />
        <span>Monographs</span>
      </span>
      <span class="catalog-chip-count">{monographs.length}</span>
    </a>
    {sections.map((section) => {
      const SectionIcon = section.icon;
      return (
        <a
          href={`#${section.id}`}
          class="catalog-chip"
          style={`--catalog-chip-accent: ${section.accent}; --catalog-chip-accent-2: ${section.accent2};`}
        >
          <span class="catalog-chip-label">
            <SectionIcon size={15} stroke-width={1.85} aria-hidden="true" />
            <span>{section.title}</span>
          </span>
          <span class="catalog-chip-count">{section.items.length}</span>
        </a>
      );
    })}
  </nav>

  <div class="catalog-groups">
    {sections.map((section) => (
      <section id={section.id} class="catalog-group" aria-labelledby={`${section.id}-title`}>
        <div class="catalog-group-header">
          <div class="catalog-group-copy">
            <h3 id={`${section.id}-title`}>{section.title}</h3>
            <p>{section.description}</p>
          </div>
          <p class="catalog-group-count-badge">{section.items.length}</p>
        </div>

        <div class="catalog-grid">
          {section.items.map((publication) => {
            const displayTitle = getDisplayTitle(publication);
            const secondaryTitle = getSecondaryTitle(publication);
            const venueLine = getVenueLine(publication);
            const strip = getPublicationStrip(publication);
            const stripStyle = [
              `--publication-strip-svg: url("${withBase(strip.asset)}")`,
              `--publication-strip-accent: ${strip.accent}`,
              `--publication-strip-accent-2: ${strip.accent2}`,
            ].join("; ");

            return (
              <details
                class:list={[
                  "catalog-item",
                  "publication-row",
                  section.id === "monographs" && "catalog-item-book",
                ]}
                style={stripStyle}
              >
                <summary class="catalog-summary-row">
                  <div class="catalog-summary-main">
                    <PublicationVisual
                      publication={publication}
                      sectionId={section.id}
                      title={displayTitle}
                      accent={strip.accent}
                      accent2={strip.accent2}
                    />

                    <div class="catalog-title-stack">
                      <div class="catalog-item-meta">
                        <span>
                          <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                          {publication.year}
                        </span>
                        <span>{getPublicationMetaLabel(publication.category, publication.type)}</span>
                      </div>

                      <h4>{displayTitle}</h4>
                      {secondaryTitle && <p class="catalog-secondary-title">{secondaryTitle}</p>}
                      {venueLine && <p class="catalog-venue-line">{venueLine}</p>}
                    </div>
                  </div>

                  <div class="catalog-summary-side">
                    {publication.sourceVerified === false && (
                      <span class="catalog-pdf-badge">
                        <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                        PDF
                      </span>
                    )}
                    <ChevronDown size={18} stroke-width={1.9} aria-hidden="true" class="catalog-chevron" />
                  </div>
                </summary>

                <div class="catalog-expanded">
                  <div class="catalog-expanded-columns">
                    <div class="catalog-column-stack">
                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                          Overview
                        </p>
                        <p class="catalog-summary-text">{publication.summary}</p>
                      </section>

                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <Tags size={13} stroke-width={1.8} aria-hidden="true" />
                          Keywords
                        </p>
                        <div class="catalog-tags">
                          {publication.tags.map((tag) => (
                            <span>{tag}</span>
                          ))}
                        </div>
                      </section>
                    </div>

                    <div class="catalog-column-side">
                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <Files size={13} stroke-width={1.8} aria-hidden="true" />
                          Bibliographic details
                        </p>
                        <div class="catalog-detail-list">
                          {getDetailLines(publication).map((line) => (
                            <p>{line}</p>
                          ))}
                        </div>
                      </section>
                    </div>
                  </div>

                  <div class="catalog-links">
                    {publication.sourceVerified === false && (
                      <span class="catalog-pdf-note">
                        <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                        PDF
                      </span>
                    )}
                    <a href={publication.href} target="_blank" rel="noreferrer" class="catalog-link alt-link-with-icon">
                      <span>{publication.sourceVerified === false ? "Open source page" : "Open publication"}</span>
                      <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const publicationRows = Array.from(document.querySelectorAll(".catalog-item"));

  for (const row of publicationRows) {
    const summary = row.querySelector(".catalog-summary-row");
    const content = row.querySelector(".catalog-expanded");

    if (!(row instanceof HTMLDetailsElement) || !(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) {
      continue;
    }

    let animating = false;

    if (!row.open) {
      content.style.height = "0px";
      content.style.opacity = "0";
    } else {
      content.style.height = "auto";
      content.style.opacity = "1";
    }

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (animating) {
        return;
      }

      if (prefersReducedMotion.matches) {
        row.open = !row.open;
        content.style.height = row.open ? "auto" : "0px";
        content.style.opacity = row.open ? "1" : "0";
        return;
      }

      if (row.open) {
        animating = true;
        row.classList.add("is-closing");
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";
        content.getBoundingClientRect();

        let closeFallback: number | undefined;

        const cleanupClose = () => {
          if (closeFallback) {
            window.clearTimeout(closeFallback);
          }

          row.open = false;
          row.classList.remove("is-closing");
          content.style.height = "0px";
          content.style.opacity = "0";
          animating = false;
          content.removeEventListener("transitionend", handleClose);
          content.removeEventListener("transitioncancel", handleClose);
        };

        requestAnimationFrame(() => {
          content.style.height = "0px";
          content.style.opacity = "0";
        });

        const handleClose = (transitionEvent: TransitionEvent) => {
          if (transitionEvent.type === "transitionend" && transitionEvent.propertyName !== "height") {
            return;
          }

          cleanupClose();
        };

        content.addEventListener("transitionend", handleClose);
        content.addEventListener("transitioncancel", handleClose);
        closeFallback = window.setTimeout(cleanupClose, 420);
        return;
      }

      row.open = true;
      row.classList.remove("is-closing");
      animating = true;
      content.style.height = "0px";
      content.style.opacity = "0";
      content.getBoundingClientRect();

      let openFallback: number | undefined;

      requestAnimationFrame(() => {
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";
      });

      const cleanupOpen = () => {
        if (openFallback) {
          window.clearTimeout(openFallback);
        }

        content.style.height = "auto";
        animating = false;
        content.removeEventListener("transitionend", handleOpen);
        content.removeEventListener("transitioncancel", handleOpen);
      };

      const handleOpen = (transitionEvent: TransitionEvent) => {
        if (transitionEvent.type === "transitionend" && transitionEvent.propertyName !== "height") {
          return;
        }

        cleanupOpen();
      };

      content.addEventListener("transitionend", handleOpen);
      content.addEventListener("transitioncancel", handleOpen);
      openFallback = window.setTimeout(cleanupOpen, 420);
    });
  }
</script>

<style>
  .catalog-section {
    padding: 0 0 4.5rem;
  }

  .catalog-heading {
    max-width: 58rem;
    margin-bottom: 1.6rem;
  }

  .catalog-kicker,
  .catalog-group-count,
  .catalog-item-meta,
  .catalog-block-label {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .catalog-kicker {
    color: #56d8ff;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .catalog-heading h2 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  .catalog-heading p:last-child,
  .catalog-group-header p,
  .catalog-summary-text,
  .catalog-detail-list p,
  .catalog-secondary-title {
    color: #a1a1aa;
    line-height: 1.8;
  }

  .catalog-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .catalog-chip {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 12rem;
    padding: 0.9rem 1rem 0.9rem 1.05rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--catalog-chip-accent) 16%, rgba(255, 255, 255, 0.09));
    background:
      radial-gradient(circle at 18% 50%, color-mix(in srgb, var(--catalog-chip-accent) 10%, transparent), transparent 38%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--catalog-chip-accent-2) 12%, rgba(255, 255, 255, 0.03)) 0%,
        color-mix(in srgb, var(--catalog-chip-accent) 7%, rgba(255, 255, 255, 0.02)) 100%
      );
    color: #eef3ff;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 22px rgba(0, 0, 0, 0.16);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease,
      color 160ms ease;
  }

  .catalog-chip-label {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    font-weight: 600;
  }

  .catalog-chip-label svg {
    flex-shrink: 0;
    color: var(--catalog-chip-accent);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--catalog-chip-accent) 18%, transparent));
  }

  .catalog-chip-label span:last-child {
    text-wrap: pretty;
  }

  .catalog-chip:hover {
    border-color: color-mix(in srgb, var(--catalog-chip-accent) 28%, rgba(255, 255, 255, 0.11));
    color: #fff;
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 26px rgba(0, 0, 0, 0.18),
      0 0 0 1px color-mix(in srgb, var(--catalog-chip-accent) 7%, transparent);
  }

  .catalog-chip-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--catalog-chip-accent) 18%, transparent);
    background: color-mix(in srgb, var(--catalog-chip-accent) 5%, rgba(255, 255, 255, 0.015));
    color: var(--catalog-chip-accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .catalog-groups {
    display: grid;
    gap: 1.6rem;
  }

  .catalog-group {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.03);
    padding: 1.4rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.26);
  }

  .catalog-group-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .catalog-group-copy {
    min-width: 0;
  }

  .catalog-group-count {
    color: #56d8ff;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .catalog-group-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 2.2rem;
    height: 2.2rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(86, 216, 255, 0.24);
    background: rgba(86, 216, 255, 0.08);
    color: #56d8ff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
  }

  .catalog-group h3 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  .catalog-item {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: rgba(9, 12, 18, 0.55);
    overflow: hidden;
    isolation: isolate;
  }

  .catalog-item[open] {
    border-color: rgba(86, 216, 255, 0.22);
    background: rgba(9, 12, 18, 0.72);
  }

  .publication-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 84% 3.9rem, var(--publication-strip-accent) 0%, transparent 46%),
      linear-gradient(
        90deg,
        rgba(1, 2, 5, 0.998) 0%,
        rgba(1, 2, 5, 0.997) 52%,
        rgba(1, 2, 5, 0.992) 74%,
        rgba(0, 0, 0, 0.9) 88%,
        rgba(0, 0, 0, 0.9) 100%
      );
  }

  .publication-row::after {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    background: rgba(0, 0, 0, 0.7);
    pointer-events: none;
  }

  .catalog-summary-row::before {
    content: "";
    position: absolute;
    inset: 0 -0.6rem 0 0;
    z-index: -1;
    opacity: 0.78;
    background-image: var(--publication-strip-svg);
    background-repeat: no-repeat;
    background-position: right top;
    background-size: min(60%, 800px) auto;
    pointer-events: none;
    transform-origin: right top;
    transition: opacity 180ms ease, transform 220ms ease;
    filter: brightness(0.98) contrast(1.18) saturate(0.82);
  }

  .publication-row:hover .catalog-summary-row::before {
    opacity: 0.86;
    transform: translateX(-0.45rem) scale(1.03);
  }

  .publication-row[open]:not(.is-closing) .catalog-summary-row::before {
    opacity: 0.9;
    transform: translateX(-0.45rem) scale(1.3);
  }

  .publication-row.is-closing .catalog-summary-row::before {
    opacity: 0.78;
    transform: translateX(0) scale(1);
  }

  .publication-row.is-closing:hover .catalog-summary-row::before {
    opacity: 0.86;
    transform: translateX(-0.45rem) scale(1.03);
  }

  .catalog-summary-row {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    list-style: none;
    cursor: pointer;
  }

  .catalog-summary-row::-webkit-details-marker {
    display: none;
  }

  .catalog-summary-main {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding-right: clamp(0.75rem, 6vw, 5.5rem);
  }

  .catalog-title-stack {
    min-width: 0;
    max-width: 44rem;
  }

  .catalog-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    color: #9195a5;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .catalog-item-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .catalog-item h4 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: 1.12rem;
    line-height: 1.4;
    max-width: 100%;
    text-wrap: pretty;
  }

  .catalog-secondary-title {
    margin-top: 0.4rem;
    font-size: 0.92rem;
  }

  .catalog-venue-line {
    margin-top: 0.42rem;
    color: #b5b8c7;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .catalog-summary-side {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .catalog-pdf-badge,
  .catalog-pdf-note {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #c6cad8;
    font-size: 0.82rem;
  }

  .catalog-chevron {
    color: #c6cad8;
    transition: transform 180ms ease;
  }

  .catalog-item[open] .catalog-chevron {
    transform: rotate(180deg);
  }

  .catalog-expanded {
    display: grid;
    gap: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 1.2rem;
    transition:
      height 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  .catalog-expanded-columns {
    display: grid;
    gap: 0;
  }

  .catalog-column-stack,
  .catalog-column-side {
    display: grid;
    gap: 0;
  }

  .catalog-column-side .catalog-block {
    padding-inline: 1rem;
    padding-bottom: 1rem;
    border-radius: 18px;
    background: transparent;
    border: 0;
  }

  .catalog-column-side .catalog-block-label,
  .catalog-column-side .catalog-detail-list p {
    color: #f4f7ff;
  }

  .catalog-block {
    padding: 0.95rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .catalog-block-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: #56d8ff;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .catalog-summary-text {
    margin-top: 0.55rem;
  }

  .catalog-detail-list {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }

  .catalog-detail-list p {
    margin: 0;
    font-size: 0.95rem;
  }

  .catalog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .catalog-tags span {
    padding: 0.33rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    font-size: 0.8rem;
    line-height: 1;
  }

  .catalog-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 0 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .catalog-link {
    color: #56d8ff;
    text-decoration: none;
  }

  .catalog-link:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .catalog-chip {
      min-width: 0;
      width: 100%;
    }

    .catalog-summary-row::before {
      inset: 0 -0.35rem 0 0;
      opacity: 0.32;
      background-position: right top;
