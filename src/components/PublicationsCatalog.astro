---
import BookOpen from "@lucide/astro/icons/book-open";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import Files from "@lucide/astro/icons/files";
import Tags from "@lucide/astro/icons/tags";
import PublicationVisual from "./PublicationVisual.astro";
import { getDisplayTitle, getSecondaryTitle } from "../data/publicationPresentation";
import { getPublicationStrip } from "../data/publicationStrips";
import { getPublicationMetaLabel } from "../data/publicationTaxonomy";
import type { PublicationRecord } from "../data/publications";
import { withBase } from "../utils/withBase";

interface Props {
  monographs: PublicationRecord[];
  journalArticles: PublicationRecord[];
  editorialWork: PublicationRecord[];
  bookChapters: PublicationRecord[];
}

const { monographs, journalArticles, editorialWork, bookChapters } = Astro.props;

const sections = [
  {
    id: "journal-articles",
    title: "Journal articles",
    description: "Articles, proceedings papers, and prototype-oriented studies.",
    items: journalArticles,
  },
  {
    id: "editorial-work",
    title: "Editorial work",
    description: "Edited volumes, series work, and publication leadership.",
    items: editorialWork,
  },
  {
    id: "book-chapters",
    title: "Book chapters",
    description: "Chapters connected with perception, sound practice, and music education.",
    items: bookChapters,
  },
];

function getDetailLines(publication: PublicationRecord): string[] {
  const lines: string[] = [];

  if (publication.publisher) {
    lines.push(publication.publisher);
  }

  if (publication.journal) {
    const parts = [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`].filter(Boolean);
    lines.push(parts.join(", "));
  }

  if (publication.book) {
    lines.push(`In: ${publication.book}`);
  }

  const publicationDetails = [publication.pages && `${publication.pages} pp.`, publication.language, publication.isbn && `ISBN ${publication.isbn}`]
    .filter(Boolean)
    .join(" · ");

  if (publicationDetails) {
    lines.push(publicationDetails);
  }

  if (publication.doi) {
    lines.push(`DOI ${publication.doi}`);
  }

  return lines;
}

function getVenueLine(publication: PublicationRecord): string | null {
  if (publication.journal) {
    return [publication.journal, publication.volume, publication.issue && `No. ${publication.issue}`]
      .filter(Boolean)
      .join(", ");
  }

  if (publication.book) {
    return `In: ${publication.book}`;
  }

  if (publication.publisher) {
    return publication.publisher;
  }

  return null;
}
---

<section class="catalog-section" aria-labelledby="catalog-title">
  <div class="catalog-heading">
    <p class="catalog-kicker">Full bibliography</p>
    <h2 id="catalog-title">Publication categories</h2>
    <p>
      The page opens with the four monographs as the visual shelf. Below that is the full publication catalogue,
      grouped by publication type and expanded with bibliographic context.
    </p>
  </div>

  <nav class="catalog-nav" aria-label="Publication categories">
    <a href="#selected-publications" class="catalog-chip">
      <span>Monographs</span>
      <span>{monographs.length}</span>
    </a>
    {sections.map((section) => (
      <a href={`#${section.id}`} class="catalog-chip">
        <span>{section.title}</span>
        <span>{section.items.length}</span>
      </a>
    ))}
  </nav>

  <div class="catalog-groups">
    {sections.map((section) => (
      <section id={section.id} class="catalog-group" aria-labelledby={`${section.id}-title`}>
        <div class="catalog-group-header">
          <div>
            <p class="catalog-group-count">{section.items.length} items</p>
            <h3 id={`${section.id}-title`}>{section.title}</h3>
            <p>{section.description}</p>
          </div>
        </div>

        <div class="catalog-grid">
          {section.items.map((publication) => {
            const displayTitle = getDisplayTitle(publication);
            const secondaryTitle = getSecondaryTitle(publication);
            const venueLine = getVenueLine(publication);
            const strip = getPublicationStrip(publication);
            const stripStyle = [
              `--publication-strip-svg: url("${withBase(strip.asset)}")`,
              `--publication-strip-accent: ${strip.accent}`,
              `--publication-strip-accent-2: ${strip.accent2}`,
            ].join("; ");

            return (
              <details
                class:list={[
                  "catalog-item",
                  "publication-row",
                  section.id === "monographs" && "catalog-item-book",
                ]}
                style={stripStyle}
              >
                <summary class="catalog-summary-row">
                  <div class="catalog-summary-main">
                    <PublicationVisual publication={publication} sectionId={section.id} title={displayTitle} />

                    <div class="catalog-title-stack">
                      <div class="catalog-item-meta">
                        <span>
                          <BookOpen size={13} stroke-width={1.75} aria-hidden="true" />
                          {publication.year}
                        </span>
                        <span>{getPublicationMetaLabel(publication.category, publication.type)}</span>
                      </div>

                      <h4>{displayTitle}</h4>
                      {secondaryTitle && <p class="catalog-secondary-title">{secondaryTitle}</p>}
                      {venueLine && <p class="catalog-venue-line">{venueLine}</p>}
                    </div>
                  </div>

                  <div class="catalog-summary-side">
                    {publication.sourceVerified === false && (
                      <span class="catalog-pdf-badge">
                        <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                        PDF
                      </span>
                    )}
                    <ChevronDown size={18} stroke-width={1.9} aria-hidden="true" class="catalog-chevron" />
                  </div>
                </summary>

                <div class="catalog-expanded">
                  <div class="catalog-expanded-columns">
                    <div class="catalog-column-stack">
                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                          Overview
                        </p>
                        <p class="catalog-summary-text">{publication.summary}</p>
                      </section>

                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <Tags size={13} stroke-width={1.8} aria-hidden="true" />
                          Keywords
                        </p>
                        <div class="catalog-tags">
                          {publication.tags.map((tag) => (
                            <span>{tag}</span>
                          ))}
                        </div>
                      </section>
                    </div>

                    <div class="catalog-column-side">
                      <section class="catalog-block">
                        <p class="catalog-block-label">
                          <Files size={13} stroke-width={1.8} aria-hidden="true" />
                          Bibliographic details
                        </p>
                        <div class="catalog-detail-list">
                          {getDetailLines(publication).map((line) => (
                            <p>{line}</p>
                          ))}
                        </div>
                      </section>
                    </div>
                  </div>

                  <div class="catalog-links">
                    {publication.sourceVerified === false && (
                      <span class="catalog-pdf-note">
                        <FileText size={13} stroke-width={1.8} aria-hidden="true" />
                        PDF
                      </span>
                    )}
                    <a href={publication.href} target="_blank" rel="noreferrer" class="catalog-link alt-link-with-icon">
                      <span>{publication.sourceVerified === false ? "Open source page" : "Open publication"}</span>
                      <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const publicationRows = Array.from(document.querySelectorAll(".catalog-item"));

  for (const row of publicationRows) {
    const summary = row.querySelector(".catalog-summary-row");
    const content = row.querySelector(".catalog-expanded");

    if (!(row instanceof HTMLDetailsElement) || !(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) {
      continue;
    }

    let animating = false;

    if (!row.open) {
      content.style.height = "0px";
      content.style.opacity = "0";
    } else {
      content.style.height = "auto";
      content.style.opacity = "1";
    }

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (animating) {
        return;
      }

      if (prefersReducedMotion.matches) {
        row.open = !row.open;
        content.style.height = row.open ? "auto" : "0px";
        content.style.opacity = row.open ? "1" : "0";
        return;
      }

      if (row.open) {
        animating = true;
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";

        requestAnimationFrame(() => {
          content.style.height = "0px";
          content.style.opacity = "0";
        });

        const handleClose = (transitionEvent: TransitionEvent) => {
          if (transitionEvent.propertyName !== "height") {
            return;
          }

          row.open = false;
          content.style.height = "0px";
          content.style.opacity = "0";
          animating = false;
          content.removeEventListener("transitionend", handleClose);
        };

        content.addEventListener("transitionend", handleClose);
        return;
      }

      row.open = true;
      animating = true;
      content.style.height = "0px";
      content.style.opacity = "0";

      requestAnimationFrame(() => {
        content.style.height = `${content.scrollHeight}px`;
        content.style.opacity = "1";
      });

      const handleOpen = (transitionEvent: TransitionEvent) => {
        if (transitionEvent.propertyName !== "height") {
          return;
        }

        content.style.height = "auto";
        animating = false;
        content.removeEventListener("transitionend", handleOpen);
      };

      content.addEventListener("transitionend", handleOpen);
    });
  }
</script>

<style>
  .catalog-section {
    padding: 0 0 4.5rem;
  }

  .catalog-heading {
    max-width: 58rem;
    margin-bottom: 1.6rem;
  }

  .catalog-kicker,
  .catalog-group-count,
  .catalog-item-meta,
  .catalog-block-label {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .catalog-kicker {
    color: #56d8ff;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .catalog-heading h2 {
    margin-top: 0.8rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  .catalog-heading p:last-child,
  .catalog-group-header p,
  .catalog-summary-text,
  .catalog-detail-list p,
  .catalog-secondary-title {
    color: #a1a1aa;
    line-height: 1.8;
  }

  .catalog-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .catalog-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: #d4d4d8;
    text-decoration: none;
  }

  .catalog-chip:hover {
    border-color: rgba(86, 216, 255, 0.24);
    color: #fff;
  }

  .catalog-chip span:last-child {
    color: #56d8ff;
    font-size: 0.82rem;
  }

  .catalog-groups {
    display: grid;
    gap: 1.6rem;
  }

  .catalog-group {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.03);
    padding: 1.4rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.26);
  }

  .catalog-group-header {
    margin-bottom: 1.25rem;
  }

  .catalog-group-count {
    color: #56d8ff;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .catalog-group h3 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  .catalog-item {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: rgba(9, 12, 18, 0.55);
    overflow: hidden;
    isolation: isolate;
  }

  .catalog-item[open] {
    border-color: rgba(86, 216, 255, 0.22);
    background: rgba(9, 12, 18, 0.72);
  }

  .publication-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 83% 3.9rem, var(--publication-strip-accent) 0%, transparent 42%),
      linear-gradient(
        90deg,
        rgba(4, 6, 11, 0.995) 0%,
        rgba(4, 6, 11, 0.985) 42%,
        rgba(4, 6, 11, 0.92) 70%,
        rgba(4, 6, 11, 0.82) 100%
      );
  }

  .publication-row::after {
    content: "";
    position: absolute;
    inset: 0.55rem -0.45rem 0.55rem auto;
    width: min(60%, 800px);
    z-index: -1;
    opacity: 0.9;
    background-image: var(--publication-strip-svg);
    background-repeat: no-repeat;
    background-position: right top;
    background-size: contain;
    mask-image: radial-gradient(circle at right top, #000 0%, #000 64%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle at right top, #000 0%, #000 64%, transparent 100%);
    pointer-events: none;
    transform-origin: right center;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .publication-row:hover::after,
  .publication-row[open]::after {
    opacity: 1;
    transform: translateX(-0.45rem);
  }

  .catalog-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    list-style: none;
    cursor: pointer;
  }

  .catalog-summary-row::-webkit-details-marker {
    display: none;
  }

  .catalog-summary-main {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .catalog-title-stack {
    min-width: 0;
  }

  .catalog-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    color: #9195a5;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .catalog-item-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .catalog-item h4 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: 1.12rem;
    line-height: 1.4;
  }

  .catalog-secondary-title {
    margin-top: 0.4rem;
    font-size: 0.92rem;
  }

  .catalog-venue-line {
    margin-top: 0.42rem;
    color: #b5b8c7;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .catalog-summary-side {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .catalog-pdf-badge,
  .catalog-pdf-note {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #c6cad8;
    font-size: 0.82rem;
  }

  .catalog-chevron {
    color: #c6cad8;
    transition: transform 180ms ease;
  }

  .catalog-item[open] .catalog-chevron {
    transform: rotate(180deg);
  }

  .catalog-expanded {
    display: grid;
    gap: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 1.2rem;
    transition:
      height 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  .catalog-expanded-columns {
    display: grid;
    gap: 0;
  }

  .catalog-column-stack,
  .catalog-column-side {
    display: grid;
    gap: 0;
  }

  .catalog-column-side .catalog-block {
    padding-inline: 1rem;
    padding-bottom: 1rem;
    border-radius: 18px;
    background: transparent;
    border: 0;
  }

  .catalog-column-side .catalog-block-label,
  .catalog-column-side .catalog-detail-list p {
    color: #f4f7ff;
  }

  .catalog-block {
    padding: 0.95rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .catalog-block-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: #56d8ff;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .catalog-summary-text {
    margin-top: 0.55rem;
  }

  .catalog-detail-list {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }

  .catalog-detail-list p {
    margin: 0;
    font-size: 0.95rem;
  }

  .catalog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .catalog-tags span {
    padding: 0.33rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    font-size: 0.8rem;
    line-height: 1;
  }

  .catalog-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 0 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .catalog-link {
    color: #56d8ff;
    text-decoration: none;
  }

  .catalog-link:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .publication-row::after {
      inset: 0.4rem -0.3rem 0.4rem auto;
      width: 108%;
      opacity: 0.3;
      background-size: cover;
      background-position: right top;
    }

    .publication-row:hover::after,
    .publication-row[open]::after {
      opacity: 0.34;
      transform: translateX(-0.2rem);
    }

    .publication-row::before {
      background:
        radial-gradient(circle at 84% 3.2rem, var(--publication-strip-accent-2) 0%, transparent 38%),
        linear-gradient(0deg, rgba(4, 6, 11, 0.982), rgba(4, 6, 11, 0.982));
    }

    .catalog-summary-row {
      flex-direction: column;
    }

    .catalog-summary-side {
      justify-content: space-between;
    }

    .catalog-summary-main {
      align-items: flex-start;
    }

  }

  @media (min-width: 960px) {
    .catalog-expanded-columns {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      column-gap: 1.4rem;
      align-items: start;
    }

    .catalog-links {
      margin-top: 0.2rem;
    }
  }

  @media (min-width: 721px) and (max-width: 959px) {
    .publication-row::after {
      inset: 0.55rem -0.2rem 0.55rem auto;
      width: 74%;
      opacity: 0.72;
    }

    .publication-row:hover::after,
    .publication-row[open]::after {
      opacity: 0.8;
      transform: translateX(-0.3rem);
    }

    .publication-row::before {
      background:
        radial-gradient(circle at 84% 3.4rem, var(--publication-strip-accent) 0%, transparent 40%),
        linear-gradient(
          90deg,
          rgba(4, 6, 11, 0.994) 0%,
          rgba(4, 6, 11, 0.975) 58%,
          rgba(4, 6, 11, 0.86) 100%
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .publication-row::after {
      transition: none;
      transform: none;
    }
  }
</style>
