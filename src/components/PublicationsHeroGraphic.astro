<style>
  .publications-hero-graphic {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .publications-hero-book,
  .publications-hero-node,
  .publications-hero-spectrum-bar {
    transform-box: fill-box;
    transform-origin: center;
  }

  .publications-hero-book {
    animation: publications-hero-book-float 9s ease-in-out infinite;
    filter: drop-shadow(0 20px 24px rgba(0, 0, 0, 0.25));
  }

  .publications-hero-book-2 { animation-delay: -2.2s; }
  .publications-hero-book-3 { animation-delay: -4.4s; }
  .publications-hero-book-4 { animation-delay: -6.6s; }

  .publications-hero-signal {
    stroke-dasharray: 0.18 0.82;
    stroke-dashoffset: 1;
    animation: publications-hero-signal-travel 13s linear infinite;
  }

  .publications-hero-signal-main {
    filter: drop-shadow(0 0 9px rgba(103, 232, 249, 0.34));
  }

  .publications-hero-signal-secondary {
    animation-duration: 17s;
    animation-direction: reverse;
  }

  .publications-hero-node {
    opacity: 0.46;
    animation: publications-hero-node-pulse 6s ease-in-out infinite;
  }

  .publications-hero-node-2 { animation-delay: -1.2s; }
  .publications-hero-node-3 { animation-delay: -2.4s; }
  .publications-hero-node-4 { animation-delay: -3.6s; }
  .publications-hero-node-5 { animation-delay: -4.8s; }

  .publications-hero-spectrum-bar {
    animation: publications-hero-spectrum 3.8s ease-in-out infinite;
  }

  .publications-hero-spectrum-bar-2 { animation-delay: -0.55s; }
  .publications-hero-spectrum-bar-3 { animation-delay: -1.1s; }
  .publications-hero-spectrum-bar-4 { animation-delay: -1.65s; }
  .publications-hero-spectrum-bar-5 { animation-delay: -2.2s; }
  .publications-hero-spectrum-bar-6 { animation-delay: -2.75s; }

  .publications-hero-ambient-glow {
    animation: publications-hero-ambient 8s ease-in-out infinite;
  }

  @keyframes publications-hero-book-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes publications-hero-signal-travel {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes publications-hero-node-pulse {
    0%, 100% {
      opacity: 0.42;
      transform: scale(0.9);
      filter: drop-shadow(0 0 0 rgba(103, 232, 249, 0));
    }
    48%, 58% {
      opacity: 1;
      transform: scale(1.38);
      filter: drop-shadow(0 0 8px rgba(103, 232, 249, 0.82));
    }
  }

  @keyframes publications-hero-spectrum {
    0%, 100% { transform: scaleY(0.56); opacity: 0.48; }
    50% { transform: scaleY(1.1); opacity: 0.95; }
  }

  @keyframes publications-hero-ambient {
    0%, 100% { opacity: 0.08; transform: scale(0.84); }
    50% { opacity: 0.22; transform: scale(1.18); }
  }

  @media (prefers-reduced-motion: reduce) {
    .publications-hero-book,
    .publications-hero-signal,
    .publications-hero-node,
    .publications-hero-spectrum-bar,
    .publications-hero-ambient-glow {
      animation: none;
    }

    .publications-hero-signal {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
