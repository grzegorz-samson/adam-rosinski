---
import ExternalLink from "@lucide/astro/icons/external-link";
import { site } from "../data/site";
import { withBase } from "../utils/withBase";

const keywords = [
  "musical acoustics",
  "psychoacoustics",
  "auditory scene analysis",
  "sound technology",
  "recording practice",
  "music perception",
];
---

<section id="about-alt" class="alt-section">
  <div class="alt-bento">
    <div class="alt-copy">
      <h2>Research on listening developed between theory, technology, and recording practice.</h2>
      <p class="alt-lead">
        PhD <span class="alt-highlight">Adam Rosiński</span> is a Polish researcher in musical arts specialising in
        <span class="alt-highlight"> musical acoustics</span>, <span class="alt-highlight">psychoacoustics</span>, and
        <span class="alt-highlight"> sound technology</span>. His work focuses on <span class="alt-highlight">music perception</span>,
        <span class="alt-highlight"> auditory scene analysis</span>, and the use of contemporary digital tools in recording,
        analysis, and studio practice.
      </p>
      <p>
        He combines perspectives from music theory, cognitive science, and professional sound direction, linking
        listening research with spatial recording, acoustic environments, and educational use of audio technologies.
      </p>

      <div class="alt-keyword-row" aria-label="Key research areas">
        {keywords.map((keyword) => (
          <span>{keyword}</span>
        ))}
      </div>

      <a href={withBase(site.links.cvPdf)} target="_blank" rel="noreferrer" class="alt-cv-link alt-link-with-icon">
        <span>CV (PDF)</span>
        <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>

    <figure class="alt-profile-figure">
      <div class="alt-profile-frame">
        <img src={withBase("/images/adam-rosinski-portrait-masked.png")} alt="Adam Rosiński" class="alt-profile-image" loading="lazy" />
      </div>
    </figure>
  </div>
</section>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: start;
  }

  .alt-copy h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .alt-copy p {
    margin-top: 1rem;
    max-width: 52rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-lead {
    font-size: 1.04rem;
  }

  .alt-highlight {
    color: #fff;
    background:
      linear-gradient(90deg, rgba(86, 216, 255, 0.2), rgba(138, 125, 255, 0.18), rgba(255, 179, 71, 0.16));
    border-radius: 0.55rem;
    padding: 0.08rem 0.35rem 0.16rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .alt-keyword-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .alt-keyword-row span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.45rem 0.8rem;
    color: #d4d4d8;
    font-size: 0.86rem;
    line-height: 1;
  }

  .alt-cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
    color: #56d8ff;
    text-decoration: none;
  }

  .alt-cv-link:hover {
    color: #fff;
  }

  .alt-profile-figure {
    margin: 0;
  }

  .alt-profile-frame {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background:
      radial-gradient(circle at 60% 22%, rgba(86, 216, 255, 0.14), transparent 28%),
      radial-gradient(circle at 66% 26%, rgba(138, 125, 255, 0.18), transparent 36%),
      rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
    min-height: 28rem;
    padding: 1.2rem 1.2rem 0;
  }

  .alt-profile-image {
    display: block;
    width: min(100%, 24rem);
    height: auto;
    object-fit: contain;
    object-position: center bottom;
    filter: contrast(1.04) brightness(0.96) drop-shadow(0 24px 36px rgba(0, 0, 0, 0.28));
  }

  @media (max-width: 1080px) {
    .alt-bento {
      grid-template-columns: 1fr;
    }

    .alt-profile-frame {
      max-width: 32rem;
      min-height: 24rem;
    }
  }
</style>
