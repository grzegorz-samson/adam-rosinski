---
import ExternalLink from "@lucide/astro/icons/external-link";
import FileText from "@lucide/astro/icons/file-text";
import { site } from "../data/site";
import { withBase } from "../utils/withBase";
import BioPortraitField from "./BioPortraitField.astro";

const keywords = [
  "musical acoustics",
  "psychoacoustics",
  "auditory scene analysis",
  "sound technology",
  "recording practice",
  "music perception",
];
---

<section id="about-alt" class="alt-section">
  <div class="alt-bento">
    <div class="alt-copy">
      <h2 class="page-hero-title no-justify alt-about-title">Research on listening developed between theory, technology, and recording practice.</h2>
      <p class="alt-lead">
        PhD <span class="alt-highlight">Adam Rosiński</span> is a Polish researcher in musical arts specialising in
        <span class="alt-highlight"> musical acoustics</span>, <span class="alt-highlight">psychoacoustics</span>, and
        <span class="alt-highlight"> sound technology</span>. His work focuses on <span class="alt-highlight">music perception</span>,
        <span class="alt-highlight"> auditory scene analysis</span>, and the use of contemporary digital tools in recording,
        analysis, and studio practice.
      </p>
      <p>
        He combines perspectives from music theory, cognitive science, and professional sound direction, linking
        listening research with spatial recording, acoustic environments, and educational use of audio technologies.
      </p>

      <div class="alt-keyword-row" aria-label="Key research areas">
        {keywords.map((keyword) => (
          <span>{keyword}</span>
        ))}
      </div>

      <div class="alt-cv-card">
        <div class="alt-cv-card-copy">
          <span class="alt-cv-eyebrow">Curriculum vitae</span>
          <p>Full academic profile in PDF format, including publications, affiliations, teaching, and research activity.</p>
        </div>

        <a href={withBase(site.links.cvPdf)} target="_blank" rel="noreferrer" class="alt-cv-link alt-link-with-icon">
          <FileText size={16} stroke-width={1.9} aria-hidden="true" />
          <span>Open CV</span>
          <ExternalLink size={15} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>

    <figure class="alt-profile-figure alt-profile-card" aria-label="Portrait of Adam Rosiński">
      <picture class="alt-profile-photo">
        <source
          srcset={`${withBase("/images/bio/adam-rosinski-bio-portrait-720.webp")} 720w, ${withBase("/images/bio/adam-rosinski-bio-portrait-960.webp")} 960w`}
          sizes="(max-width: 760px) calc(100vw - 1.5rem), (max-width: 1120px) 50vw, 41vw"
          type="image/webp"
        />
        <img
          src={withBase("/images/bio/adam-rosinski-bio-portrait-720.webp")}
          alt="Adam Rosiński"
          width="720"
          height="960"
          loading="lazy"
        />
      </picture>
      <div class="alt-profile-orbit" aria-hidden="true">
        <BioPortraitField />
      </div>
      <picture class="alt-profile-silhouette" aria-hidden="true">
        <source
          srcset={`${withBase("/images/bio/adam-rosinski-bio-silhouette-720.webp")} 720w, ${withBase("/images/bio/adam-rosinski-bio-silhouette-960.webp")} 960w`}
          sizes="(max-width: 760px) calc(100vw - 1.5rem), (max-width: 1120px) 50vw, 41vw"
          type="image/webp"
        />
        <img src={withBase("/images/bio/adam-rosinski-bio-silhouette-720.webp")} alt="" width="720" height="960" loading="lazy" />
      </picture>
    </figure>
  </div>
</section>

<style>
  .alt-section {
    padding: var(--page-top-spacing-default) 0 4.5rem;
  }

  .alt-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: stretch;
  }

  .alt-about-title {
    max-width: 40rem;
    line-height: 1.02;
    text-align: left;
  }

  .alt-copy p {
    margin-top: 1rem;
    max-width: 52rem;
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-lead {
    font-size: 1.04rem;
  }

  .alt-highlight {
    color: #fff;
    background:
      linear-gradient(90deg, rgba(86, 216, 255, 0.2), rgba(138, 125, 255, 0.18), rgba(255, 179, 71, 0.16));
    border-radius: 0.55rem;
    padding: 0.08rem 0.35rem 0.16rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .alt-keyword-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .alt-keyword-row span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.45rem 0.8rem;
    color: #d4d4d8;
    font-size: 0.86rem;
    line-height: 1;
  }

  .alt-cv-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: end;
    margin-top: 1.9rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 12% 18%, rgba(86, 216, 255, 0.16), transparent 28%),
      radial-gradient(circle at 82% 22%, rgba(138, 125, 255, 0.16), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
    padding: 1.2rem 1.2rem 1.15rem;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
  }

  .alt-cv-card-copy p {
    margin: 0.65rem 0 0;
    max-width: 36rem;
    color: #b4b4be;
    line-height: 1.7;
  }

  .alt-cv-eyebrow {
    display: inline-block;
    margin-bottom: 0.65rem;
    color: #8ce9ff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .alt-cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    border: 1px solid rgba(86, 216, 255, 0.35);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(86, 216, 255, 0.16), rgba(138, 125, 255, 0.08));
    padding: 0.8rem 1.05rem;
    color: #dff9ff;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .alt-cv-link:hover {
    color: #fff;
    border-color: rgba(86, 216, 255, 0.56);
    background: linear-gradient(135deg, rgba(86, 216, 255, 0.22), rgba(138, 125, 255, 0.14));
    transform: translateY(-1px);
  }

  .alt-profile-figure {
    margin: 0;
    height: 100%;
  }

  .alt-profile-card {
    position: relative;
    height: 100%;
    min-height: 34rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 34px;
    background:
      radial-gradient(circle at 35% 26%, rgba(103, 232, 249, 0.15), transparent 28%),
      radial-gradient(circle at 80% 18%, rgba(251, 191, 36, 0.11), transparent 26%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(18px);
  }

  .alt-profile-photo {
    position: absolute;
    inset: 0;
  }

  .alt-profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
    filter: saturate(0.96) contrast(1.05);
  }

  .alt-profile-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(5, 7, 11, 0.08), rgba(5, 7, 11, 0.58)),
      radial-gradient(circle at 82% 18%, rgba(103, 232, 249, 0.18), transparent 32%);
    pointer-events: none;
  }

  .alt-profile-orbit {
    position: absolute;
    right: -8%;
    top: -4%;
    z-index: 2;
    width: 62%;
    height: auto;
    opacity: 0.54;
    mix-blend-mode: screen;
    pointer-events: none;
    filter: drop-shadow(0 0 18px rgba(103, 232, 249, 0.08));
    transition: opacity 220ms ease;
  }

  .alt-profile-card:hover .alt-profile-orbit {
    opacity: 0.66;
  }

  .alt-profile-silhouette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .alt-profile-silhouette img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
    filter: saturate(1.02) contrast(1.04);
  }

  @media (max-width: 1080px) {
    .alt-bento {
      grid-template-columns: 1fr;
    }

    .alt-profile-card {
      max-width: 32rem;
      min-height: 24rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alt-profile-orbit {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .alt-cv-card {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .alt-cv-link {
      justify-self: start;
    }
  }
</style>
