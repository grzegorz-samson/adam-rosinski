---
import { site } from "../data/site";
---
<footer class="border-t border-white/8 py-8">
  <div class="shell flex flex-col gap-4 text-sm text-zinc-400 md:flex-row md:items-center md:justify-between">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <div class="flex flex-wrap gap-4">
      <a href="/alternative" class="hover:text-white">Alternative</a>
      <a href={site.links.uwm} target="_blank" rel="noreferrer" class="hover:text-white">UWM</a>
      <a href={site.links.scholar} target="_blank" rel="noreferrer" class="hover:text-white">Scholar</a>
      <a href={site.links.sciprofiles} target="_blank" rel="noreferrer" class="hover:text-white">SciProfiles</a>
    </div>
  </div>
</footer>
