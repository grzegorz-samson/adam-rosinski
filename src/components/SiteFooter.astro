---
import { getContent } from "../data/content";
import { localizedPath } from "../utils/i18n";

const content = getContent("en");
---

<footer class="site-footer">
  <div class="site-shell site-footer-inner">
    <div>
      <p class="site-eyebrow">Research website</p>
      <p class="site-footer-title">{content.site.displayName}</p>
      <p class="site-footer-copy">{content.site.institution}</p>
    </div>

    <div class="site-footer-links">
      <a href={localizedPath("/")}>Home</a>
      <a href={localizedPath("/research")}>Research</a>
      <a href={localizedPath("/publications")}>Publications</a>
      <a href={localizedPath("/contact")}>Contact</a>
      {content.profiles.map((profile) => (
        <a href={profile.href} target="_blank" rel="noreferrer">{profile.label}</a>
      ))}
    </div>
  </div>
</footer>
