---
import Volume2 from "@lucide/astro/icons/volume-2";
import VolumeX from "@lucide/astro/icons/volume-x";
---

<section id="audio-demo-alt" class="alt-section">
  <div class="alt-module audio-visualizer-module">
    <div class="alt-head">
      <div>
        <p class="alt-kicker">Audio demonstrator</p>
        <h3>Audio generator</h3>
      </div>

      <button class="alt-button alt-button-primary alt-demo-toggle" type="button" aria-label="Enable sound">
        <span class="alt-demo-icon alt-demo-icon-muted" aria-hidden="true">
          <VolumeX size={18} stroke-width={1.9} />
        </span>
        <span class="alt-demo-icon alt-demo-icon-live is-hidden" aria-hidden="true">
          <Volume2 size={18} stroke-width={1.9} />
        </span>
      </button>
    </div>

    <div class="alt-dual-grid">
      <section class="alt-panel-visual">
        <p class="alt-kicker">Waveform</p>
        <div class="alt-frame">
          <canvas class="alt-canvas-waveform" aria-hidden="true"></canvas>
        </div>
      </section>

      <section class="alt-panel-visual">
        <p class="alt-kicker">Frequency spectrum</p>
        <div class="alt-frame">
          <canvas class="alt-canvas-frequency" aria-hidden="true"></canvas>
        </div>
      </section>
    </div>

    <div class="alt-footer">
      <p>
        The demonstrator renders two parallel representations of the same signal: amplitude over time on the left,
        and frequency-energy distribution on the right. The visualization is always active, while the button starts playback.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  class AlternativeAudioVisualizer {
    constructor(container) {
      this.container = container;
      this.waveformCanvas = container.querySelector(".alt-canvas-waveform");
      this.waveformCtx = this.waveformCanvas?.getContext("2d");
      this.frequencyCanvas = container.querySelector(".alt-canvas-frequency");
      this.frequencyCtx = this.frequencyCanvas?.getContext("2d");
      this.demoToggle = container.querySelector(".alt-demo-toggle");
      this.mutedIcon = container.querySelector(".alt-demo-icon-muted");
      this.liveIcon = container.querySelector(".alt-demo-icon-live");
      this.audioCtx = null;
      this.oscillator = null;
      this.gain = null;
      this.audioEnabled = false;
      this.phase = 0;
      this.currentFrequency = 220;
      this.targetFrequency = 260;
      this.lastFrameTime = 0;
      this.lastModulationAt = 0;
      this.raf = 0;

      this.resizeCanvases();
      this.bind();
      this.setToggleState(false);
      this.startVisuals();
      window.addEventListener("resize", () => this.resizeCanvases());
      window.addEventListener("beforeunload", () => this.destroy(), { once: true });
    }

    bind() {
      this.demoToggle?.addEventListener("click", async () => {
        if (!this.audioEnabled) {
          await this.enableAudio();
          this.setToggleState(true);
        } else {
          this.disableAudio();
          this.setToggleState(false);
        }
      });
    }

    setToggleState(isEnabled) {
      this.demoToggle?.setAttribute("aria-label", isEnabled ? "Disable sound" : "Enable sound");
      this.mutedIcon?.classList.toggle("is-hidden", isEnabled);
      this.liveIcon?.classList.toggle("is-hidden", !isEnabled);
    }

    resizeCanvas(canvas, ctx) {
      if (!(canvas instanceof HTMLCanvasElement) || !ctx) return;
      const ratio = window.devicePixelRatio || 1;
      canvas.width = canvas.offsetWidth * ratio;
      canvas.height = canvas.offsetHeight * ratio;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    }

    resizeCanvases() {
      this.resizeCanvas(this.waveformCanvas, this.waveformCtx);
      this.resizeCanvas(this.frequencyCanvas, this.frequencyCtx);
    }

    startVisuals() {
      if (this.raf) return;
      this.raf = requestAnimationFrame((time) => this.draw(time));
    }

    async enableAudio() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;

      if (!this.audioCtx) {
        this.audioCtx = new AudioContextClass();
      }

      if (this.audioCtx.state === "suspended") {
        await this.audioCtx.resume();
      }

      if (this.oscillator) return;

      this.oscillator = this.audioCtx.createOscillator();
      this.gain = this.audioCtx.createGain();
      this.oscillator.type = "sine";
      this.oscillator.frequency.value = this.currentFrequency;
      this.gain.gain.value = 0.05;
      this.oscillator.connect(this.gain);
      this.gain.connect(this.audioCtx.destination);
      this.oscillator.start();
      this.audioEnabled = true;
    }

    disableAudio() {
      this.audioEnabled = false;
      this.oscillator?.stop();
      this.oscillator?.disconnect();
      this.gain?.disconnect();
      this.oscillator = null;
      this.gain = null;
    }

    updateSignal(time, deltaSeconds) {
      if (!this.lastModulationAt || time - this.lastModulationAt > 900) {
        this.targetFrequency = 180 + Math.random() * 360;
        this.lastModulationAt = time;
      }

      const smoothing = Math.min(deltaSeconds * 2.4, 1);
      this.currentFrequency += (this.targetFrequency - this.currentFrequency) * smoothing;
      this.phase += deltaSeconds * this.currentFrequency * Math.PI * 2;

      if (this.audioEnabled && this.oscillator && this.audioCtx) {
        this.oscillator.frequency.setTargetAtTime(this.currentFrequency, this.audioCtx.currentTime, 0.12);
      }
    }

    drawWaveform(width, height) {
      if (!this.waveformCtx) return;

      this.waveformCtx.fillStyle = "rgba(10,13,20,0.24)";
      this.waveformCtx.fillRect(0, 0, width, height);
      this.waveformCtx.strokeStyle = "#56d8ff";
      this.waveformCtx.lineWidth = 2;
      this.waveformCtx.beginPath();

      const samples = 256;
      let x = 0;
      for (let i = 0; i < samples; i += 1) {
        const progress = i / (samples - 1);
        const angle = this.phase + progress * ((this.currentFrequency / 140) * Math.PI * 2);
        const harmonic = Math.sin(angle * 2.02) * 0.18;
        const overtone = Math.sin(angle * 3.1) * 0.08;
        const value = Math.sin(angle) * 0.72 + harmonic + overtone;
        const y = height * 0.5 + value * height * 0.28;
        if (i === 0) this.waveformCtx.moveTo(x, y);
        else this.waveformCtx.lineTo(x, y);
        x += width / (samples - 1);
      }

      this.waveformCtx.stroke();
    }

    drawSpectrum(width, height) {
      if (!this.frequencyCtx) return;

      this.frequencyCtx.fillStyle = "rgba(10,13,20,0.24)";
      this.frequencyCtx.fillRect(0, 0, width, height);

      const bars = 44;
      const fundamental = Math.min(this.currentFrequency / 900, 1);
      const secondary = Math.min(fundamental * 2.1, 1);
      const tertiary = Math.min(fundamental * 3.15, 1);
      const barWidth = width / bars;

      for (let i = 0; i < bars; i += 1) {
        const t = i / (bars - 1);
        const peakA = Math.exp(-Math.pow((t - fundamental) / 0.07, 2)) * 0.95;
        const peakB = Math.exp(-Math.pow((t - secondary) / 0.09, 2)) * 0.55;
        const peakC = Math.exp(-Math.pow((t - tertiary) / 0.11, 2)) * 0.32;
        const shimmer = 0.08 + (Math.sin(this.phase * 0.2 + i * 0.7) + 1) * 0.04;
        const level = Math.min(peakA + peakB + peakC + shimmer, 1);
        const barHeight = Math.max(level * height, 8);
        this.frequencyCtx.fillStyle = `rgba(${120 + level * 120}, ${105 + level * 40}, 80, 0.92)`;
        this.frequencyCtx.fillRect(i * barWidth, height - barHeight, Math.max(barWidth - 3, 4), barHeight);
      }
    }

    draw(time) {
      const deltaSeconds = this.lastFrameTime ? (time - this.lastFrameTime) / 1000 : 0.016;
      this.lastFrameTime = time;
      this.updateSignal(time, deltaSeconds);

      if (this.waveformCtx && this.waveformCanvas instanceof HTMLCanvasElement) {
        const width = this.waveformCanvas.getBoundingClientRect().width;
        const height = this.waveformCanvas.getBoundingClientRect().height;
        this.drawWaveform(width, height);
      }

      if (this.frequencyCtx && this.frequencyCanvas instanceof HTMLCanvasElement) {
        const width = this.frequencyCanvas.getBoundingClientRect().width;
        const height = this.frequencyCanvas.getBoundingClientRect().height;
        this.drawSpectrum(width, height);
      }

      this.raf = requestAnimationFrame((nextTime) => this.draw(nextTime));
    }

    destroy() {
      if (this.raf) cancelAnimationFrame(this.raf);
      this.disableAudio();
    }
  }

  const initAlternativeAudioVisualizers = () => {
    document.querySelectorAll(".audio-visualizer-module").forEach((container) => {
      if (container.dataset.bound === "true") return;
      container.dataset.bound = "true";
      new AlternativeAudioVisualizer(container);
    });
  };

  initAlternativeAudioVisualizers();
</script>

<style>
  .alt-section {
    padding: 4.5rem 0;
  }

  .alt-module {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.34);
  }

  .alt-head,
  .alt-footer {
    display: grid;
    gap: 1rem;
  }

  .alt-head {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .alt-kicker {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #56d8ff;
  }

  .alt-head h3,
  .alt-panel-visual h3 {
    margin-top: 0.9rem;
    color: #fff;
    font-size: 1.32rem;
    line-height: 1.25;
  }

  .alt-dual-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .alt-frame {
    position: relative;
    height: 15rem;
    margin-top: 1.4rem;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent), #090d14;
  }

  .alt-canvas-waveform,
  .alt-canvas-frequency {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .alt-footer {
    margin-top: 1.2rem;
    align-items: start;
  }

  .alt-footer p {
    color: #a1a1aa;
    line-height: 1.85;
  }

  .alt-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  .alt-button-primary {
    background: #fff;
    color: #05070b;
  }

  .alt-demo-toggle {
    justify-self: end;
    width: auto;
    min-width: 3.25rem;
    min-height: 3.25rem;
    padding-inline: 0.95rem;
    white-space: nowrap;
  }

  .alt-demo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .alt-demo-icon.is-hidden {
    display: none;
  }

  @media (max-width: 1080px) {
    .alt-head,
    .alt-footer {
      align-items: start;
    }

    .alt-head {
      grid-template-columns: 1fr;
    }

    .alt-demo-toggle {
      justify-self: start;
    }

    .alt-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
