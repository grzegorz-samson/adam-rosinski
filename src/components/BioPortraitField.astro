<svg
  class="bio-portrait-field"
  viewBox="0 0 720 720"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="bio-portrait-field-halo" cx="50%" cy="42%" r="58%">
      <stop offset="0" stop-color="#67e8f9" stop-opacity="0.28"></stop>
      <stop offset="0.45" stop-color="#8b7dff" stop-opacity="0.11"></stop>
      <stop offset="1" stop-color="#05070b" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="bio-portrait-field-line" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#67e8f9" stop-opacity="0.95"></stop>
      <stop offset="0.55" stop-color="#c4b5fd" stop-opacity="0.65"></stop>
      <stop offset="1" stop-color="#fbbf24" stop-opacity="0.72"></stop>
    </linearGradient>
    <filter id="bio-portrait-field-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="7"></feGaussianBlur>
    </filter>
  </defs>

  <circle class="bio-portrait-field-halo" cx="360" cy="360" r="305" fill="url(#bio-portrait-field-halo)"></circle>

  <g class="bio-portrait-field-rings" fill="none" stroke="url(#bio-portrait-field-line)" stroke-linecap="round">
    <circle class="bio-portrait-field-ring bio-portrait-field-ring-1" cx="360" cy="360" r="265" stroke-opacity="0.18" stroke-width="2" stroke-dasharray="4 18"></circle>
    <circle class="bio-portrait-field-ring bio-portrait-field-ring-2" cx="360" cy="360" r="218" stroke-opacity="0.22" stroke-width="1.5" stroke-dasharray="2 13"></circle>
    <circle class="bio-portrait-field-ring bio-portrait-field-ring-3" cx="360" cy="360" r="168" stroke-opacity="0.28" stroke-width="1.3"></circle>
    <circle class="bio-portrait-field-ring bio-portrait-field-ring-4" cx="360" cy="360" r="112" stroke-opacity="0.36" stroke-width="1.2" stroke-dasharray="1 9"></circle>
  </g>

  <g fill="none" stroke="url(#bio-portrait-field-line)" stroke-linecap="round">
