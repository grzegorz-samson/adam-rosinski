  <circle class="bio-portrait-field-core-glow" cx="360" cy="360" r="44" fill="#67e8f9" opacity="0.18" filter="url(#bio-portrait-field-soft)"></circle>
  <circle class="bio-portrait-field-core" cx="360" cy="360" r="9" fill="#fff" opacity="0.85"></circle>
