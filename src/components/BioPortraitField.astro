    <circle class="bio-portrait-field-node bio-portrait-field-node-2" cx="312" cy="228" r="4"></circle>
    <circle class="bio-portrait-field-node bio-portrait-field-node-3" cx="461" cy="255" r="5"></circle>
    <circle class="bio-portrait-field-node bio-portrait-field-node-4" cx="587" cy="363" r="4"></circle>
    <circle class="bio-portrait-field-node bio-portrait-field-node-5" cx="506" cy="451" r="5"></circle>
