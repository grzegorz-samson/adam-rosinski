<style>
  .bio-portrait-field {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bio-portrait-field-rings {
    transform-box: fill-box;
    transform-origin: center;
    animation: bio-portrait-field-rotate 46s linear infinite;
  }

  .bio-portrait-field-ring,
  .bio-portrait-field-node,
  .bio-portrait-field-core,
  .bio-portrait-field-core-glow,
  .bio-portrait-field-halo {
    transform-box: fill-box;
    transform-origin: center;
  }

  .bio-portrait-field-ring {
    animation: bio-portrait-field-ring-breathe 9s ease-in-out infinite;
  }

  .bio-portrait-field-ring-2 { animation-delay: -2.25s; }
  .bio-portrait-field-ring-3 { animation-delay: -4.5s; }
  .bio-portrait-field-ring-4 { animation-delay: -6.75s; }

  .bio-portrait-field-signal {
    stroke-dasharray: 0.2 0.8;
    stroke-dashoffset: 1;
    animation: bio-portrait-field-signal-travel 15s linear infinite;
  }

  .bio-portrait-field-signal-2 {
    animation-duration: 19s;
    animation-direction: reverse;
  }

  .bio-portrait-field-signal-3 {
    animation-duration: 22s;
  }

  .bio-portrait-field-node {
    opacity: 0.42;
    animation: bio-portrait-field-node-pulse 7s ease-in-out infinite;
  }

  .bio-portrait-field-node-2 { animation-delay: -1s; }
  .bio-portrait-field-node-3 { animation-delay: -2s; }
  .bio-portrait-field-node-4 { animation-delay: -3s; }
  .bio-portrait-field-node-5 { animation-delay: -4s; }
  .bio-portrait-field-node-6 { animation-delay: -5s; }
  .bio-portrait-field-node-7 { animation-delay: -6s; }

  .bio-portrait-field-halo,
  .bio-portrait-field-core-glow {
    animation: bio-portrait-field-halo-pulse 10s ease-in-out infinite;
  }

  .bio-portrait-field-core {
    animation: bio-portrait-field-core-pulse 5.4s ease-in-out infinite;
  }

  @keyframes bio-portrait-field-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes bio-portrait-field-ring-breathe {
    0%, 100% { opacity: 0.58; transform: scale(0.992); }
    50% { opacity: 1; transform: scale(1.012); }
  }

  @keyframes bio-portrait-field-signal-travel {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes bio-portrait-field-node-pulse {
    0%, 100% {
      opacity: 0.34;
      transform: scale(0.86);
      filter: drop-shadow(0 0 0 rgba(103, 232, 249, 0));
    }
    46%, 58% {
      opacity: 1;
      transform: scale(1.42);
      filter: drop-shadow(0 0 9px rgba(103, 232, 249, 0.86));
    }
  }

  @keyframes bio-portrait-field-halo-pulse {
    0%, 100% { opacity: 0.72; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  @keyframes bio-portrait-field-core-pulse {
    0%, 100% {
      opacity: 0.72;
      transform: scale(0.88);
      filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.34));
    }
    50% {
      opacity: 1;
      transform: scale(1.22);
      filter: drop-shadow(0 0 11px rgba(103, 232, 249, 0.82));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-portrait-field-rings,
    .bio-portrait-field-ring,
    .bio-portrait-field-signal,
    .bio-portrait-field-node,
    .bio-portrait-field-halo,
    .bio-portrait-field-core-glow,
    .bio-portrait-field-core {
      animation: none;
    }

    .bio-portrait-field-signal {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
