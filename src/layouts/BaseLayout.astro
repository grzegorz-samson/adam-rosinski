---
import "../styles/global.css";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "Adam Rosinski - Research and audio practice",
  description = "Research website focused on auditory perception, recording, spatial listening, and sound technologies.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
