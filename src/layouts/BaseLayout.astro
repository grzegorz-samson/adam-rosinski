---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Adam Rosiński — Sound Director / Researcher",
  description = "Landing page badacza i reżysera dźwięku: percepcja, przestrzeń, rejestracja wielokanałowa i nowe technologie.",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
