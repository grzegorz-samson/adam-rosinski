---
import BaseLayout from "./BaseLayout.astro";
import AudioWaveform from "@lucide/astro/icons/audio-waveform";
import Disc3 from "@lucide/astro/icons/disc-3";
import UserRound from "@lucide/astro/icons/user-round";
import UserRoundPlus from "@lucide/astro/icons/user-round-plus";
import Radar from "@lucide/astro/icons/radar";
import Headphones from "@lucide/astro/icons/headphones";
import BookOpen from "@lucide/astro/icons/book-open";
import Newspaper from "@lucide/astro/icons/newspaper";
import Mail from "@lucide/astro/icons/mail";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import { navigation, site } from "../data/site";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const { title, description, activePath = "/" } = Astro.props;

function isActive(href: string) {
  return activePath === href;
}

function getNavKey(href: string) {
  return href.split("#")[0];
}

const navIcons = {
  "/about": UserRound,
  "/bio-plus": UserRoundPlus,
  "/work-areas": Radar,
  "/audio-demonstrator": Headphones,
  "/publications": BookOpen,
  "/publications#editorial": Newspaper,
  "/editorial-roles": Newspaper,
  "/music-label": Disc3,
  "/contact": Mail,
};

const navThemes = {
  "/about": "cyan",
  "/bio-plus": "red",
  "/work-areas": "emerald",
  "/audio-demonstrator": "amber",
  "/publications": "violet",
  "/publications#editorial": "slate",
  "/editorial-roles": "slate",
  "/music-label": "cyan",
  "/contact": "cyan",
};

const mobileNavigation = [...navigation, { label: "Contact", href: "/contact" }];
---

<BaseLayout title={title} description={description} bodyClass="alt-lab">
  <header class="alt-nav" data-mobile-nav-root>
    <div class="alt-shell alt-nav-inner">
      <a href={withBase("/")} class="alt-wordmark">
        <AudioWaveform size={16} stroke-width={1.75} aria-hidden="true" />
        <span>{site.name}</span>
      </a>

      <button
        type="button"
        class="alt-nav-toggle"
        aria-expanded="false"
        aria-controls="alt-mobile-nav-panel"
        aria-label="Open navigation"
        data-mobile-nav-toggle
      >
        <span class="alt-nav-toggle-icon alt-nav-toggle-icon-menu" aria-hidden="true">
          <Menu size={18} stroke-width={1.9} />
        </span>
        <span class="alt-nav-toggle-icon alt-nav-toggle-icon-close" aria-hidden="true">
          <X size={18} stroke-width={1.9} />
        </span>
        <span class="alt-nav-toggle-label">Menu</span>
      </button>

      <nav class="alt-nav-links" aria-label="Site navigation">
        {navigation.map((item) => {
          const navKey = getNavKey(item.href);
          const Icon =
            navIcons[item.href as keyof typeof navIcons] ??
            navIcons[navKey as keyof typeof navIcons];

          return (
            <a
              href={withBase(item.href)}
              class:list={[
                "alt-nav-link",
                `alt-nav-link-${
                  navThemes[item.href as keyof typeof navThemes] ??
                  navThemes[navKey as keyof typeof navThemes] ??
                  "slate"
                }`,
                isActive(item.href) && "is-active",
              ]}
            >
              <Icon size={14} stroke-width={1.75} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <div class="alt-nav-actions">
        <a href={withBase("/contact")} class="alt-nav-cta">
          <Mail size={15} stroke-width={1.75} aria-hidden="true" />
          <span>Contact</span>
        </a>
      </div>
    </div>

  </header>

  <div class="alt-nav-mobile-layer" data-mobile-nav-layer>
    <button
      type="button"
      class="alt-nav-overlay"
      aria-label="Close navigation"
      hidden
      tabindex="-1"
      data-mobile-nav-overlay
    ></button>

    <div
      id="alt-mobile-nav-panel"
      class="alt-nav-mobile-panel alt-shell"
      hidden
      data-mobile-nav-panel
    >
      <nav class="alt-nav-mobile-links" aria-label="Mobile site navigation">
        {mobileNavigation.map((item) => {
          const navKey = getNavKey(item.href);
          const Icon =
            navIcons[item.href as keyof typeof navIcons] ??
            navIcons[navKey as keyof typeof navIcons];

          return (
            <a
              href={withBase(item.href)}
              class:list={[
                "alt-nav-mobile-link",
                `alt-nav-link-${
                  navThemes[item.href as keyof typeof navThemes] ??
                  navThemes[navKey as keyof typeof navThemes] ??
                  "slate"
                }`,
                isActive(item.href) && "is-active",
              ]}
              data-mobile-nav-link
            >
              <Icon size={16} stroke-width={1.75} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <main class="alt-shell">
    <slot />
  </main>
</BaseLayout>

<script>
  const MOBILE_NAV_BREAKPOINT = 920;

  function setupAltMobileNav() {
    const root = document.querySelector("[data-mobile-nav-root]");
    if (!(root instanceof HTMLElement)) return;

    const toggle = root.querySelector("[data-mobile-nav-toggle]");
    const panel = document.querySelector("[data-mobile-nav-panel]");
    const overlay = document.querySelector("[data-mobile-nav-overlay]");
    const links = document.querySelectorAll("[data-mobile-nav-link]");

    if (
      !(toggle instanceof HTMLButtonElement) ||
      !(panel instanceof HTMLElement) ||
      !(overlay instanceof HTMLButtonElement)
    ) {
      return;
    }

    const updatePanelOffset = () => {
      document.documentElement.style.setProperty(
        "--alt-mobile-nav-offset",
        `${root.getBoundingClientRect().bottom + 10}px`,
      );
    };

    const setOpen = (isOpen) => {
      root.dataset.mobileNavOpen = isOpen ? "true" : "false";
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      if (isOpen) updatePanelOffset();
      panel.hidden = !isOpen;
      overlay.hidden = !isOpen;
      document.body.classList.toggle("alt-mobile-nav-open", isOpen);
    };

    const close = () => setOpen(false);
    const toggleOpen = () => setOpen(root.dataset.mobileNavOpen !== "true");

    toggle.addEventListener("click", toggleOpen);
    overlay.addEventListener("click", close);

    links.forEach((link) => {
      link.addEventListener("click", close);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.dataset.mobileNavOpen === "true") {
        close();
        toggle.focus();
      }
    });

    const mediaQuery = window.matchMedia(`(min-width: ${MOBILE_NAV_BREAKPOINT + 1}px)`);
    const handleViewportChange = () => {
      if (mediaQuery.matches) close();
      if (!panel.hidden) updatePanelOffset();
    };

    if (typeof mediaQuery.addEventListener === "function") {
      mediaQuery.addEventListener("change", handleViewportChange);
    } else {
      mediaQuery.addListener(handleViewportChange);
    }

    window.addEventListener("resize", handleViewportChange);
    window.addEventListener("scroll", () => {
      if (!panel.hidden) updatePanelOffset();
    });

    setOpen(false);
  }

  setupAltMobileNav();
</script>

<style is:global>
  body.alt-lab {
    background-image:
      radial-gradient(circle at top, rgba(86, 216, 255, 0.08), transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255, 179, 71, 0.06), transparent 22%),
      linear-gradient(180deg, #05070b 0%, #0a0d14 50%, #05070b 100%);
    color: #d4d4d8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  body.alt-lab::before {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: none;
    opacity: 0.9;
  }

  body.alt-mobile-nav-open {
    overflow: hidden;
  }

  .alt-shell {
    width: min(1280px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .alt-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(5, 7, 11, 0.76);
    backdrop-filter: blur(16px);
  }

  .alt-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
  }

  .alt-wordmark,
  .alt-nav-link,
  .alt-nav-cta,
  .alt-nav-toggle,
  .alt-nav-mobile-link {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-wordmark,
  .alt-nav-link,
  .alt-nav-cta,
  .alt-nav-toggle,
  .alt-nav-mobile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .alt-wordmark {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-links,
  .alt-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.78rem;
  }

  .alt-nav-toggle,
  .alt-nav-overlay,
  .alt-nav-mobile-panel {
    display: none;
  }

  .alt-nav-mobile-layer {
    position: relative;
    z-index: 44;
  }

  .alt-nav-toggle {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background:
      linear-gradient(180deg, rgba(17, 24, 39, 0.92), rgba(8, 12, 20, 0.92)),
      rgba(5, 7, 11, 0.88);
    color: rgba(228, 232, 240, 0.96);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    padding: 0.8rem 0.95rem;
    border-radius: 999px;
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .alt-nav-toggle:hover {
    color: #fff;
    border-color: rgba(134, 227, 255, 0.32);
    transform: translateY(-1px);
    box-shadow:
      0 0 18px rgba(86, 216, 255, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .alt-nav-toggle:focus-visible,
  .alt-nav-mobile-link:focus-visible,
  .alt-nav-link:focus-visible,
  .alt-nav-cta:focus-visible,
  .alt-wordmark:focus-visible {
    outline: 2px solid rgba(134, 227, 255, 0.9);
    outline-offset: 3px;
  }

  .alt-nav-toggle-icon-close {
    display: none;
  }

  .alt-nav[data-mobile-nav-open="true"] .alt-nav-toggle-icon-menu {
    display: none;
  }

  .alt-nav[data-mobile-nav-open="true"] .alt-nav-toggle-icon-close {
    display: inline-flex;
  }

  .alt-nav-link {
    color: #c6cad5;
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.42rem 0.2rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-link:hover,
  .alt-nav-link.is-active {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
  }

  .alt-nav-link-cyan {
    color: rgba(134, 227, 255, 0.94);
  }

  .alt-nav-link-emerald {
    color: rgba(110, 236, 188, 0.94);
  }

  .alt-nav-link-amber {
    color: rgba(255, 199, 112, 0.95);
  }

  .alt-nav-link-violet {
    color: rgba(182, 173, 255, 0.95);
  }

  .alt-nav-link-slate {
    color: rgba(208, 214, 228, 0.94);
  }

  .alt-nav-link-red {
    color: rgba(255, 112, 112, 0.95);
  }

  .alt-nav-link-cyan:hover,
  .alt-nav-link-cyan.is-active {
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.34),
      0 0 26px rgba(86, 216, 255, 0.18);
  }

  .alt-nav-link-emerald:hover,
  .alt-nav-link-emerald.is-active {
    text-shadow:
      0 0 14px rgba(52, 211, 153, 0.34),
      0 0 26px rgba(52, 211, 153, 0.18);
  }

  .alt-nav-link-amber:hover,
  .alt-nav-link-amber.is-active {
    text-shadow:
      0 0 14px rgba(255, 179, 71, 0.34),
      0 0 26px rgba(255, 179, 71, 0.18);
  }

  .alt-nav-link-violet:hover,
  .alt-nav-link-violet.is-active {
    text-shadow:
      0 0 14px rgba(138, 125, 255, 0.34),
      0 0 26px rgba(138, 125, 255, 0.18);
  }

  .alt-nav-link-slate:hover,
  .alt-nav-link-slate.is-active {
    text-shadow:
      0 0 14px rgba(161, 161, 170, 0.26),
      0 0 26px rgba(161, 161, 170, 0.14);
  }

  .alt-nav-link-red:hover,
  .alt-nav-link-red.is-active {
    text-shadow:
      0 0 14px rgba(248, 113, 113, 0.4),
      0 0 28px rgba(220, 38, 38, 0.22);
  }

  .alt-nav-link svg,
  .alt-nav-cta svg,
  .alt-wordmark svg,
  .alt-nav-toggle svg,
  .alt-nav-mobile-link svg {
    flex: 0 0 auto;
    opacity: 0.78;
  }

  .alt-nav-link:hover svg,
  .alt-nav-link.is-active svg,
  .alt-nav-cta svg,
  .alt-nav-cta:hover svg,
  .alt-nav-mobile-link:hover svg,
  .alt-nav-mobile-link.is-active svg {
    opacity: 1;
  }

  .alt-wordmark:hover {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.28),
      0 0 24px rgba(86, 216, 255, 0.14);
  }

  .alt-wordmark:hover svg {
    opacity: 1;
  }

  .alt-nav-cta {
    color: rgba(134, 227, 255, 0.94);
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.42rem 0.2rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-cta:hover {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.34),
      0 0 26px rgba(86, 216, 255, 0.18);
  }

  @media (max-width: 1180px) {
    .alt-nav-inner {
      gap: 0.9rem;
    }

    .alt-nav-links,
    .alt-nav-actions {
      gap: 0.58rem;
    }

    .alt-nav-link,
    .alt-nav-cta {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 920px) {
    .alt-shell {
      width: min(100% - 1.5rem, 1280px);
    }

    .alt-nav-links,
    .alt-nav-actions {
      display: none;
    }

    .alt-nav-toggle {
      display: inline-flex;
      justify-content: center;
      flex: 0 0 auto;
    }

    .alt-nav-mobile-panel {
      position: fixed;
      top: var(--alt-mobile-nav-offset, 5rem);
      left: 50%;
      transform: translateX(-50%);
      z-index: 45;
      display: block;
      width: min(100% - 1.5rem, 1280px);
      padding: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 1.35rem;
      background:
        linear-gradient(180deg, rgba(13, 18, 30, 0.98), rgba(7, 10, 18, 0.98)),
        rgba(5, 7, 11, 0.97);
      box-shadow:
        0 22px 50px rgba(0, 0, 0, 0.42),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(20px);
    }

    .alt-nav-mobile-panel[hidden] {
      display: none;
    }

    .alt-nav-mobile-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .alt-nav-mobile-link {
      width: 100%;
      min-width: 0;
      justify-content: flex-start;
      padding: 0.95rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.025);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-decoration: none;
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        background-color 180ms ease,
        color 180ms ease,
        text-shadow 180ms ease;
    }

    .alt-nav-mobile-link:hover,
    .alt-nav-mobile-link.is-active {
      transform: translateY(-1px);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.05);
    }

    .alt-nav-overlay {
      position: fixed;
      inset: 0;
      z-index: 44;
      display: block;
      border: 0;
      background:
        radial-gradient(circle at top, rgba(86, 216, 255, 0.12), transparent 34%),
        rgba(3, 5, 10, 0.72);
      backdrop-filter: blur(6px);
      cursor: pointer;
    }

    .alt-nav-overlay[hidden] {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .alt-nav-inner {
      padding: 0.9rem 0;
    }

    .alt-wordmark {
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      min-width: 0;
    }

    .alt-wordmark span {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .alt-nav-toggle {
      padding: 0.76rem 0.88rem;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
    }

    .alt-nav-mobile-panel {
      width: min(100% - 1rem, 1280px);
      padding: 0.7rem;
      border-radius: 1.15rem;
    }

    .alt-nav-mobile-link {
      font-size: 0.88rem;
      padding: 0.9rem 0.92rem;
    }
  }

  @media (max-width: 420px) {
    .alt-nav-inner {
      gap: 0.7rem;
    }

    .alt-wordmark {
      font-size: 0.73rem;
      letter-spacing: 0.12em;
    }

    .alt-nav-toggle-label {
      display: none;
    }

    .alt-nav-mobile-links {
      grid-template-columns: 1fr;
    }
  }
</style>
