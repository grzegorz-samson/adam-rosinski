---
import BaseLayout from "./BaseLayout.astro";
import AudioWaveform from "@lucide/astro/icons/audio-waveform";
import Disc3 from "@lucide/astro/icons/disc-3";
import UserRound from "@lucide/astro/icons/user-round";
import Radar from "@lucide/astro/icons/radar";
import Headphones from "@lucide/astro/icons/headphones";
import BookOpen from "@lucide/astro/icons/book-open";
import Newspaper from "@lucide/astro/icons/newspaper";
import Mail from "@lucide/astro/icons/mail";
import { navigation, site } from "../data/site";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const { title, description, activePath = "/" } = Astro.props;

function isActive(href: string) {
  return activePath === href;
}

const navIcons = {
  "/about": UserRound,
  "/work-areas": Radar,
  "/audio-demonstrator": Headphones,
  "/publications": BookOpen,
  "/editorial-roles": Newspaper,
  "/music-label": Disc3,
  "/contact": Mail,
};

const navThemes = {
  "/about": "cyan",
  "/work-areas": "emerald",
  "/audio-demonstrator": "amber",
  "/publications": "violet",
  "/editorial-roles": "slate",
  "/music-label": "cyan",
};
---

<BaseLayout title={title} description={description} bodyClass="alt-lab">
  <header class="alt-nav">
    <div class="alt-shell alt-nav-inner">
      <a href={withBase("/")} class="alt-wordmark">
        <AudioWaveform size={16} stroke-width={1.75} aria-hidden="true" />
        <span>{site.name}</span>
      </a>

      <nav class="alt-nav-links" aria-label="Site navigation">
        {navigation.map((item) => {
          const Icon = navIcons[item.href as keyof typeof navIcons];

          return (
            <a
              href={withBase(item.href)}
              class:list={[
                "alt-nav-link",
                `alt-nav-link-${navThemes[item.href as keyof typeof navThemes] ?? "slate"}`,
                isActive(item.href) && "is-active",
              ]}
            >
              <Icon size={14} stroke-width={1.75} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <div class="alt-nav-actions">
        <a href={withBase("/contact")} class="alt-nav-cta">
          <Mail size={15} stroke-width={1.75} aria-hidden="true" />
          <span>Contact</span>
        </a>
      </div>
    </div>
  </header>

  <main class="alt-shell">
    <slot />
  </main>
</BaseLayout>

<style is:global>
  body.alt-lab {
    background-image:
      radial-gradient(circle at top, rgba(86, 216, 255, 0.08), transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255, 179, 71, 0.06), transparent 22%),
      linear-gradient(180deg, #05070b 0%, #0a0d14 50%, #05070b 100%);
    color: #d4d4d8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  body.alt-lab::before {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: none;
    opacity: 0.9;
  }

  .alt-shell {
    width: min(1280px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .alt-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(5, 7, 11, 0.76);
    backdrop-filter: blur(16px);
  }

  .alt-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
  }

  .alt-wordmark,
  .alt-nav-link,
  .alt-nav-cta {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-wordmark,
  .alt-nav-link,
  .alt-nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .alt-wordmark {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-links,
  .alt-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.78rem;
  }

  .alt-nav-link {
    color: #c6cad5;
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.42rem 0.2rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-link:hover,
  .alt-nav-link.is-active {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
  }

  .alt-nav-link-cyan {
    color: rgba(134, 227, 255, 0.94);
  }

  .alt-nav-link-emerald {
    color: rgba(110, 236, 188, 0.94);
  }

  .alt-nav-link-amber {
    color: rgba(255, 199, 112, 0.95);
  }

  .alt-nav-link-violet {
    color: rgba(182, 173, 255, 0.95);
  }

  .alt-nav-link-slate {
    color: rgba(208, 214, 228, 0.94);
  }

  .alt-nav-link-cyan:hover,
  .alt-nav-link-cyan.is-active {
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.34),
      0 0 26px rgba(86, 216, 255, 0.18);
  }

  .alt-nav-link-emerald:hover,
  .alt-nav-link-emerald.is-active {
    text-shadow:
      0 0 14px rgba(52, 211, 153, 0.34),
      0 0 26px rgba(52, 211, 153, 0.18);
  }

  .alt-nav-link-amber:hover,
  .alt-nav-link-amber.is-active {
    text-shadow:
      0 0 14px rgba(255, 179, 71, 0.34),
      0 0 26px rgba(255, 179, 71, 0.18);
  }

  .alt-nav-link-violet:hover,
  .alt-nav-link-violet.is-active {
    text-shadow:
      0 0 14px rgba(138, 125, 255, 0.34),
      0 0 26px rgba(138, 125, 255, 0.18);
  }

  .alt-nav-link-slate:hover,
  .alt-nav-link-slate.is-active {
    text-shadow:
      0 0 14px rgba(161, 161, 170, 0.26),
      0 0 26px rgba(161, 161, 170, 0.14);
  }

  .alt-nav-link svg,
  .alt-nav-cta svg,
  .alt-wordmark svg {
    flex: 0 0 auto;
    opacity: 0.78;
  }

  .alt-nav-link:hover svg,
  .alt-nav-link.is-active svg,
  .alt-nav-cta svg,
  .alt-nav-cta:hover svg {
    opacity: 1;
  }

  .alt-wordmark:hover {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.28),
      0 0 24px rgba(86, 216, 255, 0.14);
  }

  .alt-wordmark:hover svg {
    opacity: 1;
  }

  .alt-nav-cta {
    color: rgba(134, 227, 255, 0.94);
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.42rem 0.2rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      color 180ms ease,
      text-shadow 180ms ease,
      opacity 180ms ease;
    opacity: 0.94;
  }

  .alt-nav-cta:hover {
    color: #fff;
    transform: translateY(-1px);
    opacity: 1;
    text-shadow:
      0 0 14px rgba(86, 216, 255, 0.34),
      0 0 26px rgba(86, 216, 255, 0.18);
  }

  @media (max-width: 1080px) {
    .alt-nav-links {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .alt-shell {
      width: min(100% - 1.5rem, 1280px);
    }

    .alt-nav-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .alt-nav-actions {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
