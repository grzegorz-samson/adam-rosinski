---
import BaseLayout from "./BaseLayout.astro";
import { navigation, site } from "../data/site";
import { withBase } from "../utils/withBase";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const { title, description, activePath = "/" } = Astro.props;

function isActive(href: string) {
  return activePath === href;
}
---

<BaseLayout title={title} description={description} bodyClass="alt-lab">
  <header class="alt-nav">
    <div class="alt-shell alt-nav-inner">
      <a href={withBase("/")} class="alt-wordmark">{site.name} / research and sound</a>

      <nav class="alt-nav-links" aria-label="Site navigation">
        {navigation.map((item) => (
          <a href={withBase(item.href)} class:list={["alt-nav-link", isActive(item.href) && "is-active"]}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="alt-nav-actions">
        <a href={withBase("/contact")} class="alt-nav-cta">Contact</a>
      </div>
    </div>
  </header>

  <main class="alt-shell">
    <slot />
  </main>
</BaseLayout>

<style is:global>
  body.alt-lab {
    background-image:
      radial-gradient(circle at top, rgba(86, 216, 255, 0.08), transparent 30%),
      radial-gradient(circle at 80% 20%, rgba(255, 179, 71, 0.06), transparent 22%),
      linear-gradient(180deg, #05070b 0%, #0a0d14 50%, #05070b 100%);
    color: #d4d4d8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  body.alt-lab::before {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: none;
    opacity: 0.9;
  }

  .alt-shell {
    width: min(1280px, calc(100% - 3rem));
    margin: 0 auto;
  }

  .alt-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(5, 7, 11, 0.76);
    backdrop-filter: blur(16px);
  }

  .alt-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
  }

  .alt-wordmark,
  .alt-nav-link {
    font-family: "JetBrains Mono", "Consolas", monospace;
  }

  .alt-wordmark {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .alt-nav-links,
  .alt-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .alt-nav-link {
    color: #a1a1aa;
    font-size: 0.94rem;
    text-decoration: none;
  }

  .alt-nav-link:hover,
  .alt-nav-link.is-active {
    color: #fff;
  }

  .alt-nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.75rem 1rem;
    color: #f4f4f5;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .alt-nav-cta:hover {
    border-color: rgba(86, 216, 255, 0.48);
    color: #56d8ff;
  }

  @media (max-width: 1080px) {
    .alt-nav-links {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .alt-shell {
      width: min(100% - 1.5rem, 1280px);
    }

    .alt-nav-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .alt-nav-actions {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
