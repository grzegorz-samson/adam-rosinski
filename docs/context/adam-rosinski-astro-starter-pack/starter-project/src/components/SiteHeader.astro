---
import { navigation, site } from "../data/site";
---
<header class="sticky top-0 z-50 border-b border-white/8 bg-slate-950/70 backdrop-blur-xl">
  <div class="shell flex items-center justify-between gap-6 py-4">
    <a href="/" class="text-sm font-semibold tracking-[0.18em] text-white uppercase">
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {navigation.map((item) => (
        <a href={item.href} class="text-sm text-zinc-300 transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>

    <a href="#contact" class="button-secondary hidden md:inline-flex">Collaborate</a>
  </div>
</header>
