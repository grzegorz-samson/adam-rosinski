---
interface Props {
  label: string;
  tone?: "cyan" | "amber" | "emerald" | "neutral";
}
const { label, tone = "neutral" } = Astro.props;

const toneClass = {
  cyan: "border-cyan-300/20 bg-cyan-300/10 text-cyan-100",
  amber: "border-amber-300/20 bg-amber-300/10 text-amber-100",
  emerald: "border-emerald-300/20 bg-emerald-300/10 text-emerald-100",
  neutral: "border-white/10 bg-white/[0.05] text-zinc-200",
}[tone];
---
<span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs ${toneClass}`}>
  {label}
</span>
